  <ItemGroup>
    <MauiAsset Include="Resources/Raw/Nested/payload.bin" LogicalName="Shared/Nested/payload.bin" />
    <MauiAsset Include="Resources/Raw/Unicode/café.txt" LogicalName="Shared/Unicode/café.txt" />
    <MauiAsset Include="Resources/Raw/zero.bin" LogicalName="Shared/zero.bin" />
  </ItemGroup>
</Project>
