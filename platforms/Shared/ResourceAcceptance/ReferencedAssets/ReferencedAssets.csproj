    <EnableDefaultMauiResourceItems>false</EnableDefaultMauiResourceItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    __PLATFORM_PROPERTIES__
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="__MAUI_VERSION__" />
    <PackageReference Include="__BACKEND_PACKAGE__" Version="__BACKEND_VERSION__" />
