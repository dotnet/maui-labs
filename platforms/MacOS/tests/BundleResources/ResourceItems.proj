<Project DefaultTargets="_CollectBundleResources">
  <PropertyGroup>
    <TargetPlatformIdentifier Condition="'$(TargetPlatformIdentifier)' == ''">macos</TargetPlatformIdentifier>
    <MacOSResourceTargets Condition="'$(MacOSResourceTargets)' == ''">$(MSBuildThisFileDirectory)..\..\src\MacOS\buildTransitive\Microsoft.Maui.Platforms.MacOS.targets</MacOSResourceTargets>
  </PropertyGroup>
  <Import Project="$(MacOSResourceTargets)" />

  <ItemGroup>
    <MauiImage Include="..\Shared\Images\picture.svg" Link="Resources\Images\picture.svg" />
    <MauiFont Include="..\Shared\Fonts\font.ttf" Link="Resources\Fonts\font.ttf" />
    <MauiAsset Include="..\Shared\Raw\data.txt" LogicalName="Data\nested\renamed.txt" Link="Resources\Raw\data.txt" />
    <MauiAsset Include="..\Shared\Raw\default.txt" />
    <!-- Simulate the Apple SDK's default resource glob, including a differently spelled source path. -->
    <BundleResource Include="$(MSBuildProjectDirectory)\..\Shared\Raw\data.txt" LogicalName="Raw\data.txt" />
    <BundleResource Include="unrelated.txt" LogicalName="unrelated.txt" />
  </ItemGroup>

  <Target Name="_CollectBundleResources">
    <ItemGroup>
      <_Actual Include="@(BundleResource->'%(LogicalName)')" />
    </ItemGroup>
    <Error Condition="'$(TargetPlatformIdentifier)' == 'macos' and '@(_Actual)' != 'unrelated.txt;Images/picture.svg;Fonts/font.ttf;Data/nested/renamed.txt;default.txt'"
           Text="Unexpected macOS bundle resources: @(_Actual)" />
    <Error Condition="'$(TargetPlatformIdentifier)' != 'macos' and '@(_Actual)' != 'Raw\data.txt;unrelated.txt'"
           Text="Non-macOS resources were changed: @(_Actual)" />
    <Message Importance="high" Text="Bundle resource item assertions passed (@(_Actual->Count()) items)." />
  </Target>
</Project>
