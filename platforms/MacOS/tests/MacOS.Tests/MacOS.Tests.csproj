<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Microsoft.Maui.Platforms.MacOS.Tests</RootNamespace>
    <AssemblyName>Microsoft.Maui.Platforms.MacOS.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls">
      <VersionOverride Condition="'$(TargetFramework)' == 'net10.0'">$(MacOSMaui10Version)</VersionOverride>
      <VersionOverride Condition="'$(TargetFramework)' == 'net11.0'">$(MacOSMaui11Version)</VersionOverride>
    </PackageReference>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <!-- Link the production lifecycle code without referencing the AppKit-only assembly.
       These tests use real MAUI windows and handlers and require no native workloads. -->
  <ItemGroup>
    <Compile Include="../../../Shared/Blazor/RootComponentReconciler.cs" Link="Blazor/RootComponentReconciler.cs" />
    <Compile Include="../../../Shared/Blazor/RootComponentReconcilerTests.cs"
             Link="Blazor/RootComponentReconcilerTests.cs" />
    <Compile Include="../../src/MacOS/Platform/ShellTabBarCoordinator.cs"
             Link="Platform/ShellTabBarCoordinator.cs" />
    <Compile Include="../../src/MacOS/Platform/WindowCloseCoordinator.cs"
             Link="Platform/WindowCloseCoordinator.cs" />
    <Compile Include="../../src/MacOS/Platform/EmbeddedFontResourceResolver.cs"
             Link="Platform/EmbeddedFontResourceResolver.cs" />
    <Compile Include="../../src/MacOS.Essentials/MediaCaptureCoordinator.cs"
             Link="Essentials/MediaCaptureCoordinator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/MacOS/buildTransitive/Microsoft.Maui.Platforms.MacOS.props;../../src/MacOS/buildTransitive/Microsoft.Maui.Platforms.MacOS.targets"
          Link="BuildContracts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MacOS.BlazorWebView/buildTransitive/Microsoft.Maui.Platforms.MacOS.BlazorWebView.targets"
          Link="BuildContracts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
