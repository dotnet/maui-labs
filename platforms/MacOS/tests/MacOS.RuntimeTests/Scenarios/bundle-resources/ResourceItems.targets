<Project>
  <Target Name="_PrepareBundleResourceAssertions">
    <PropertyGroup>
      <TargetPlatformIdentifier Condition="'$(ResourceAssertionPlatform)' != ''">$(ResourceAssertionPlatform)</TargetPlatformIdentifier>
      <_ExpectMapping Condition="'$(TargetPlatformIdentifier)' == 'macos' and '$(EnableMacOSMauiResourceMapping)' != 'false'">true</_ExpectMapping>
    </PropertyGroup>
    <ItemGroup>
      <MauiImage Remove="@(MauiImage)" />
      <MauiFont Remove="@(MauiFont)" />
      <MauiAsset Remove="@(MauiAsset)" />
      <BundleResource Remove="@(BundleResource)" />
      <MauiImage Include="..\Fixtures\Images\picture.svg" Link="Resources\Images\picture.svg"
                 Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiFont Include="..\Fixtures\Fonts\font.ttf" Link="Resources\Fonts\font.ttf"
                Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiAsset Include="..\Fixtures\Raw\data.txt" LogicalName="Data\nested\renamed.txt" Link="Resources\Raw\data.txt"
                 Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiAsset Include="..\Fixtures\Raw\default.txt"
                 Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiAsset Include="..\Fixtures\Raw\with spaces.txt" LogicalName="Data with spaces/sample file.txt"
                 Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiProcessedImage Include="obj\processed\picture.png"
                          Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiProcessedFont Include="..\Fixtures\Fonts\font.ttf"
                         Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiProcessedAsset Include="..\Fixtures\Raw\data.txt" Link="Data\nested\renamed.txt"
                          Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiProcessedAsset Include="..\Fixtures\Raw\default.txt" Link="default.txt"
                          Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <MauiProcessedAsset Include="..\Fixtures\Raw\with spaces.txt" Link="Data with spaces/sample file.txt"
                          Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))" />
      <BundleResource Include="$(MSBuildProjectDirectory)\..\Fixtures\Raw\data.txt" LogicalName="Raw/data.txt" />
      <BundleResource Include="unrelated.txt" LogicalName="unrelated.txt" />
    </ItemGroup>
  </Target>

  <Target Name="AssertBundleResourceItems"
          DependsOnTargets="_PrepareBundleResourceAssertions;_MacOSCollectMauiResources;_MacOSCollectProcessedMauiResources">
    <ItemGroup>
      <_ActualResourceNames Include="@(BundleResource->'%(LogicalName)')" />
    </ItemGroup>
    <Error Condition="'$(_ExpectMapping)' == 'true' and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.')) and '@(_ActualResourceNames)' != 'unrelated.txt;Images/picture.png;Fonts/font.ttf;Data/nested/renamed.txt;default.txt;Data with spaces/sample file.txt'"
           Text="Unexpected processed macOS bundle resources: @(_ActualResourceNames)" />
    <Error Condition="'$(_ExpectMapping)' == 'true' and !$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.')) and '@(_ActualResourceNames)' != 'unrelated.txt;Images/picture.svg;Fonts/font.ttf;Data/nested/renamed.txt;default.txt;Data with spaces/sample file.txt'"
           Text="Unexpected macOS bundle resources: @(_ActualResourceNames)" />
    <Error Condition="'$(_ExpectMapping)' != 'true' and '@(_ActualResourceNames)' != 'Raw/data.txt;unrelated.txt'"
           Text="Resource mapping ignored the platform guard or opt-out: @(_ActualResourceNames)" />
    <Message Importance="high" Text="Bundle resource item assertions passed (@(_ActualResourceNames->Count()) items)." />
  </Target>
</Project>
