<Project>
  <PropertyGroup Condition="'$(RuntimeTestScenario)' == 'bundle-resources'">
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>AppKit resource regression</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <MacOSResourceTargets>$(MSBuildThisFileDirectory)..\..\..\..\src\MacOS\buildTransitive\Microsoft.Maui.Platforms.MacOS.targets</MacOSResourceTargets>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeTestScenario)' == 'bundle-resources'">
    <PackageReference Include="Microsoft.Maui.Controls" />
    <MauiImage Include="..\..\samples\MacOS.Sample\Resources\AppIcon\appicon.png" Link="Resources\Images\appicon.png" />
    <MauiFont Include="..\..\samples\MacOS.Sample\Resources\Fonts\OpenSans-Regular.ttf" Link="Resources\Fonts\OpenSans-Regular.ttf" />
    <MauiAsset Include="..\Fixtures\BundleResources\Raw\**\*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" Link="Resources\Raw\%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="..\Fixtures\BundleResources\renamed.txt" LogicalName="Custom\renamed.txt" />
    <MauiAsset Include="..\Fixtures\BundleResources\default.txt" />
    <MauiAsset Include="Resources\Raw\local.txt" LogicalName="Local\local.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeTestScenario)' == 'bundle-resources' and '$(RuntimeTestsUseProjectReferences)' == 'false'">
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" VersionOverride="$(ResourceTestPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" VersionOverride="$(ResourceTestPackageVersion)" />
  </ItemGroup>
</Project>
