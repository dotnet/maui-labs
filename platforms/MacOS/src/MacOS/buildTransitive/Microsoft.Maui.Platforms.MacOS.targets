<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))">
    <ResizetizerPlatformType Condition="'$(ResizetizerPlatformType)' == ''">macos-appkit</ResizetizerPlatformType>
    <MauiActiveBackend Condition="'$(MauiActiveBackend)' == ''">macos</MauiActiveBackend>
    <IncrementalCleanDependsOn>$(IncrementalCleanDependsOn);_MacOSTrackBundleResourceOutputs</IncrementalCleanDependsOn>
  </PropertyGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))">
    <MauiPlatformSpecificFolder Include="Platforms\MacOS\"
                                TargetPlatformIdentifier="macos"
                                BackendIdentity="macos" />
  </ItemGroup>

  <!-- MAUI 10 compatibility path. .NET 11 uses the processed resource contract below. -->
  <Target Name="_MacOSCollectMauiResources"
          BeforeTargets="_CollectBundleResources"
          Condition="'$(TargetPlatformIdentifier)' == 'macos'
                     and !$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))
                     and '$(EnableMacOSMauiResourceMapping)' != 'false'">
    <ItemGroup>
      <_MacOSMauiBundleResource Include="@(MauiImage)">
        <LogicalName>Images/%(Filename)%(Extension)</LogicalName>
      </_MacOSMauiBundleResource>
      <_MacOSMauiBundleResource Include="@(MauiFont)">
        <LogicalName>Fonts/%(Filename)%(Extension)</LogicalName>
      </_MacOSMauiBundleResource>
      <_MacOSMauiBundleResource Include="@(MauiAsset)">
        <LogicalName Condition="'%(MauiAsset.LogicalName)' == ''">%(Filename)%(Extension)</LogicalName>
      </_MacOSMauiBundleResource>
      <_MacOSMauiBundleResource>
        <LogicalName>$([System.String]::Copy('%(_MacOSMauiBundleResource.LogicalName)').Replace('\', '/'))</LogicalName>
      </_MacOSMauiBundleResource>
      <!-- Replace default Resources glob entries for these files: otherwise the
           SDK may keep the default Raw/ path instead of the MauiAsset logical name. -->
      <BundleResource Remove="@(_MacOSMauiBundleResource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <BundleResource Include="@(_MacOSMauiBundleResource)" />
    </ItemGroup>
  </Target>

  <Target Name="_MacOSPrepareMauiImages"
          BeforeTargets="ResizetizeImages"
          DependsOnTargets="ResizetizeCollectItems"
          Condition="'$(TargetPlatformIdentifier)' == 'macos'
                     and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))
                     and '$(EnableMacOSMauiResourceMapping)' != 'false'">
    <ItemGroup>
      <MauiImage Update="@(MauiImage)" Condition="'%(MauiImage.Link)' != ''">
        <Link>$([System.String]::Copy('%(MauiImage.Link)').Replace('\', '/'))</Link>
      </MauiImage>
    </ItemGroup>
  </Target>

  <Target Name="_MacOSPrepareRawMauiAssets"
          BeforeTargets="ProcessMauiAssets"
          DependsOnTargets="ResizetizeCollectItems"
          Condition="'$(TargetPlatformIdentifier)' == 'macos'
                     and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))
                     and '$(EnableMacOSMauiResourceMapping)' != 'false'">
    <ItemGroup>
      <!-- Keep the AppKit raw-asset default when Resizetizer supplies a source-relative Link. -->
      <MauiAsset Update="@(MauiAsset)">
        <LogicalName Condition="'%(MauiAsset.LogicalName)' == ''">%(Filename)%(Extension)</LogicalName>
      </MauiAsset>
    </ItemGroup>
  </Target>

  <Target Name="_MacOSCollectProcessedMauiResources"
          AfterTargets="ResizetizeImages"
          BeforeTargets="_CollectBundleResources"
          DependsOnTargets="ProcessMauiFonts;ProcessMauiAssets;ResizetizeImages"
          Condition="'$(TargetPlatformIdentifier)' == 'macos'
                     and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))
                     and '$(EnableMacOSMauiResourceMapping)' != 'false'">
    <ItemGroup>
      <_MacOSProcessedMauiBundleResource Include="@(MauiProcessedImage)"
                                         Condition="'%(MauiProcessedImage.IsAppIcon)' != 'true'
                                                    and '%(MauiProcessedImage.MSBuildSourceProjectFile)' == ''">
        <LogicalName>Images/%(MauiProcessedImage.Filename)%(MauiProcessedImage.Extension)</LogicalName>
      </_MacOSProcessedMauiBundleResource>
      <_MacOSProcessedMauiBundleResource Include="@(MauiProcessedFont)"
                                         Condition="'%(MauiProcessedFont.MSBuildSourceProjectFile)' == ''">
        <LogicalName>Fonts/%(MauiProcessedFont.Filename)%(MauiProcessedFont.Extension)</LogicalName>
      </_MacOSProcessedMauiBundleResource>
      <_MacOSProcessedMauiBundleResource Include="@(MauiProcessedAsset)"
                                         Condition="'%(MauiProcessedAsset.MSBuildSourceProjectFile)' == ''">
        <LogicalName Condition="'%(MauiProcessedAsset.LogicalName)' != ''">%(MauiProcessedAsset.LogicalName)</LogicalName>
        <LogicalName Condition="'%(MauiProcessedAsset.LogicalName)' == '' and '%(MauiProcessedAsset.Link)' != ''">%(MauiProcessedAsset.Link)</LogicalName>
        <LogicalName Condition="'%(MauiProcessedAsset.LogicalName)' == '' and '%(MauiProcessedAsset.Link)' == '' and '%(MauiProcessedAsset.TargetPath)' != ''">%(MauiProcessedAsset.TargetPath)</LogicalName>
        <LogicalName Condition="'%(MauiProcessedAsset.Link)' == '' and '%(MauiProcessedAsset.TargetPath)' == '' and '%(MauiProcessedAsset.LogicalName)' == ''">%(MauiProcessedAsset.RecursiveDir)%(MauiProcessedAsset.Filename)%(MauiProcessedAsset.Extension)</LogicalName>
      </_MacOSProcessedMauiBundleResource>
      <_MacOSProcessedMauiBundleResource>
        <LogicalName>$([System.String]::Copy('%(_MacOSProcessedMauiBundleResource.LogicalName)').Replace('\', '/'))</LogicalName>
      </_MacOSProcessedMauiBundleResource>

      <BundleResource Remove="@(MauiImage);@(MauiFont);@(MauiAsset)"
                      MatchOnMetadata="FullPath"
                      MatchOnMetadataOptions="PathLike" />
      <BundleResource Remove="@(_MacOSProcessedMauiBundleResource)"
                      MatchOnMetadata="FullPath"
                      MatchOnMetadataOptions="PathLike" />
      <BundleResource Include="@(_MacOSProcessedMauiBundleResource)" />
    </ItemGroup>
  </Target>

  <!-- Apple copies bundle resources after CoreBuild, so register their outputs
       before IncrementalClean compares this build with the previous file list. -->
  <Target Name="_MacOSTrackBundleResourceOutputs"
          DependsOnTargets="_ComputeBundleResourceOutputPaths"
          Condition="'$(TargetPlatformIdentifier)' == 'macos'
                     and $([System.String]::Copy('$(TargetFramework)').StartsWith('net11.'))
                     and '$(_CanOutputAppBundle)' == 'true'
                     and '$(EnableMacOSMauiResourceMapping)' != 'false'">
    <ItemGroup>
      <FileWrites Include="@(_BundleResourceWithOutputPath -> '%(OutputPath)')" />
    </ItemGroup>
  </Target>

  <!--
    macOS AppKit app icon generation from MauiIcon items.
    Processes MauiIcon SVG/PNG sources into a .icns file using sips + iconutil,
    then injects CFBundleIconFile via PartialAppManifest.
  -->

  <Target Name="_MacOSGenerateAppIcon"
          BeforeTargets="_CompileAppManifest"
          Condition="'@(MauiIcon)' != ''"
          Inputs="@(MauiIcon)"
          Outputs="$(IntermediateOutputPath)appicon\AppIcon.icns">

    <PropertyGroup>
      <_MacOSIconSource>%(MauiIcon.FullPath)</_MacOSIconSource>
      <_MacOSIconIntermediatePath>$(IntermediateOutputPath)appicon\</_MacOSIconIntermediatePath>
      <_MacOSIconSetPath>$(_MacOSIconIntermediatePath)AppIcon.iconset</_MacOSIconSetPath>
      <_MacOSIconIcnsPath>$(_MacOSIconIntermediatePath)AppIcon.icns</_MacOSIconIcnsPath>
      <_MacOSIconPlistPath>$(_MacOSIconIntermediatePath)AppIcon.plist</_MacOSIconPlistPath>
    </PropertyGroup>

    <MakeDir Directories="$(_MacOSIconSetPath)" />

    <!-- Generate all required macOS icon sizes from source -->
    <Exec Command="sips -s format png -z 16 16 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_16x16.png&quot;" />
    <Exec Command="sips -s format png -z 32 32 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_16x16@2x.png&quot;" />
    <Exec Command="sips -s format png -z 32 32 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_32x32.png&quot;" />
    <Exec Command="sips -s format png -z 64 64 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_32x32@2x.png&quot;" />
    <Exec Command="sips -s format png -z 128 128 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_128x128.png&quot;" />
    <Exec Command="sips -s format png -z 256 256 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_128x128@2x.png&quot;" />
    <Exec Command="sips -s format png -z 256 256 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_256x256.png&quot;" />
    <Exec Command="sips -s format png -z 512 512 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_256x256@2x.png&quot;" />
    <Exec Command="sips -s format png -z 512 512 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_512x512.png&quot;" />
    <Exec Command="sips -s format png -z 1024 1024 &quot;$(_MacOSIconSource)&quot; --out &quot;$(_MacOSIconSetPath)/icon_512x512@2x.png&quot;" />

    <!-- Create .icns from iconset -->
    <Exec Command="iconutil -c icns &quot;$(_MacOSIconSetPath)&quot; -o &quot;$(_MacOSIconIcnsPath)&quot;" />

    <!-- Generate partial Info.plist for CFBundleIconFile -->
    <WriteLinesToFile
      File="$(_MacOSIconPlistPath)"
      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;;
&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;;
&lt;plist version=&quot;1.0&quot;&gt;;
&lt;dict&gt;;
    &lt;key&gt;CFBundleIconFile&lt;/key&gt;;
    &lt;string&gt;AppIcon&lt;/string&gt;;
&lt;/dict&gt;;
&lt;/plist&gt;"
      Overwrite="true" />

    <!-- Register outputs -->
    <ItemGroup>
      <BundleResource Include="$(_MacOSIconIcnsPath)">
        <LogicalName>AppIcon.icns</LogicalName>
      </BundleResource>
      <PartialAppManifest Include="$(_MacOSIconPlistPath)" />
      <FileWrites Include="$(_MacOSIconIcnsPath);$(_MacOSIconPlistPath)" />
      <FileWrites Include="$(_MacOSIconSetPath)\*" />
    </ItemGroup>

  </Target>

</Project>
