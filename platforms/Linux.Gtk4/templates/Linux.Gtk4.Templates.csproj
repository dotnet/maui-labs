<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Microsoft.Maui.Platforms.Linux.Gtk4.Templates</PackageId>
    <Version>$(PlatformMauiLinuxGtk4Version)</Version>
    <Authors>Microsoft</Authors>
    <Description>Project templates for .NET MAUI apps running on Linux with GTK4.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet-new;templates;maui;linux;gtk;gtk4</PackageTags>
    <PackageProjectUrl>https://github.com/dotnet/maui-labs/tree/main/platforms/Linux.Gtk4</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnet/maui-labs.git</RepositoryUrl>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <Content Include="maui-linux-gtk4-app\**\*" Exclude="maui-linux-gtk4-app\**\bin\**;maui-linux-gtk4-app\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <Target Name="PrepareGtkTemplatePackageVersions" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_GtkTemplateProject>$(IntermediateOutputPath)templates\MauiLinuxApp.csproj</_GtkTemplateProject>
      <!-- Arcade computes PackageVersion independently of PlatformMauiLinuxGtk4Version. -->
      <_GtkTemplateContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/maui-linux-gtk4-app/MauiLinuxApp.csproj').Replace('__GtkPackageVersion__', '$(PackageVersion)'))</_GtkTemplateContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GtkTemplateProject)" Lines="$(_GtkTemplateContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Remove="maui-linux-gtk4-app\MauiLinuxApp.csproj" />
      <Content Include="$(_GtkTemplateProject)" PackagePath="content\maui-linux-gtk4-app\MauiLinuxApp.csproj" />
      <FileWrites Include="$(_GtkTemplateProject)" />
    </ItemGroup>
  </Target>

</Project>
