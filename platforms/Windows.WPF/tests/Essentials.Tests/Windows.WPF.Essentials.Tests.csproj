<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net11.0-windows10.0.17763.0</TargetFrameworks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>$(MicrosoftWindowsSdkNetRefVersion)</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>Microsoft.Maui.Platforms.Windows.WPF.Essentials.Tests</AssemblyName>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <ProjectReference Include="..\..\src\Windows.WPF.Essentials\Windows.WPF.Essentials.csproj" />
    <Compile Include="..\..\..\Shared\Essentials.Tests\StaticFacadeTests.cs" Link="StaticFacadeTests.cs" />
    <Compile Include="..\..\..\Shared\Essentials.Tests\FileSystemDirectoryTests.cs" Link="FileSystemDirectoryTests.cs" />
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
