<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net11.0-windows10.0.17763.0</TargetFrameworks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>$(MicrosoftWindowsSdkNetRefVersion)</WindowsSdkPackageVersion>
    <MauiVersion Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0-'))">$(Maui10Version)</MauiVersion>
    <MauiVersion Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0-'))">$(Maui11Version)</MauiVersion>
    <UseWPF>true</UseWPF>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <RootNamespace>Microsoft.Maui.Platforms.Windows.WPF.Essentials</RootNamespace>
    <AssemblyName>Microsoft.Maui.Platforms.Windows.WPF.Essentials</AssemblyName>
    <PackageId>Microsoft.Maui.Platforms.Windows.WPF.Essentials</PackageId>
    <Version>$(PlatformMauiWindowsWpfEssentialsVersion)</Version>
    <Description>MAUI Essentials implementations for the WPF backend — clipboard, preferences, device info, connectivity, and more using WPF and Windows APIs.</Description>
    <PackageTags>maui;windows;wpf;essentials;desktop;clipboard;preferences</PackageTags>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Windows.WPF\Windows.WPF.csproj" />
    <InternalsVisibleTo Include="Microsoft.Maui.Platforms.Windows.WPF.Essentials.Tests" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0-'))">
    <Compile Include="..\..\..\Shared\Essentials\EssentialsInitializer.cs" Link="Hosting\EssentialsInitializer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
