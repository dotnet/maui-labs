<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <MauiVersion Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0-'))">$(Maui10Version)</MauiVersion>
    <MauiVersion Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0-'))">$(Maui11Version)</MauiVersion>
    <UseWPF>true</UseWPF>
    <!-- The backend uses the WPF SDK; MAUI app tooling belongs in consumers. -->
    <UseMaui>false</UseMaui>
    <RootNamespace>Microsoft.Maui.Platforms.Windows.WPF</RootNamespace>
    <AssemblyName>Microsoft.Maui.Platforms.Windows.WPF</AssemblyName>
    <PackageId>Microsoft.Maui.Platforms.Windows.WPF</PackageId>
    <Version>$(PlatformMauiWindowsWpfVersion)</Version>
    <Description>A .NET MAUI backend for Windows using WPF. Run your MAUI apps on Windows desktops with native WPF controls.</Description>
    <PackageTags>maui;windows;wpf;desktop;dotnet;cross-platform</PackageTags>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <!-- Suppress obsolete warnings: this backend implements handlers for deprecated MAUI types (ListView, TableView, Frame, NamedSize) -->
    <NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- Include MSBuild targets for MAUI asset processing -->
  <ItemGroup>
    <Compile Include="../../../Shared/Blazor/RootComponentReconciler.cs" Link="Blazor/RootComponentReconciler.cs" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="build\Microsoft.Maui.Platforms.Windows.WPF.targets" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\Microsoft.Maui.Platforms.Windows.WPF.props" Pack="true" PackagePath="buildTransitive\net11.0-windows7.0\" />
    <None Include="buildTransitive\Microsoft.Maui.Platforms.Windows.WPF.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Fonts\Microsoft.Maui.Platforms.Windows.WPF.Fonts.targets" Pack="true" PackagePath="build\Fonts\" />
  </ItemGroup>

</Project>
