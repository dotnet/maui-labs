<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_MicrosoftMauiPlatformsWindowsWPFFontsTargetsImported>true</_MicrosoftMauiPlatformsWindowsWPFFontsTargetsImported>
  </PropertyGroup>

  <Target Name="_WpfProcessMauiFont" BeforeTargets="AssignTargetPaths" Condition="@(MauiFont) != ''">
    <ItemGroup>
      <ContentWithTargetPath Include="@(MauiFont)">
        <TargetPath>Resources\Fonts\%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
