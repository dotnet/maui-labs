<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(_MicrosoftMauiPlatformsWindowsWPFBuildPropsImported)' != 'true'">
    <_MicrosoftMauiPlatformsWindowsWPFBuildPropsImported>true</_MicrosoftMauiPlatformsWindowsWPFBuildPropsImported>
    <WPFProjectFolder Condition="'$(WPFProjectFolder)' == ''">$(PlatformsProjectFolder)WPF\</WPFProjectFolder>
    <WPFProjectFolder>$([MSBuild]::EnsureTrailingSlash('$(WPFProjectFolder)'))</WPFProjectFolder>
  </PropertyGroup>
</Project>
