<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Microsoft.Maui.Platforms.Windows.WPF.Templates</PackageId>
    <Version>$(PlatformMauiWindowsWpfVersion)</Version>
    <Authors>Microsoft</Authors>
    <Description>Project templates for .NET MAUI apps running on Windows with WPF.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet-new;templates;maui;windows;wpf</PackageTags>
    <PackageProjectUrl>https://github.com/dotnet/maui-labs/tree/main/platforms/Windows.WPF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnet/maui-labs.git</RepositoryUrl>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <Content Include="maui-wpf-app\**\*" Exclude="maui-wpf-app\**\bin\**;maui-wpf-app\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <Target Name="PrepareWpfTemplate" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(PackageVersion)' == '' or '$(MauiVersion)' == ''"
           Text="WPF template packaging requires PackageVersion and MauiVersion." />
    <PropertyGroup>
      <_WpfTemplateProject>$(IntermediateOutputPath)templates\maui-wpf-app\MauiWpfApp.csproj</_WpfTemplateProject>
      <_WpfTemplateContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\maui-wpf-app\MauiWpfApp.csproj'))</_WpfTemplateContent>
      <_WpfTemplateContent>$(_WpfTemplateContent.Replace('__WPF_VERSION__', '$(PackageVersion)').Replace('__MAUI_VERSION__', '$(MauiVersion)'))</_WpfTemplateContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WpfTemplateProject)" Lines="$(_WpfTemplateContent)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Remove="maui-wpf-app\MauiWpfApp.csproj" />
      <Content Include="$(_WpfTemplateProject)" PackagePath="content\maui-wpf-app\MauiWpfApp.csproj" />
    </ItemGroup>
  </Target>

</Project>
