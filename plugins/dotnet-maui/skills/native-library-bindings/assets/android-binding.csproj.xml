<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Contoso.NativeSdk.Android</PackageId>
    <Description>.NET bindings for Contoso Native SDK on Android.</Description>
    <PackageTags>maui;android;binding;native;artifact=com.contoso:sdk:1.2.3</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <TransformFile Include="Transforms/Metadata.xml" />
  </ItemGroup>

  <!-- Preferred for Maven-hosted artifacts on .NET 9+. -->
  <ItemGroup>
    <AndroidMavenLibrary Include="com.contoso:sdk" Version="1.2.3" Repository="Central" />
    <AndroidMavenLibrary Include="com.contoso:runtime" Version="1.2.3" Bind="false" />
  </ItemGroup>

  <!-- Use local AndroidLibrary when Maven is unavailable. -->
  <ItemGroup>
    <AndroidLibrary Include="libs/contoso-sdk-1.2.3.aar"
                    Manifest="libs/contoso-sdk-1.2.3.pom"
                    JavaArtifact="com.contoso:sdk"
                    JavaVersion="1.2.3" />
  </ItemGroup>

  <!-- Use AndroidIgnoredJavaDependency only for compile-time-only artifacts. -->
  <ItemGroup>
    <AndroidIgnoredJavaDependency Include="com.google.errorprone:error_prone_annotations:2.15.0" />
  </ItemGroup>
</Project>
