<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GenerativeUI.Sample.Garden.Server.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- This test boots the server in-process via WebApplicationFactory, so it must run against the
         same Microsoft.OpenApi 2.0.0 the server (and ASP.NET's OpenAPI stack) target — not the
         repo-pinned 3.5.0 that transitive pinning would otherwise impose. See the server csproj. -->
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sample\GenerativeUI.Sample.Garden.Server\GenerativeUI.Sample.Garden.Server.csproj" />
  </ItemGroup>

</Project>
