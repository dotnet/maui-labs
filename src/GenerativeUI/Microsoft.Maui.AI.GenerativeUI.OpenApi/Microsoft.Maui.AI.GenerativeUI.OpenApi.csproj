<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.AI.GenerativeUI.OpenApi</RootNamespace>
    <PackageId>Microsoft.Maui.AI.GenerativeUI.OpenApi</PackageId>
    <Description>OpenAPI processing for Generative UI: fetches, reduces, and generically invokes a REST API described by an OpenAPI document, so an AI agent can discover and call any such API without compile-time knowledge of its models or routes.</Description>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <PackageTags>$(PackageTags) ai openapi rest generative-ui</PackageTags>
    <PackRepoRootReadme>false</PackRepoRootReadme>
  </PropertyGroup>

  <ItemGroup>
    <!-- Target Microsoft.OpenApi 2.0.0 - the version .NET 10's Microsoft.AspNetCore.OpenApi ships -
         so this library is conflict-free for net10 apps that also use ASP.NET's OpenAPI stack.
         Overrides the repo's 3.5.0 central pin (which DevFlow uses). -->
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime attributes ([ExportAIFunction]) for the AI-facing tools. -->
    <ProjectReference Include="..\..\AIExtensions\Microsoft.Maui.AI.Attributes\Microsoft.Maui.AI.Attributes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
