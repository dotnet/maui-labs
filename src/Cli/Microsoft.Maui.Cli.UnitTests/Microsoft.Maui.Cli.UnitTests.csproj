<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1307;CA1310;xUnit2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="Spectre.Console.Testing" />
    <!-- Independent PNG decoder for compatibility tests, not part of the shipped tool graph. -->
    <PackageReference Include="SkiaSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.Cli\Microsoft.Maui.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ProfileTestProcess.cs" />
    <None Include="ProfileTestProcess.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
