<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-target net9.0 and net11.0 so `dotnet tool install` works on both
         SDKs. dotnet picks the highest compatible TFM at install time. -->
    <TargetFrameworks>net9.0;net11.0</TargetFrameworks>
    <!-- A NativeAOT RID package must contain only the AOT build: with a net9.0 build beside it, `dotnet tool install`
         prefers the TFM-specific net9.0 assets over the TFM-agnostic AOT ones, and users would get no NativeAOT. -->
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">net11.0</TargetFrameworks>
    <!-- Preserve the .NET 9 tool asset by allowing the compatible package graph selected below,
         rather than promoting transitive dependencies to the repository-wide .NET 11 versions. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <RootNamespace>Microsoft.Maui.Cli</RootNamespace>
    <AssemblyName>maui</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>maui</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <!-- NativeAOT requires a RID, so enable it for packaging rather than ordinary builds. The empty-TFM case is the
         cross-targeting outer pack: it must see PublishAot so the SDK does not try to build every RID there. -->
    <PublishAot Condition="'$(_IsPacking)' == 'true' and ('$(TargetFramework)' == 'net11.0' or '$(TargetFramework)' == '')">true</PublishAot>
    <PublishTrimmed Condition="'$(_IsPacking)' == 'true' and '$(TargetFramework)' == 'net11.0'">true</PublishTrimmed>
    <!-- Packing the pointer package (no RuntimeIdentifier) also builds the host's RID package, so restore must cover it. -->
    <RuntimeIdentifiers Condition="'$(_IsPacking)' == 'true' and '$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifiers>
    <SelfContained Condition="'$(TargetFramework)' == 'net11.0' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</SelfContained>
    <!-- Go.Server is consumed in-process even though its project also emits a standalone executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PackageId>Microsoft.Maui.Cli</PackageId>
    <Description>CLI for .NET MAUI development environment setup and device management</Description>
    <PackageTags>maui;dotnet;cli;android;apple;devflow;diagnostics;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackRepoRootReadme>false</PackRepoRootReadme>
    <IsPackable Condition="'$(SkipMauiCliPack)' != 'true'">true</IsPackable>
    <IsPackable Condition="'$(SkipMauiCliPack)' == 'true'">false</IsPackable>
    <IsShipping>true</IsShipping>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1572;CS1573</NoWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- SDK 11's optimized AOT publish skips copying the XML documentation
         that this tool includes in its publish output. Keep the full build path. -->
    <UseOptimizedPublish Condition="'$(PublishAot)' == 'true'">false</UseOptimizedPublish>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <!-- Let the latest packaged tool TFM run on newer major runtimes. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="$(MicrosoftExtensionsCompatibilityVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" VersionOverride="$(MicrosoftExtensionsCompatibilityVersion)" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Websocket.Client" />
    <PackageReference Include="Xamarin.Android.Tools.AndroidSdk" />
    <PackageReference Include="Xamarin.Apple.Tools.MaciOS" />
    <!-- XenoAtom.Terminal.UI requires .NET 10 or later (uses C# 14 extension members).
         On net9.0 we fall back to JSON output for the network monitor. -->
    <PackageReference Include="XenoAtom.Terminal.UI" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <!-- Exclude sources that depend on XenoAtom.Terminal.UI on older targets. -->
    <Compile Remove="DevFlow\NetworkMonitorTui.cs" />
  </ItemGroup>

  <!-- Exclude native debug symbols from the tool package to reduce size.
       PackTool globs everything from PublishDir — delete PDBs from there before the glob runs.
       Only runs during 'dotnet pack', not standalone 'dotnet publish'. -->
  <Target Name="RemoveNativeRuntimePdbsBeforeToolPack"
          BeforeTargets="PackTool"
          DependsOnTargets="Publish"
          Condition="'$(PackAsTool)' == 'true' and '$(IsPackable)' != 'false'">
    <ItemGroup>
      <_PdbsToRemove Include="$(PublishDir)runtimes/**/*.pdb" />
      <_NativeDebugSymbolsToRemove Include="$(PublishDir)**/*.dSYM/**" />
    </ItemGroup>
    <Delete Files="@(_PdbsToRemove)" />
    <Delete Files="@(_NativeDebugSymbolsToRemove)" />
  </Target>

  <!-- NativeAOT cannot run Go's Roslyn compilation in-process. Keep its managed server
       untrimmed in a subdirectory so the native CLI can launch it through the installed SDK. -->
  <Target Name="PublishManagedGoServer"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <!-- InvariantGlobalization is reset so an outer -p: override does not leak into the server's runtimeconfig. -->
    <MSBuild Projects="..\..\Go\Server\Microsoft.Maui.Go.Server.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net11.0;RuntimeIdentifier=;SelfContained=false;PublishAot=false;PublishTrimmed=false;InvariantGlobalization=false;RollForward=Major;PublishDir=$(PublishDir)go-server/" />
  </Target>

  <!-- NativeAOT links ProfilingHelper into the executable, so its managed assembly is no longer
       in the publish output. `maui profile` injects that assembly into the app being profiled
       (see ProfileCommandBuildInjectionResolver), so ship the untrimmed copy under Build/. -->
  <Target Name="PublishManagedProfilingHelper"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ProfilingHelperAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Maui.ProfilingHelper'" />
    </ItemGroup>
    <Error Condition="'@(_ProfilingHelperAssembly)' == ''" Text="Microsoft.Maui.ProfilingHelper.dll was not found among the resolved references; it must ship beside the NativeAOT CLI." />
    <Copy SourceFiles="@(_ProfilingHelperAssembly)" DestinationFolder="$(PublishDir)Build/" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.ProfilingHelper\Microsoft.Maui.ProfilingHelper.csproj" />
    <ProjectReference Include="..\..\DevFlow\Microsoft.Maui.DevFlow.Driver\Microsoft.Maui.DevFlow.Driver.csproj" />
    <ProjectReference Include="..\..\Go\Server\Microsoft.Maui.Go.Server.csproj" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Maui.Cli.UnitTests" />
    <InternalsVisibleTo Include="Microsoft.Maui.DevFlow.Tests" />
    <InternalsVisibleTo Include="Microsoft.Maui.DevFlow.Agent.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Build\MauiProfilingHelper.AutoInitialize.cs" />
    <Content Include="Build\MauiProfilingHelperInjection.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Build\MauiProfilingHelper.AutoInitialize.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-onboard\**\*" LogicalName="devflow.skills/maui-devflow-onboard/%(RecursiveDir)%(Filename)%(Extension)">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-debug\**\*" LogicalName="devflow.skills/maui-devflow-debug/%(RecursiveDir)%(Filename)%(Extension)">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-session-review\**\*" LogicalName="devflow.skills/maui-devflow-session-review/%(RecursiveDir)%(Filename)%(Extension)">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateDevFlowSkillResources" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-onboard\SKILL.md')" Text="Bundled DevFlow skill 'maui-devflow-onboard' was not found." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-debug\SKILL.md')" Text="Bundled DevFlow skill 'maui-devflow-debug' was not found." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\plugins\dotnet-maui-tooling\skills\maui-devflow-session-review\SKILL.md')" Text="Bundled DevFlow skill 'maui-devflow-session-review' was not found." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="DevFlow\Inspector\Web\**\*" LogicalName="Microsoft.Maui.Cli.DevFlow.Inspector.Web.%(Filename)%(Extension)">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
