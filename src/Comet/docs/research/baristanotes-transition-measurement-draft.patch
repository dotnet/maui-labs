@@ -0,0 +1,95 @@
+using Android.Runtime;
+using AndroidX.Compose.UI.Graphics.Drawscope;
+using AndroidX.Compose.UI.Layout;
+using Kotlin.Jvm.Functions;
+
+namespace AndroidX.Compose;
+
+public static class DrawAcknowledgment
+{
+    public static Modifier AfterContent(
+        this Modifier modifier, DrawAcknowledgmentState state, Func<bool> enabled, Action<bool> acknowledge)
+    {
+        ArgumentNullException.ThrowIfNull(state);
+        ArgumentNullException.ThrowIfNull(enabled);
+        ArgumentNullException.ThrowIfNull(acknowledge);
+        var position = state.Position;
+        var draw = new DrawContentCallback(position, enabled, acknowledge);
+        return modifier
+            .Append(handle => ComposeBridges.ObserveDrawPosition(handle, position))
+            .Append(handle => ComposeBridges.ObserveDrawContent(handle, draw));
+    }
+}
+
+public sealed class DrawAcknowledgmentState
+{
+    internal DrawPositionCallback Position { get; } = new();
+}
+
+// These peers must exist in every JNI generation pass, not only Debug.
+[Register("net/compose/DrawPositionCallback")]
+internal sealed class DrawPositionCallback : Java.Lang.Object, IFunction1
+{
+    internal ILayoutCoordinates? Coordinates { get; private set; }
+
+    public Java.Lang.Object Invoke(Java.Lang.Object? value)
+    {
+        Coordinates = value?.JavaCast<ILayoutCoordinates>()
+            ?? throw new InvalidOperationException("Compose did not supply layout coordinates.");
+        return Kotlin.Unit.Instance!;
+    }
+}
+
+[Register("net/compose/DrawContentCallback")]
+internal sealed class DrawContentCallback(DrawPositionCallback position, Func<bool> enabled, Action<bool> acknowledge)
+    : Java.Lang.Object, IFunction1
+{
+    public Java.Lang.Object Invoke(Java.Lang.Object? value)
+    {
+        var scope = value?.JavaCast<IContentDrawScope>()
+            ?? throw new InvalidOperationException("Compose did not supply its content draw scope.");
+        scope.DrawContent();
+        if (!enabled())
+            return Kotlin.Unit.Instance!;
+        var coordinates = position.Coordinates;
+        acknowledge(coordinates is { IsAttached: true } &&
+            ComposeBridges.DrawContentFullyVisible(coordinates) == 1);
+        return Kotlin.Unit.Instance!;
+    }
+}
+
+internal static partial class ComposeBridges
+{
+    [ComposeBridge(Class = "androidx/compose/ui/layout/OnGloballyPositionedModifierKt",
+        JvmName = "onGloballyPositioned",
+        Signature = "(Landroidx/compose/ui/Modifier;Lkotlin/jvm/functions/Function1;)Landroidx/compose/ui/Modifier;")]
+    internal static partial IntPtr ObserveDrawPosition(IntPtr modifier, IFunction1 callback);
+
+    [ComposeBridge(Class = "androidx/compose/ui/draw/DrawModifierKt", JvmName = "drawWithContent",
+        Signature = "(Landroidx/compose/ui/Modifier;Lkotlin/jvm/functions/Function1;)Landroidx/compose/ui/Modifier;")]
+    internal static partial IntPtr ObserveDrawContent(IntPtr modifier, IFunction1 callback);
+
+    static IntPtr _drawGeometryClass;
+    static IntPtr _drawGeometryMethod;
+
+    // ComposeBridgeGenerator emits object returns only. This helper returns a JVM int.
+    internal static unsafe int DrawContentFullyVisible(ILayoutCoordinates coordinates)
+    {
+        if (_drawGeometryMethod == IntPtr.Zero)
+        {
+            _drawGeometryClass = JNIEnv.FindClass("net/compose/DrawGeometry");
+            _drawGeometryMethod = JNIEnv.GetStaticMethodID(_drawGeometryClass, "fullyVisible",
+                "(Landroidx/compose/ui/layout/LayoutCoordinates;)I");
+        }
+        try
+        {
+            JValue* arguments = stackalloc JValue[1];
+            arguments[0] = new JValue(((Java.Lang.Object)coordinates).Handle);
+            return JNIEnv.CallStaticIntMethod(_drawGeometryClass, _drawGeometryMethod, arguments);
+        }
+        finally
+        {
+            GC.KeepAlive(coordinates);
+        }
+    }
+}
