+#if ANDROID && BARISTA_MEASUREMENT
+using System;
+using System.Runtime.CompilerServices;
+using AndroidX.Compose;
+
+namespace Comet.Platform.Compose;
+
+public sealed record ComposeDrawnContent(string AutomationId, string? Text, bool FullyVisible);
+
+public static class ComposeDrawObservation
+{
+    sealed record Observation(Func<bool> Enabled, Action<ComposeDrawnContent> Acknowledge);
+    static readonly ConditionalWeakTable<View, Observation> Observations = new();
+
+    public static void Observe(View declaration, Func<bool> enabled, Action<ComposeDrawnContent> acknowledge)
+    {
+        ArgumentNullException.ThrowIfNull(declaration);
+        ArgumentNullException.ThrowIfNull(acknowledge);
+        ArgumentNullException.ThrowIfNull(enabled);
+        Observations.Add(declaration, new(enabled, acknowledge));
+    }
+
+    internal static Modifier? Capture(
+        Modifier? modifier, View? declaration, string automationId, string? text, bool visible,
+        ref DrawAcknowledgmentState? position)
+    {
+        if (declaration is null || !Observations.TryGetValue(declaration, out var observation))
+            return modifier;
+        // Capture the declaration and native text in composition, not in the later draw callback.
+        position ??= new();
+        return (modifier ?? Modifier.Companion).AfterContent(position, observation.Enabled, fullyVisible =>
+            observation.Acknowledge(new(automationId, text, visible && fullyVisible)));
+    }
+}
+#endif
