+using Android.App;
+using Android.Content;
+using Android.Runtime;
+#if BARISTA_MEASUREMENT
+using System;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Barista.Measurement;
+using Barista.Measurement.AndroidSupport;
+using CometBaristaNotes.Comparison;
+#endif
+
+namespace CometComposeProbe.BaristaNotes.Comparison;
+
+[Register("com/comet/baristacomparison/MeasurementControlReceiver")]
+#if BARISTA_MEASUREMENT
+[BroadcastReceiver(Name = "com.comet.baristacomparison.MeasurementControlReceiver",
+    Enabled = true, Exported = true, Permission = "android.permission.DUMP")]
+#endif
+public sealed class MeasurementControlReceiver : BroadcastReceiver
+{
+    public override void OnReceive(Context? context, Intent? intent)
+    {
+#if BARISTA_MEASUREMENT
+        try
+        {
+            if (context is null || intent is null)
+                throw new InvalidDataException("Measurement control requires a context and intent.");
+            var measurement = BaristaMeasurement.Current ??
+                throw new InvalidOperationException("There is no opted-in measurement owner.");
+            if (measurement.IsArmed && intent.Action != "com.comet.baristacomparison.MEASURE_CANCEL")
+                throw new InvalidOperationException("Control processing is outside measured intervals only.");
+            string response;
+            switch (intent.Action)
+            {
+                case "com.comet.baristacomparison.MEASURE_ARM":
+                    var request = JsonSerializer.Deserialize(
+                        intent.GetStringExtra("request") ?? throw new InvalidDataException("request is required."),
+                        MeasurementControlJson.Default.MeasurementArm) ??
+                        throw new InvalidDataException("request is null.");
+                    response = JsonSerializer.Serialize(measurement.Arm(request),
+                        MeasurementControlJson.Default.MeasurementStatus);
+                    break;
+                case "com.comet.baristacomparison.MEASURE_STATUS":
+                    response = JsonSerializer.Serialize(measurement.Status(),
+                        MeasurementControlJson.Default.MeasurementStatus);
+                    break;
+                case "com.comet.baristacomparison.MEASURE_CANCEL":
+                    measurement.Cancel();
+                    response = JsonSerializer.Serialize(measurement.Status(),
+                        MeasurementControlJson.Default.MeasurementStatus);
+                    break;
+                case "com.comet.baristacomparison.MEASURE_EXPORT":
+                    response = measurement.SaveExport(context);
+                    break;
+                case "com.comet.baristacomparison.MEASURE_READ_EXPORT":
+                    var selection = BaristaFixtureHost.MeasurementMetadata?.Selection ??
+                        throw new InvalidOperationException("The selected run namespace is missing.");
+                    var chunk = CometFixtureExports.Read(BaristaFixtureHost.AppData(context), selection,
+                        intent.GetStringExtra("token") ?? throw new InvalidDataException("token is required."),
+                        intent.GetIntExtra("offset", -1), intent.GetIntExtra("length", -1));
+                    response = JsonSerializer.Serialize(chunk, CometFixtureStatusJson.Default.CometFixtureChunk);
+                    break;
+                default:
+                    throw new InvalidDataException("Unknown measurement action. Ready/qualify controls do not exist.");
+            }
+            SetResult(Result.Ok, response, null);
+        }
+        catch (Exception error) when (error is InvalidOperationException or InvalidDataException or IOException or JsonException or FormatException)
+        {
+            Android.Util.Log.Error("BaristaMeasurement", error.ToString());
+            SetResult(Result.Canceled, "Rejected: " + error.Message, null);
+        }
+#else
+        SetResult(Result.Canceled, "Measurement controls are not enabled.", null);
+#endif
+    }
+}
+
+#if BARISTA_MEASUREMENT
+internal sealed record MeasurementTrialToken(long Sequence, string Token);
+internal sealed record MeasurementControlExport(
+    int SchemaVersion, MeasurementEnvelope[] Measurements, MeasurementTrialToken[] TrialTokens,
+    FrameObserverRejection[] Rejections, MeasurementAdapterError[] AdapterErrors, string SystemTtfd);
+
+[JsonSourceGenerationOptions(
+    PropertyNamingPolicy = JsonKnownNamingPolicy.CamelCase,
+    UseStringEnumConverter = true,
+    GenerationMode = JsonSourceGenerationMode.Metadata,
+    UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow,
+    DefaultIgnoreCondition = JsonIgnoreCondition.Never)]
+[JsonSerializable(typeof(MeasurementArm))]
+[JsonSerializable(typeof(MeasurementStatus))]
+[JsonSerializable(typeof(MeasurementControlExport))]
+internal partial class MeasurementControlJson : JsonSerializerContext;
+#endif
