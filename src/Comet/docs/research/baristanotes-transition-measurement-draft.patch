index 00000000..5b36b1b5
--- /dev/null
+++ b/src/Comet/sample/CometComposeProbe/MainActivity.Measurement.cs
@@ -0,0 +1,49 @@
+#if BARISTA_MEASUREMENT
+using System;
+using CometComposeProbe.BaristaNotes.Comparison;
+
+namespace CometComposeProbe;
+
+public partial class MainActivity
+{
+    BaristaMeasurement? _measurement;
+    string? _measurementSetupError;
+
+    public override bool DispatchTouchEvent(Android.Views.MotionEvent? e)
+    {
+        if (_measurement?.IsArmed == true &&
+            e?.ActionMasked is Android.Views.MotionEventActions.Down or Android.Views.MotionEventActions.Move)
