+#if BARISTA_MEASUREMENT
+using System;
+using System.Linq;
+using Comet;
+using Comet.Platform.Compose;
+using Microsoft.Maui;
+using Barista.Measurement;
+using CometComposeProbe.BaristaNotes.Comparison;
+
+namespace CometSamples.BaristaNotes.Comparison;
+
+internal sealed record ComparisonContent(
+    Guid Page, string Scene, ContentRevision Revision, bool Ready, string? Error,
+    int Total, int[] RowIds, long DataCompletedAtNs);
+
+internal sealed class ComparisonPage(string scene)
+{
+    readonly Guid _page = Guid.NewGuid();
+    long _load;
+    long _content;
+    bool _ready;
+    string? _error;
+    int _total;
+    int[] _rows = Array.Empty<int>();
+    long _completedAt;
+
+    internal ComparisonContent Current { get; private set; } =
+        new(Guid.Empty, scene, new(1, 1), false, null, 0, Array.Empty<int>(), 0);
+
+    internal long BeginLoad()
+    {
+        ++_load;
+        _ready = false;
+        _error = null;
+        Publish();
+        return _load;
+    }
+
+    internal void Complete(long load, string? error, int total = 0, int[]? rows = null)
+    {
+        if (load != _load)
+            return;
+        _error = error;
+        _ready = error is null;
+        _total = total;
+        _rows = rows ?? Array.Empty<int>();
+        _completedAt = Android.OS.SystemClock.ElapsedRealtimeNanos();
+        Publish();
+    }
+
+    internal ComparisonContent Compose()
+    {
+        Publish();
+        return Current;
+    }
+
+    void Publish()
+    {
+        Current = new(_page, scene, new(Math.Max(1, _load), ++_content),
+            _ready, _error, _total, _rows, _completedAt);
+        BaristaMeasurement.Current?.ContentChanged(Current);
+    }
+
+    internal static T Observe<T>(T declaration, ComparisonContent snapshot) where T : View
+    {
+        // Do not materialize components or enumerate app data to instrument a frame.
+        if (!string.IsNullOrEmpty(declaration.AutomationId))
+            ComposeDrawObservation.Observe(declaration,
+                () => BaristaMeasurement.Current?.IsArmed == true,
+                drawn => BaristaMeasurement.Current?.ContentDrawn(snapshot, drawn));
+        if (declaration is IContainerView container)
+            foreach (var child in container.GetChildren())
+                if (child is not null)
+                    Observe(child, snapshot);
+        return declaration;
+    }
+}
+#endif
