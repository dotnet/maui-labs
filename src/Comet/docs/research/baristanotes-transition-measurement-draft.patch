@@ -0,0 +1,388 @@
+#if BARISTA_MEASUREMENT
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.IO;
+using System.Text.Json;
+using Android.App;
+using Android.OS;
+using Barista.Measurement;
+using Barista.Measurement.AndroidSupport;
+using Comet.Platform.Compose;
+using CometSamples.BaristaNotes;
+using CometSamples.BaristaNotes.Comparison;
+
+namespace CometComposeProbe.BaristaNotes.Comparison;
+
+internal sealed record MeasurementArm(
+    int Pid, long Activity, long Root, long Sequence,
+    string Trial, string Journey, string Hop, string Token);
+
+internal sealed record MeasurementAdapterError(string Stage, string Code, string Detail);
+
+internal sealed record MeasurementStatus(
+    int Pid, long Activity, long Root, string ProcessInstance, bool Armed,
+    MeasurementArm? Pending, MeasurementAdapterError[] Errors, string SystemTtfd,
+    long? DataCompletedAtNs, bool? CachedAtDispatch);
+
+internal sealed class BaristaMeasurement : IDisposable
+{
+    static readonly string ProcessInstance = Guid.NewGuid().ToString("N");
+    static long _generation;
+    static readonly string[] EditorRoles =
+    {
+        "shot_tile_method", "shot_tile_bag", "shot_tile_drink_type", "shot_tile_rating",
+        "shot_tile_dose", "shot_tile_yield", "shot_tile_time", "shot_tile_grind",
+        "shot_tile_temperature", "shot_tile_people", "shot_tile_machine", "shot_tile_grinder", "shot_save",
+    };
+
+    readonly AndroidFrameObserver _observer;
+    readonly SessionIdentity _session;
+    readonly OwnerIdentity _owner;
+    readonly Activity _activity;
+    readonly Android.Views.View _nativeRoot;
+    readonly BaristaNotesApp _app;
+    readonly FixtureIdentity _fixture;
+    readonly int _expectedCount;
+    readonly Dictionary<int, string> _fixtureIds = new();
+    readonly List<MeasurementAdapterError> _errors = new();
+    readonly HashSet<string> _drawn = new();
+    readonly List<MeasurementTrialToken> _trialTokens = new();
+    MeasurementControlExport? _pendingExport;
+    MeasurementArm? _pending;
+    OperationToken? _operation;
+    ComparisonContent? _content;
+    FrameTicket? _candidate;
+    bool _readyObserved;
+    long _lastSequence;
+    bool _disposed;
+    bool? _cachedAtDispatch;
+    long? _dataCompletedAt;
+
+    internal static BaristaMeasurement? Current { get; private set; }
+    internal bool IsArmed => _observer.IsArmed;
+
+    internal BaristaMeasurement(
+        Activity activity, Android.Views.View nativeRoot, BaristaNotesApp app,
+        string runId)
+    {
+        CheckThread();
+        if (Current is not null)
+            throw new InvalidOperationException("The previous measurement owner must be disposed first.");
+        var metadata = BaristaFixtureHost.MeasurementMetadata ??
+            throw new InvalidOperationException("Measurement requires an existing completed run namespace.");
+        _fixture = new(metadata.Receipt.FixtureName, metadata.Selection.Namespace);
+        _expectedCount = metadata.Selection.DrinkCount;
+        foreach (var pair in metadata.Receipt.Ids.Drinks)
+            if (!_fixtureIds.TryAdd(int.Parse(pair.Value, CultureInfo.InvariantCulture), pair.Key))
+                throw new InvalidOperationException("The completed receipt contains duplicate native drink IDs.");
+        if (_fixtureIds.Count != _expectedCount)
+            throw new InvalidOperationException("The completed receipt does not contain the expected drink ID map.");
+        _activity = activity;
+        _nativeRoot = nativeRoot;
+        _app = app;
+        var generation = ++_generation;
+        _owner = new(ProcessInstance, Android.OS.Process.MyPid(), generation, generation);
+        _session = new(runId, ProcessInstance, _owner.ProcessId,
+            new(ClockKind.AndroidElapsedRealtimeNanos, "android-elapsed-realtime"),
+            EvidenceKind.AndroidAdapterObservation);
+        _observer = new(nativeRoot, _session, _owner);
+        Current = this;
+    }
+
+    internal void Startup(string trial, string hop, string token, long entryNs, string? setupError)
+    {
+        if (!Guid.TryParseExact(token, "N", out _))
+            throw new InvalidOperationException("A startup token must be a GUID in N format.");
+        _trialTokens.Add(new(1, token));
+        var identity = new OperationIdentity(1, trial, "startup-newdrink", hop, _fixture,
+            "Activity.OnCreate", "ProcessStart", "NewDrink", null);
+        Start(identity, _app.ComparisonNewDrink, entryNs);
+        _lastSequence = 1;
+        if (setupError is not null && _observer.IsArmed && _operation is { } operation)
+            Protocol("startup-setup", () => _observer.Fail(operation, setupError));
+    }
+
+    internal MeasurementStatus Arm(MeasurementArm request)
+    {
+        CheckLive();
+        if (_observer.IsArmed || _pending is not null)
+            throw new InvalidOperationException("A measurement is already armed.");
+        if (_errors.Count != 0 || _pendingExport is not null || _trialTokens.Count >= 64)
+            throw new InvalidOperationException("Export retained errors before arming another measurement.");
+        if (request.Pid != _owner.ProcessId || request.Activity != _owner.ActivityGeneration ||
+            request.Root != _owner.RootGeneration)
+            throw new InvalidOperationException("The arm request does not match the current native owner.");
+        if (request.Sequence <= _lastSequence || request.Journey != "newdrink-activity" ||
+            request.Hop != "footer-activity" || !Guid.TryParseExact(request.Token, "N", out _) ||
+            !ValidText(request.Trial))
+            throw new InvalidOperationException("Invalid or reused measurement identity.");
+        if (!_app.ComparisonActive("NewDrink") || !_activity.HasWindowFocus ||
+            !BaristaFixtureHost.WaitForIdleAsync().IsCompletedSuccessfully)
+            throw new InvalidOperationException("The NewDrink root is not available for the real footer action.");
+        _lastSequence = request.Sequence;
+        _trialTokens.Add(new(request.Sequence, request.Token));
+        _pending = request;
+        return Status();
+    }
+
+    internal void ActionEntered(BaristaNavigationCoordinator navigation, BaristaSection target, long entryNs)
+    {
+        if (_disposed || _pending is not { } request ||
+            !ReferenceEquals(navigation, _app.ComparisonNavigation))
+            return;
+        _pending = null;
+        if (target != BaristaSection.Activity || !_app.ComparisonActive("NewDrink"))
+        {
+            Record("action", RejectionCode.ContentMismatch, "The real action does not match the armed journey.");
+            return;
+        }
+        var operation = new OperationIdentity(request.Sequence, request.Trial, request.Journey,
+            request.Hop, _fixture, "RequestSectionSwitch(Activity)", "NewDrink", "Activity", null);
+        Protocol("dispatch", () => Start(operation, _app.ComparisonActivity, entryNs));
+    }
+
+    internal void SectionChanging(BaristaNavigationCoordinator navigation, BaristaSection target)
+    {
+        if (!_disposed && _observer.IsArmed && ReferenceEquals(navigation, _app.ComparisonNavigation) &&
+            _content is { } content && target.ToString() != content.Scene)
+            Cancel("The normal action selected another root.");
+    }
+
+    internal void ValidateActiveRoot(BaristaNotesApp app)
+    {
+        if (!_disposed && _observer.IsArmed && ReferenceEquals(app, _app) &&
+            _content is { } content && !_app.ComparisonActive(content.Scene))
+            Cancel("The active root or an app overlay changed.");
+    }
+
+    void Start(OperationIdentity identity, ComparisonContent content, long entryNs)
+    {
+        _operation = _observer.Dispatch(identity, content.Revision,
+            new(_session.Clock, entryNs));
+        _content = content;
+        _readyObserved = false;
+        _candidate = null;
+        _drawn.Clear();
+        _cachedAtDispatch = content.Ready;
+        _dataCompletedAt = content.Ready ? content.DataCompletedAtNs : null;
+        UpdateReadiness(content);
+    }
+
+    internal void ContentChanged(ComparisonContent content)
+    {
+        if (_disposed || !_observer.IsArmed || _content?.Page != content.Page ||
+            _content.Scene != content.Scene || _operation is not { } operation)
+            return;
+        Protocol("content-revision", () =>
+        {
+            if (content.Revision != _content.Revision)
+            {
+                _observer.AdvanceRevision(operation, content.Revision);
+                _candidate = null;
+                _drawn.Clear();
+                _readyObserved = false;
+            }
+            _content = content;
+            UpdateReadiness(content);
+        });
+    }
+
+    void UpdateReadiness(ComparisonContent content)
+    {
+        if (!_observer.IsArmed || _operation is not { } operation)
+            return;
+        if (content.Error is { } error)
+        {
+            _observer.ObserveDataFailure(operation, content.Revision, Limit(error));
+            return;
+        }
+        if (_readyObserved || !content.Ready)
+            return;
+        if (content.Scene == "Activity" &&
+            (_app.HasActiveActivityFilters || content.Total != _expectedCount ||
+             content.RowIds.Length != Math.Min(50, _expectedCount) ||
+             content.RowIds.Distinct().Count() != content.RowIds.Length ||
+             content.RowIds.Any(id => !_fixtureIds.ContainsKey(id))))
+        {
+            _observer.ObserveDataFailure(operation, content.Revision,
+                "Activity rows/count do not match the selected completed fixture metadata.");
+            return;
+        }
+        _observer.ObserveSuccessfulDataReadiness(operation, content.Revision);
+        _readyObserved = true;
+        _dataCompletedAt = content.DataCompletedAtNs;
+    }
+
+    internal void ContentDrawn(ComparisonContent composed, ComposeDrawnContent drawn)
+    {
+        if (_disposed || !_observer.IsArmed || _content is null ||
+            composed.Page != _content.Page || composed.Revision != _content.Revision ||
+            !_app.ComparisonActive(composed.Scene) || !_nativeRoot.IsShown ||
+            !_activity.HasWindowFocus || _observer.DrawingCandidate is not { } ticket)
+            return;
+        Protocol("native-draw", () =>
+        {
+            if (_candidate != ticket)
+            {
+                _candidate = ticket;
+                _drawn.Clear();
+            }
+            if (drawn.FullyVisible && ValidRole(composed, drawn))
+                _drawn.Add(drawn.AutomationId);
+            var rootId = composed.Scene == "NewDrink" ? "new_drink_page" : "activity_page";
+            if (drawn.AutomationId != rootId)
+                return;
+            if (!_readyObserved || !drawn.FullyVisible || !RequiredRoles(composed).All(_drawn.Contains))
+            {
+                _observer.ObserveIncompleteDraw(ticket,
+                    "The active root has not drawn every required visible field for this revision.");
+                return;
+            }
+            var entity = composed.Scene == "Activity"
+                ? $"{_fixtureIds[composed.RowIds[0]]}:{composed.RowIds[0]}"
+                : "editor";
+            _observer.QualifyDraw(ticket, new(composed.Scene, null, composed.Revision,
+                ticket.Sequence, $"compose:{composed.Page:N}:{entity}:{ticket.Operation.Sequence}:{ticket.Sequence}"));
+        });
+    }
+
+    bool ValidRole(ComparisonContent content, ComposeDrawnContent drawn)
+    {
+        if (content.Scene == "NewDrink")
+            return EditorRoles.Contains(drawn.AutomationId);
+        if (drawn.AutomationId == "activity_count")
+            return drawn.Text == _expectedCount.ToString(CultureInfo.InvariantCulture) + " shots";
+        return content.RowIds.Length != 0 &&
+            (drawn.AutomationId == $"activity_shot_{content.RowIds[0]}_edit" ||
+             (RequiredRoles(content).Contains(drawn.AutomationId) && !string.IsNullOrWhiteSpace(drawn.Text)));
+    }
+
+    static IEnumerable<string> RequiredRoles(ComparisonContent content)
+    {
+        if (content.Scene == "NewDrink")
+            return EditorRoles;
+        if (content.RowIds.Length == 0)
+            return new[] { "unavailable-activity-row" };
+        var prefix = $"activity_shot_{content.RowIds[0]}";
+        return new[] { "activity_count", prefix + "_edit", prefix + "_method",
+            prefix + "_ratio", prefix + "_details", prefix + "_result" };
+    }
+
+    internal MeasurementStatus Status()
+    {
+        CheckLive();
+        return new(_owner.ProcessId, _owner.ActivityGeneration, _owner.RootGeneration,
+            ProcessInstance, _observer.IsArmed, _pending, _errors.ToArray(),
+            "NotReported: observer01 completion API pending review", _dataCompletedAt, _cachedAtDispatch);
+    }
+
+    internal (MeasurementResult[] Results, FrameObserverRejection[] Rejections,
+        MeasurementAdapterError[] Errors) Drain()
+    {
+        CheckLive();
+        if (_observer.IsArmed || _pending is not null)
+            throw new InvalidOperationException("Result export is outside the measured interval only.");
+        var results = _observer.DrainResults();
+        var rejections = _observer.DrainRejections();
+        var errors = _errors.ToArray();
+        _errors.Clear();
+        return (results, rejections, errors);
+    }
+
+    internal string SaveExport(Android.Content.Context context)
+    {
+        CheckThread();
+        if (_pendingExport is null)
+        {
+            var batch = Drain();
+            _pendingExport = new(1,
+                batch.Results.Select(result => new MeasurementEnvelope(
+                    MeasurementExport.SchemaVersion, MeasurementExport.Definition, result)).ToArray(),
+                _trialTokens.ToArray(), batch.Rejections, batch.Errors,
+                "NotReported: observer01 completion API pending review");
+        }
+        var directory = Path.Combine(BaristaFixtureHost.ControlDirectory(context), "exports");
+        Directory.CreateDirectory(directory);
+        var token = Guid.NewGuid().ToString("N");
+        var path = Path.Combine(directory, _fixture.NamespaceId + "-" + token + ".json");
+        var bytes = JsonSerializer.SerializeToUtf8Bytes(_pendingExport,
+            MeasurementControlJson.Default.MeasurementControlExport);
+        using (var output = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read))
+        {
+            output.Write(bytes);
+            output.Flush(true);
+        }
+        _pendingExport = null;
+        _trialTokens.Clear();
+        if (_disposed && ReferenceEquals(Current, this))
+            Current = null;
+        return token;
+    }
+
+    internal void Cancel(string detail = "Explicit native-control cancellation.")
+    {
+        CheckLive();
+        _pending = null;
+        if (_observer.IsArmed && _operation is { } operation)
+            Protocol("cancel", () => _observer.Cancel(operation, detail));
+    }
+
+    void Protocol(string stage, Action action)
+    {
+        try { action(); }
+        catch (MeasurementProtocolException error) { Record(stage, error.Code, error.Message); }
+    }
+
+    void Record(string stage, RejectionCode code, string detail)
+    {
+        if (_errors.Count < 32)
+            _errors.Add(new(stage, code.ToString(), Limit(detail)));
+        if (_errors.Count == 32 && _observer.IsArmed && _operation is { } operation)
+            _observer.Fail(operation, "Adapter rejection capacity reached; drain errors before reuse.");
+    }
+
+    public void Dispose()
+    {
+        if (_disposed)
+            return;
+        CheckThread();
+        _pending = null;
+        _observer.Dispose();
+        try
+        {
+            var token = SaveExport(_activity);
+            Android.Util.Log.Info("BaristaMeasurement", "Lifecycle result export: " + token);
+        }
+        catch (IOException error)
+        {
+            // Keep Current and the drained batch until explicit export succeeds.
+            Android.Util.Log.Error("BaristaMeasurement", "Lifecycle result export failed: " + error);
+        }
+        finally
+        {
+            _disposed = true;
+            if (_pendingExport is null && ReferenceEquals(Current, this))
+                Current = null;
+        }
+    }
+
+    void CheckLive()
+    {
+        CheckThread();
+        if (_disposed)
+            throw new ObjectDisposedException(nameof(BaristaMeasurement));
+    }
+
+    static void CheckThread()
+    {
+        if (Looper.MyLooper() != Looper.MainLooper)
+            throw new MeasurementProtocolException(RejectionCode.WrongThread, "Measurement requires the main thread.");
+    }
+
+    static bool ValidText(string? text) =>
+        !string.IsNullOrWhiteSpace(text) && text.Length <= 128 && !text.Any(char.IsControl);
+    static string Limit(string detail) => detail.Length <= 512 ? detail : detail[..512];
+}
+#endif
