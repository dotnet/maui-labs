<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 1 gate: a PURE Android app (no MAUI, no UseMaui) that renders a Comet
    view tree as a full Jetpack Compose composition via Comet's ICometBackendNode
    backend. Proves the end-to-end retained↔composition bridge on-device.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CometComposeProbe</RootNamespace>
    <ApplicationId>com.comet.composeprobe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Comet\Comet.csproj" />
    <!-- ComponentActivity host for ComposeView. -->
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0" />
    <!-- Google's Material 3 dynamic-color algorithm (HCT -> tonal palettes -> roles), in C#,
         so the SAME M3 scheme is generated from a seed on both platforms (Apache-2.0). -->
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" />
    <!-- Shared faithful Jetchat sample (identical tree on both backends). -->
    <Compile Include="..\Shared\Jetchat\*.cs" Link="Shared\Jetchat\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- DevFlow agent for maui devflow screenshot/tap/list — Debug only.
       Agent.Core is pure .NET (no UseMaui required): broker registration + HTTP server.
       ComposeProbeAgentService subclass provides Android PixelCopy screenshot. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\..\DevFlow\Microsoft.Maui.DevFlow.Agent.Core\Microsoft.Maui.DevFlow.Agent.Core.csproj" />
  </ItemGroup>

</Project>
