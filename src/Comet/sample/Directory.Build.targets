<Project>
	<!-- Force-bump SupportedOSPlatformVersion for all Comet samples. The current
	     iOS/MacCatalyst SDK requires >= 17.0; current Android (.NET 11 preview 7)
	     requires minSdk >= 24. Override in Directory.Build.targets (after the csproj
	     evaluates) so all samples pick this up without per-project edits. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Scoped to UseMaui projects only: pure node-backend probes (CometComposeProbe,
	     CometSwiftUIProbe) don't set UseMaui and already have their own in-app
	     Comet/DevFlow agent path, so they must not pick up these legacy MAUI deps. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(UseMaui)' == 'true'">
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Use the repo-local DevFlow agent instead of the legacy NuGet package. -->
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\..\DevFlow\Microsoft.Maui.DevFlow.Agent\Microsoft.Maui.DevFlow.Agent.csproj" />
		<!-- The RuntimeDebug host went with the legacy MAUI render path (Phase 5);
		     node-backend apps use the in-app Comet/DevFlow agents instead. -->
	</ItemGroup>

	<!-- ProjectReference does not import the agent's build targets. Import them
	     explicitly so the broker receives the project, TFM, port, and session ID. -->
	<Import Project="$(MSBuildThisFileDirectory)..\..\DevFlow\Microsoft.Maui.DevFlow.Agent\build\Microsoft.Maui.DevFlow.Agent.targets"
	        Condition="'$(Configuration)' == 'Debug' and '$(UseMaui)' == 'true' and Exists('$(MSBuildThisFileDirectory)..\..\DevFlow\Microsoft.Maui.DevFlow.Agent\build\Microsoft.Maui.DevFlow.Agent.targets')" />

	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<CodesignEntitlements>$(MSBuildThisFileDirectory)Shared/RuntimeDebug/Entitlements.Debug.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- Fast-dev APK staleness fix ("no Java peer type found" after library rebuilds).
	     This file SHADOWS src/Comet/Directory.Build.targets for projects under sample/,
	     so the fix must be imported here explicitly — see the file for the analysis. -->
	<Import Project="..\eng\FastDevApkFix.targets" />
</Project>
