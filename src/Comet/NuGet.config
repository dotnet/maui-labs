<?xml version="1.0" encoding="utf-8"?>
<!--
  Comet-scoped NuGet config.

  Comet "builds independently within maui-labs" (see Directory.Build.props):
  its own global.json pins a .NET 11 preview SDK; the sample apps depend on
  Redth.MauiDevFlow.Agent (per .squad/decisions.md), which is not mirrored
  on the dnceng public feeds the repo-root NuGet.config restricts itself to.

  Adding nuget.org HERE (and only here) lets Debug builds of Comet samples
  restore Redth.MauiDevFlow.Agent without bending the repo-wide "dnceng-only"
  policy in the root NuGet.config. The dnceng feeds defined at the repo root
  continue to apply via NuGet config inheritance.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
