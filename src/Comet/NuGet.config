<?xml version="1.0" encoding="utf-8"?>
<!--
  Comet builds independently within maui-labs using the .NET 11 preview SDK
  pinned by its local global.json. Its dependencies are public packages, so
  keep this configuration usable by contributors without Azure Artifacts
  credentials. The official release pipeline does not build or publish Comet.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
