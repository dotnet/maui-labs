<?xml version="1.0" encoding="utf-8"?>
<!--
  Comet-scoped NuGet config.

  Comet "builds independently within maui-labs" (see Directory.Build.props):
  its own global.json pins a .NET 11 preview SDK. The repo-root NuGet.config
  restricts restore to the six dnceng public feeds (dotnet-public, dotnet-tools,
  dotnet-eng, dotnet10, dotnet11, dotnet11-transport), which mirror the .NET
  product graph but do NOT mirror every public package Comet depends on:

    - The .NET 11 Preview 7 workload-set metadata used by ci-comet.yml is not
      mirrored by the dnceng feeds.
    - The vendored Xamarin.AndroidX Compose bridge (src/vendor/VENDORED.md)
      pulls a small binding graph that is not fully mirrored by the dnceng
      feeds.
    - MaterialColorUtilities 0.3.0 (Google's M3 dynamic-color algorithm,
      ported to C#) is also nuget.org-only.

  Redth.MauiDevFlow.Agent no longer needs an exception here: the sample DevFlow
  agent dependency was migrated to a repo-local ProjectReference (see
  sample/Directory.Build.targets), so it must NOT be mapped to nuget.org below.

  Package source mapping is REQUIRED (not optional) once nuget.org is added:
  without it, an unqualified nuget.org source could resolve ANY package ID,
  including internal/unpublished ones that happen to only exist in the dnceng
  feeds by design. The dnceng `*` mappings below preserve the repo-root
  restore behavior for every other package; the nuget.org mappings are
  intentionally narrow (exact/prefix patterns, not `*`) and are MORE SPECIFIC
  than `*`, so NuGet's longest-prefix-match rule considers nuget.org only for
  the package IDs listed during source lookup. Everything else is eligible
  only from dnceng.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Inherited dnceng feeds (repo-root NuGet.config): keep catch-all behavior. -->
    <packageSource key="dotnet-public">
      <!-- These packages match the Compose prefix below, but dotnet-public
           already carries the MAUI-aligned builds. Exact patterns win. -->
      <package pattern="Xamarin.AndroidX.Compose.Runtime.Annotation" />
      <package pattern="Xamarin.AndroidX.Compose.Runtime.Annotation.Android" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet10">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11-transport">
      <package pattern="*" />
    </packageSource>
    <!-- Narrow, Comet-only exceptions. More-specific patterns win over the
         dnceng `*` mappings above, so only these package IDs/prefixes are
         eligible for nuget.org during source lookup. -->
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NET.Workloads.11.0.100-preview.7" />
      <package pattern="Xamarin.AndroidX.Activity.Compose*" />
      <package pattern="Xamarin.AndroidX.Compose.*" />
      <package pattern="Xamarin.AndroidX.Graphics.Path" />
      <package pattern="Xamarin.AndroidX.Lifecycle.Common.Java8" />
      <package pattern="Xamarin.AndroidX.Lifecycle.Runtime.Compose*" />
      <package pattern="Xamarin.AndroidX.Lifecycle.ViewModel.Compose*" />
      <package pattern="Xamarin.AndroidX.Navigation.Compose*" />
      <package pattern="Xamarin.AndroidX.NavigationEvent.Compose*" />
      <package pattern="Xamarin.AndroidX.SavedState.SavedState.Compose*" />
      <package pattern="MaterialColorUtilities" />
    </packageSource>
  </packageSourceMapping>
</configuration>
