<?xml version="1.0" encoding="utf-8"?>
<!--
  Comet-scoped NuGet config.

  Comet "builds independently within maui-labs" (see Directory.Build.props):
  its own global.json pins a .NET 11 preview SDK.   The repo-root NuGet.config uses multiple product feeds. Comet instead restores
  through the approved CFS NuGet proxy, which provides a single Azure Artifacts
  source with nuget.org upstreams. This keeps restore policy-compliant while
  including public packages that are not mirrored by every dnceng product feed:

    - The .NET 11 Preview 7 workload-set metadata used by ci-comet.yml is not
      mirrored by the dnceng feeds.
    - The vendored Xamarin.AndroidX Compose bridge (src/vendor/VENDORED.md)
      pulls a small binding graph that is not fully mirrored by the dnceng
      feeds.
    - MaterialColorUtilities 0.3.0 (Google's M3 dynamic-color algorithm,
      ported to C#) is also nuget.org-only.

  Redth.MauiDevFlow.Agent no longer needs a package source exception: the sample
  dependency uses a repo-local ProjectReference (see sample/Directory.Build.targets).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget-public" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
