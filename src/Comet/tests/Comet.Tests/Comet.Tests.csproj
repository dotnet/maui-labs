<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Suppress platform compatibility warnings: tests reference maccatalyst DLL from net11.0 -->
    <NoWarn>CA1416;CS0219</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Comet.SourceGenerator\Comet.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Comet.Layout.Yoga\Comet.Layout.Yoga.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Comet">
      <HintPath>..\..\src\Comet\bin\$(Configuration)\net11.0-maccatalyst\Comet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- BaristaNotes shared domain files (compiled into test project for domain testing) -->
  <ItemGroup>
    <Compile Include="..\..\sample\Shared\BaristaNotes\Models\**\*.cs" LinkBase="BaristaNotes\Models" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Data\**\*.cs" LinkBase="BaristaNotes\Data" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Services\**\*.cs" LinkBase="BaristaNotes\Services" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Components\SourceComponents.cs" LinkBase="BaristaNotes\Components" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Styles\**\*.cs" LinkBase="BaristaNotes\Styles" />
    <!-- These two files depend on BaristaNavigationCoordinator, BaristaServices (BaristaNotesApp.cs),
         and ShotLoggingPage (Pages/) — all of which require the Comet framework (NavigationView,
         Signal<T>), and Pages that are not compiled into the test project. Including
         BaristaNotesApp.cs would transitively pull the entire UI layer into the test assembly.
         Their callback interfaces (IBaristaVoiceCallbacks, IBaristaPhotoWorkflowCallbacks) are
         thoroughly tested via test doubles in BaristaNotesVoiceDefectTests, BaristaNotesVoiceTests,
         BaristaNotesIntegrationTests, and BaristaNotesPhotoWorkflowTests. -->
    <Compile Remove="..\..\sample\Shared\BaristaNotes\Services\Voice\AppVoiceCallbacks.cs" />
    <Compile Remove="..\..\sample\Shared\BaristaNotes\Services\AppPhotoWorkflowCallbacks.cs" />
  </ItemGroup>

</Project>
