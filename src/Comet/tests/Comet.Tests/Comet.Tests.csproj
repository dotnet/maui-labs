<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Suppress platform compatibility warnings: tests reference maccatalyst DLL from net11.0 -->
    <NoWarn>CA1416;CS0219</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BaristaLifecycleTests)' == 'true' Or '$(BaristaInsetTests)' == 'true'">
    <DefineConstants>$(DefineConstants);BARISTA_LIFECYCLE_TESTS</DefineConstants>
    <!-- Match the app's non-friend assembly boundary for protected control overrides. -->
    <AssemblyName>Comet.BaristaLifecycle.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\sample\Shared\SampleScreenResolver.cs" LinkBase="Samples" />
    <Compile Include="..\..\sample\CometComposeProbe\BaristaNotes\Comparison\BaristaLifecycleControl.cs" LinkBase="BaristaNotes\Comparison" />
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\perf\baristanotes\Comet\Contract\BaristaComparison.Contract.csproj" />
    <Compile Include="..\..\tools\perf\baristanotes\Comet\*.cs" LinkBase="BaristaNotes\Comparison" />
    <ProjectReference Include="..\..\src\Comet.SourceGenerator\Comet.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Comet.Layout.Yoga\Comet.Layout.Yoga.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Comet">
      <HintPath>..\..\src\Comet\bin\$(Configuration)\net11.0-maccatalyst\Comet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- BaristaNotes shared domain files (compiled into test project for domain testing) -->
  <ItemGroup>
    <Compile Include="..\..\sample\Shared\BaristaNotes\Models\**\*.cs" LinkBase="BaristaNotes\Models" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Data\**\*.cs" LinkBase="BaristaNotes\Data" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Services\**\*.cs" LinkBase="BaristaNotes\Services" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Components\SourceComponents.cs" LinkBase="BaristaNotes\Components" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Styles\**\*.cs" LinkBase="BaristaNotes\Styles" />
    <!-- These two files depend on BaristaNavigationCoordinator, BaristaServices (BaristaNotesApp.cs),
         and ShotLoggingPage (Pages/) — all of which require the Comet framework (NavigationView,
         Signal<T>), and Pages that are not compiled into the test project. Including
         BaristaNotesApp.cs would transitively pull the entire UI layer into the test assembly.
         Their callback interfaces (IBaristaVoiceCallbacks, IBaristaPhotoWorkflowCallbacks) are
         thoroughly tested via test doubles in BaristaNotesVoiceDefectTests, BaristaNotesVoiceTests,
         BaristaNotesIntegrationTests, and BaristaNotesPhotoWorkflowTests. -->
    <Compile Remove="..\..\sample\Shared\BaristaNotes\Services\Voice\AppVoiceCallbacks.cs" Condition="'$(BaristaLifecycleTests)' != 'true' And '$(BaristaInsetTests)' != 'true'" />
    <Compile Remove="..\..\sample\Shared\BaristaNotes\Services\AppPhotoWorkflowCallbacks.cs" Condition="'$(BaristaLifecycleTests)' != 'true' And '$(BaristaInsetTests)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(BaristaLifecycleTests)' == 'true' Or '$(BaristaInsetTests)' == 'true'">
    <Compile Include="BaristaNotes\BaristaHostLifecycleTests.cs" Condition="'$(BaristaLifecycleTests)' == 'true'" />
    <Compile Include="BaristaNotes\BaristaEditorInsetDependencyTests.cs" Condition="'$(BaristaInsetTests)' == 'true'" />
    <Compile Include="Backend\FakeBackendNode.cs" Condition="'$(BaristaInsetTests)' == 'true'" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\BaristaNotesApp.cs" LinkBase="BaristaNotes" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Pages\**\*.cs" LinkBase="BaristaNotes\Pages" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Diagnostics\**\*.cs" LinkBase="BaristaNotes\Diagnostics" />
    <Compile Include="..\..\sample\Shared\BaristaNotes\Components\**\*.cs"
             Exclude="..\..\sample\Shared\BaristaNotes\Components\SourceComponents.cs"
             LinkBase="BaristaNotes\Components" />
  </ItemGroup>

  <Target Name="ValidateBaristaHostTestMode" BeforeTargets="CoreCompile"
          Condition="'$(BaristaLifecycleTests)' == 'true' And '$(BaristaInsetTests)' == 'true'">
    <Error Text="Run BaristaLifecycleTests and BaristaInsetTests in separate processes: comparison storage can only be selected once per process." />
  </Target>

</Project>
