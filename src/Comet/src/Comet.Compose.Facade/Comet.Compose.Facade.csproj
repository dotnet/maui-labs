<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Comet's own C# facade over the Xamarin.AndroidX.Compose.* JNI bindings.
    Phase 1 use: prove C# can host a Jetpack Compose tree and drive it from
    managed code (risk #1). We build our own facade rather than depend on
    jonathanpeppers/Microsoft.AndroidX.Compose (reference only).
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compose runtime + state -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime" Version="1.11.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Saveable" Version="1.11.2" />
    <!-- UI core: composition, modifiers, graphics, text, units -->
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="1.11.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Graphics" Version="1.11.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Text" Version="1.11.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Unit" Version="1.11.2" />
    <!-- Foundation: layout, lazy lists, gestures -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation" Version="1.11.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation.Layout" Version="1.11.2" />
    <!-- Material 3 -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3" Version="1.4.0.2" />
    <!-- Activity host for ComposeView / setContent. Pinned to align the transitive
         Xamarin.AndroidX.Activity graph pulled by Compose.UI 1.11.2. -->
    <PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.13.0" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0" />
  </ItemGroup>

</Project>
