<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<!-- Windows/macOS heads are parked with the legacy render path (Phase 5); the
	     maccatalyst head stays for the host test suite. -->
	<TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
	<UseMaui>true</UseMaui>
	<Nullable>disable</Nullable>
	<!-- CS0649: unassigned fields, CS0618: obsolete APIs, CS0108: hides inherited member -->
	<NoWarn>CS0649;CS0618;CS0108;CA1416</NoWarn>
	<!-- net11.0-macos does not use UseMaui; define MauiVersion explicitly so PackageReference resolves -->
	<!-- <MauiVersion Condition="$(TargetFramework.Contains('-macos')) AND '$(MauiVersion)' == ''">11.0.0-preview.2.26152.10</MauiVersion> -->
	<SingleProject>true</SingleProject>
	<ImplicitUsings>disable</ImplicitUsings>

	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">14.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!--
    Phase 5 (2026-07-01): the legacy MAUI ViewHandler render path — per-control
    ViewHandlers, the CometViewHandler host, UseCometHandlers/UseCometApp, and the
    native CUI*/Comet* platform views — is DELETED. The Compose/SwiftUI node
    backend is the only render path; Windows and the AppKit macOS head (which
    rendered through it) are parked with it. The last commit with the legacy path
    is tagged `comet-pre-phase5-delete`.
  -->

  <ItemGroup>
	<ProjectReference Include="..\Comet.SourceGenerator\Comet.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
	  <ReferenceSourceTarget>
	  </ReferenceSourceTarget>
	</ProjectReference>
	<ProjectReference Include="..\Comet.Layout.Yoga\Comet.Layout.Yoga.csproj" />
  </ItemGroup>

  <!-- Jetpack Compose backend (Android only) renders through the vendored
       Microsoft.AndroidX.Compose bridge layer. See src/vendor/VENDORED.md. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
	<ProjectReference Include="..\vendor\Microsoft.AndroidX.Compose\Microsoft.AndroidX.Compose.csproj" />
  </ItemGroup>

  <!-- SwiftUI backend (iOS only) renders through the CometSwiftUIShim @objc binding. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
	<ProjectReference Include="..\Comet.SwiftUI.Binding\Comet.SwiftUI.Binding.csproj" />
  </ItemGroup>

  <!-- Packaging: ship the SwiftUI shim xcframework + a build/net11.0-ios/Comet.targets so a
       package-referencing iOS app gets the SmartLink=False NativeReference the static
       registrar needs (see PackAssets/Comet.targets). Pack-only; harmless at build time. -->
  <ItemGroup>
	<None Include="..\Comet.SwiftUI.Shim\CometSwiftUIShim.xcframework\**"
	      Pack="true" PackagePath="build\CometSwiftUIShim.xcframework" />
	<None Include="PackAssets\Comet.targets"
	      Pack="true" PackagePath="build\Comet.targets" />
  </ItemGroup>

</Project>
