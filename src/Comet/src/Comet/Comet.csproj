<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
	<!-- net11.0-macos workload not yet available in .NET 11 preview; re-enable when shipped -->
	<!-- <TargetFrameworks>$(TargetFrameworks);net11.0-macos</TargetFrameworks> -->
	<UseMaui>true</UseMaui>
	<Nullable>disable</Nullable>
	<!-- CS0649: unassigned fields, CS0618: obsolete APIs, CS0108: hides inherited member -->
	<NoWarn>CS0649;CS0618;CS0108;CA1416</NoWarn>
	<!-- net11.0-macos does not use UseMaui; define MauiVersion explicitly so PackageReference resolves -->
	<!-- <MauiVersion Condition="$(TargetFramework.Contains('-macos')) AND '$(MauiVersion)' == ''">11.0.0-preview.2.26152.10</MauiVersion> -->
	<SingleProject>true</SingleProject>
	<ImplicitUsings>disable</ImplicitUsings>

	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">14.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!--
    Phase 5 decoupling: the legacy MAUI ViewHandler render path (per-control
    ViewHandlers + the CometViewHandler host + UseCometHandlers + the native CUI*/
    Comet* platform views) is compiled only when CometLegacyRenderPath=true
    (default). With the new Compose/SwiftUI node backend it is dead code, and on
    iOS its NSObject-derived handlers/views are force-rooted by the static
    registrar (so they can't trim) — building with -p:CometLegacyRenderPath=false
    excludes the cluster so it trims away. Windows/MacCatalyst still need it.
  -->
  <PropertyGroup>
	<CometLegacyRenderPath Condition="'$(CometLegacyRenderPath)' == ''">true</CometLegacyRenderPath>
	<DefineConstants Condition="'$(CometLegacyRenderPath)' == 'true'">$(DefineConstants);COMET_LEGACY_RENDER_PATH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CometLegacyRenderPath)' != 'true'">
	<Compile Remove="Handlers\**\*.cs" />
	<Compile Remove="Maui\**\*.cs" />
	<Compile Remove="AppHostBuilderExtensions.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CometLegacyRenderPath)' != 'true' AND $(TargetFramework.Contains('-ios'))">
	<Compile Remove="Platform\iOS\CometView.cs" />
	<Compile Remove="Platform\iOS\CometViewController.cs" />
	<Compile Remove="Platform\iOS\CUIContainerView.cs" />
	<Compile Remove="Platform\iOS\CUINavigationController.cs" />
	<Compile Remove="Platform\iOS\CUIScrollView.cs" />
	<Compile Remove="Platform\iOS\CUIShapeView.cs" />
	<Compile Remove="Platform\iOS\CUITableView.cs" />
	<Compile Remove="Platform\iOS\CUITableViewCell.cs" />
	<Compile Remove="Platform\iOS\CUITableViewSource.cs" />
	<Compile Remove="Platform\iOS\CUITabView.cs" />
	<Compile Remove="Platform\iOS\CUIRadioButton.cs" />
	<Compile Remove="Platform\iOS\HandlerExtensions.cs" />
  </ItemGroup>

  <!-- Platform.Maui.MacOS provides the AppKit handler bridge for net11.0-macos. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
	<ProjectReference Include="..\..\..\mauiplatforms\src\Platform.Maui.MacOS\Platform.Maui.MacOS.csproj" />
  </ItemGroup>

  <Import Project="..\..\..\mauiplatforms\src\Platform.Maui.MacOS\build\Platform.Maui.MacOS.targets"
          Condition="$(TargetFramework.Contains('-macos'))" />

  <ItemGroup>
	<ProjectReference Include="..\Comet.SourceGenerator\Comet.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
	  <ReferenceSourceTarget>
	  </ReferenceSourceTarget>
	</ProjectReference>
	<ProjectReference Include="..\Comet.Layout.Yoga\Comet.Layout.Yoga.csproj" />
  </ItemGroup>

  <!-- Jetpack Compose backend (Android only) renders through the vendored
       Microsoft.AndroidX.Compose bridge layer. See src/vendor/VENDORED.md. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
	<ProjectReference Include="..\vendor\Microsoft.AndroidX.Compose\Microsoft.AndroidX.Compose.csproj" />
  </ItemGroup>

  <!-- SwiftUI backend (iOS only) renders through the CometSwiftUIShim @objc binding. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
	<ProjectReference Include="..\Comet.SwiftUI.Binding\Comet.SwiftUI.Binding.csproj" />
  </ItemGroup>

</Project>
