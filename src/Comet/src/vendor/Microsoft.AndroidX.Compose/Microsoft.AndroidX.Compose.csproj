<Project Sdk="Microsoft.NET.Sdk">
  <!--
    VENDORED from jonathanpeppers/Microsoft.AndroidX.Compose (MIT) — see ../VENDORED.md.
    Local changes: net10→net11 TFM; Compose package versions pinned inline (Comet's
