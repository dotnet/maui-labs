<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0;net10.0-android;net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseNet11AppleTargets)' != 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net11.0-ios;net10.0-maccatalyst;net11.0-maccatalyst;net10.0-macos;net11.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseNet11AppleTargets)' == 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios27.2;net11.0-maccatalyst27.2;net11.0-macos27.2</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <!-- AGP creates Gradle user home's FakeDependency.jar without cross-process locking.
         Serialize source-built native bridges across TFMs to avoid a cold-cache creation race. -->
    <BuildInParallel Condition="'$(TargetFramework)' == '' and '$(EssentialsAIAndroidNativeArtifactsPath)' == ''">false</BuildInParallel>
    <AssemblyName>Microsoft.Maui.Essentials.AI</AssemblyName>
    <RootNamespace>Microsoft.Maui.Essentials.AI</RootNamespace>
    <UseMaui>true</UseMaui>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsBindingProject>true</IsBindingProject>
    <!-- CA1416: Apple Intelligence APIs require iOS/macOS 26+ but the library supports
         older OS versions with runtime guards. Suppress to avoid errors in Release builds. -->
    <NoWarn>$(NoWarn);CA1416;MEDE0001;EXTEXP0019;XCODE_27_0_PREVIEW</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);BG8605;BG8606</NoWarn>
    <AndroidResourceDesignerClassModifier>internal</AndroidResourceDesignerClassModifier>
  </PropertyGroup>
  <PropertyGroup>
    <!-- NuGet package information -->
    <!-- Prototype only: daily extraction contracts are still experimental. -->
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
    <PackageId>Microsoft.Maui.Essentials.AI</PackageId>
    <!-- Keep this package always preview on its independent NuGet version line for all package builds.
         Bump the EssentialsAI version properties in eng/Versions.props for new previews. -->
    <MajorVersion>$(EssentialsAIMajorVersion)</MajorVersion>
    <MinorVersion>$(EssentialsAIMinorVersion)</MinorVersion>
    <PatchVersion>$(EssentialsAIPatchVersion)</PatchVersion>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <PreReleaseVersionLabel>$(EssentialsAIPreReleaseVersionLabel)</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>$(EssentialsAIPreviewVersionIteration)</PreReleaseVersionIteration>
    <PackageTags>$(DefaultPackageTags);essentials;ai</PackageTags>
    <Description>.NET Multi-platform App UI (.NET MAUI) is a cross-platform framework for creating native mobile and desktop apps with C# and XAML. This package contains a collection of cross-platform APIs for working with device AI and local models.</Description>
    <PackRepoRootReadme>false</PackRepoRootReadme>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.Firebase.Encoders" />
    <PackageReference Include="Xamarin.Firebase.Encoders.JSON" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportApi" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportRuntime" />
    <PackageReference Include="Xamarin.Google.Guava" />
    <PackageReference Include="Xamarin.Google.MLKit.Common" />
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Guava" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Reactive" />
    <!-- Bind only the bridge and package Google runtime archives separately. -->
    <AndroidGradleProject
      Include="../AndroidNative/EssentialsAI/build.gradle.kts"
      CreateAndroidLibrary="false"
      Condition="'$(EssentialsAIAndroidNativeArtifactsPath)' == ''" />
    <TransformFile Include="Platform\Android\Transforms\Metadata.xml" />
    <TransformFile Include="Platform\Android\Transforms\Metadata.Net11.xml" Condition="$(TargetFramework.StartsWith('net11.0'))" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) and '$(EssentialsAIAndroidNativeArtifactsPath)' != ''">
    <AndroidLibrary Include="$(EssentialsAIAndroidNativeArtifactsPath)/aar/EssentialsAI-release.aar" />
    <AndroidLibrary Include="$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime/*.aar" Bind="false" />
    <AndroidLibrary Include="$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime/*.jar" Bind="false" />
  </ItemGroup>
  <Target Name="ValidatePrebuiltGeminiNanoAndroidLibraries"
          BeforeTargets="PrepareForBuild"
          Condition="$(TargetFramework.Contains('-android')) and '$(EssentialsAIAndroidNativeArtifactsPath)' != ''">
    <Error
      Condition="!Exists('$(EssentialsAIAndroidNativeArtifactsPath)/aar/EssentialsAI-release.aar')"
      Text="The prebuilt EssentialsAI Android bridge was not found at '$(EssentialsAIAndroidNativeArtifactsPath)/aar/EssentialsAI-release.aar'." />
    <ItemGroup>
      <_PrebuiltGeminiNanoCommon Include="$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime/genai-common-*.aar" />
      <_PrebuiltGeminiNanoPrompt Include="$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime/genai-prompt-*.aar" />
      <_PrebuiltGeminiNanoSchema Include="$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime/genai-schema-*.jar" />
    </ItemGroup>
    <Error
      Condition="'@(_PrebuiltGeminiNanoCommon)' == ''"
      Text="The prebuilt EssentialsAI Android genai-common runtime archive was not found in '$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime'." />
    <Error
      Condition="'@(_PrebuiltGeminiNanoPrompt)' == ''"
      Text="The prebuilt EssentialsAI Android genai-prompt runtime archive was not found in '$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime'." />
    <Error
      Condition="'@(_PrebuiltGeminiNanoSchema)' == ''"
      Text="The prebuilt EssentialsAI Android genai-schema runtime archive was not found in '$(EssentialsAIAndroidNativeArtifactsPath)/mlkit-runtime'." />
  </Target>
  <Target Name="CollectGeminiNanoAndroidLibraries"
          AfterTargets="_BuildAndroidGradleProjects"
          Condition="$(TargetFramework.Contains('-android')) and '@(AndroidGradleProject)' != ''">
    <ItemGroup>
      <AndroidLibrary Include="%(AndroidGradleProject.OutputPath)outputs/aar/EssentialsAI-release.aar" />
      <AndroidLibrary Include="%(AndroidGradleProject.OutputPath)outputs/mlkit-runtime/*.aar" Bind="false" />
      <AndroidLibrary Include="%(AndroidGradleProject.OutputPath)outputs/mlkit-runtime/*.jar" Bind="false" />
    </ItemGroup>
  </Target>
  <!-- Windows AI WinRT APIs -->
  <ItemGroup Condition=" $(TargetFramework.Contains('-windows')) ">
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" VersionOverride="$(MicrosoftWindowsAppSDKAIVersion)" />
  </ItemGroup>
  <!-- Exclude Apple-only files from non-Apple TFMs (including net11.0 base) -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-ios')) AND !$(TargetFramework.Contains('-maccatalyst')) AND !$(TargetFramework.Contains('-macos'))">
    <Compile Remove="Platform\MaciOS\**\*.cs" />
    <Compile Remove="DocumentExtraction\AppleVisionRecognizeDocumentsClient.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
    <Compile Remove="Platform\Android\**\*.cs" />
  </ItemGroup>
  <!-- Exclude Windows-only files from non-Windows TFMs -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Platform\Windows\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition=" $(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst')) or $(TargetFramework.Contains('-macos')) ">
    <XcodeProject Include="..\AppleNative\EssentialsAI\EssentialsAI.xcodeproj">
      <SchemeName>EssentialsAI</SchemeName>
    </XcodeProject>
    <ObjcBindingApiDefinition Include="..\AppleNative\ApiDefinitions.cs" />
    <ObjcBindingApiDefinition Include="..\AppleNative\RecognizeDocumentsRequestApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="..\AppleNative\StructsAndEnums.cs" />
  </ItemGroup>
  <Import Project="..\AppleBindings.targets" />
</Project>
