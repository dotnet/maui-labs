<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CommunityToolkit.DocumentExtraction.Mistral</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CTDE0001;MEDE0001;EXTEXP0019</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction.Abstractions" />
    <PackageReference Include="Azure.Core" />
    <Compile Include="..\CommunityToolkit.DocumentExtraction\Upstream\DocumentExtraction\src\Mistral\*.cs" Link="Upstream\%(Filename)%(Extension)" />
    <Compile Include="..\CommunityToolkit.DocumentExtraction\Upstream\DocumentExtraction\src\Shared\ProviderAdapterHelpers.cs" Link="Shared\ProviderAdapterHelpers.cs" />
    <Compile Include="..\CommunityToolkit.DocumentExtraction\Upstream\Shared\Throw\Throw.cs" Link="Shared\Throw.cs" />
    <Using Include="Microsoft.Shared.Diagnostics" />
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute">
      <_Parameter1>CTDE0001</_Parameter1>
      <UrlFormat>https://github.com/CommunityToolkit/AI/blob/main/DocumentExtraction/README.md#experimental-api-diagnostics</UrlFormat>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
