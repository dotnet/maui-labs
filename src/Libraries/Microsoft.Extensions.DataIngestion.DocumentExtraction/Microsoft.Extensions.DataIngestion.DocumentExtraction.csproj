<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.Extensions.DataIngestion</RootNamespace>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);MEDE0001;MEAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Abstractions" />
    <ProjectReference Include="..\Microsoft.Extensions.DocumentExtraction.Abstractions\Microsoft.Extensions.DocumentExtraction.Abstractions.csproj" />
    <Compile Include="..\DocumentExtraction\Upstream\Microsoft.Extensions.DataIngestion\OcrDocumentReader.cs"
             Link="Upstream\OcrDocumentReader.cs" />
    <Compile Include="..\Shared\Diagnostics\Throw.cs" Link="Shared\Throw.cs" />
  </ItemGroup>
</Project>
