<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local build adapter. The complete upstream project is preserved unchanged and file-linked below. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.Extensions.DocumentExtraction</AssemblyName>
    <RootNamespace>Microsoft.Extensions.DocumentExtraction</RootNamespace>
    <PackageId>Microsoft.Extensions.DocumentExtraction</PackageId>
    <Description>Utilities for working with document extraction components.</Description>
    <NoWarn>$(NoWarn);MEDE0001;EXTEXP0019</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute">
      <_Parameter1>MEDE0001</_Parameter1>
      <_Parameter2>UrlFormat = "https://aka.ms/dotnet-extensions-warnings/{0}"</_Parameter2>
      <_Parameter2_IsLiteral>true</_Parameter2_IsLiteral>
    </AssemblyAttribute>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Middleware (logging/telemetry decorators, DI builder) builds on the abstractions. -->
    <ProjectReference Include="..\Microsoft.Extensions.DocumentExtraction.Abstractions\Microsoft.Extensions.DocumentExtraction.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DocumentExtraction\Upstream\Microsoft.Extensions.DocumentExtraction\*.cs"
             Link="Upstream\%(Filename)%(Extension)" />
    <!-- Local shims for upstream's internal Microsoft.Shared.* helpers (see src/Libraries/Shared). -->
    <Compile Include="..\Shared\Diagnostics\Throw.cs" Link="Shared\Diagnostics\Throw.cs" />
  </ItemGroup>

</Project>
