<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local build adapter. Every upstream artifact, including its project file, is preserved unchanged in Upstream. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.Extensions.DocumentExtraction.Abstractions</AssemblyName>
    <RootNamespace>Microsoft.Extensions.DocumentExtraction</RootNamespace>
    <PackageId>Microsoft.Extensions.DocumentExtraction.Abstractions</PackageId>
    <Description>Abstractions representing document extraction components (OCR, layout, tables, and figures).</Description>
    <!-- MEDE0001: the vendored APIs are marked [Experimental] upstream.
         MEAI001: the vendored APIs consume experimental Microsoft.Extensions.AI surface area. -->
    <NoWarn>$(NoWarn);MEDE0001;MEAI001</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DocumentExtraction\Upstream\Microsoft.Extensions.DocumentExtraction.Abstractions\*.cs"
             Link="Upstream\%(Filename)%(Extension)" />
    <!-- Local shims for upstream's internal Microsoft.Shared.* helpers (see src/Libraries/Shared). -->
    <Compile Include="..\Shared\Diagnostics\Throw.cs" Link="Shared\Diagnostics\Throw.cs" />
    <Compile Include="..\Shared\DiagnosticIds\DiagnosticIds.cs" Link="Shared\DiagnosticIds\DiagnosticIds.cs" />
  </ItemGroup>

</Project>
