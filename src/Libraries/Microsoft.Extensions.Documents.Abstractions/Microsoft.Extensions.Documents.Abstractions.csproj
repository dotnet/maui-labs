<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local build adapter; the complete original project is preserved under DocumentExtraction/Upstream. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.Extensions.Documents</RootNamespace>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);EXTEXP0019</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute">
      <_Parameter1>EXTEXP0019</_Parameter1>
      <_Parameter2>UrlFormat = "https://aka.ms/dotnet-extensions-warnings/{0}"</_Parameter2>
      <_Parameter2_IsLiteral>true</_Parameter2_IsLiteral>
    </AssemblyAttribute>
    <Compile Include="..\DocumentExtraction\Upstream\Microsoft.Extensions.Documents.Abstractions\*.cs"
             Link="Upstream\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Diagnostics\Throw.cs" Link="Shared\Diagnostics\Throw.cs" />
  </ItemGroup>
</Project>
