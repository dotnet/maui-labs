<Project>

  <PropertyGroup>
    <MauiTestAppBuildEnabled Condition="'$(MauiTestAppBuildEnabled)' == ''">true</MauiTestAppBuildEnabled>
    <MauiTestAppBuildOnBuild Condition="'$(MauiTestAppBuildOnBuild)' == ''">true</MauiTestAppBuildOnBuild>
    <MauiTestAppBuildOnTest Condition="'$(MauiTestAppBuildOnTest)' == ''">true</MauiTestAppBuildOnTest>
    <MauiTestAppBuildBeforeTargets Condition="'$(MauiTestAppBuildBeforeTargets)' == ''">CoreCompile</MauiTestAppBuildBeforeTargets>
    <MauiTestAppInnerBuildTarget Condition="'$(MauiTestAppInnerBuildTarget)' == ''">Build</MauiTestAppInnerBuildTarget>
    <MauiTestAppFailIfNoArtifacts Condition="'$(MauiTestAppFailIfNoArtifacts)' == ''">true</MauiTestAppFailIfNoArtifacts>
    <MauiTestAppSetPlatformOutputPaths Condition="'$(MauiTestAppSetPlatformOutputPaths)' == ''">true</MauiTestAppSetPlatformOutputPaths>
    <MauiTestAppGenerateSource Condition="'$(MauiTestAppGenerateSource)' == ''">true</MauiTestAppGenerateSource>
    <MauiTestAppGeneratedSourceNamespace Condition="'$(MauiTestAppGeneratedSourceNamespace)' == ''">Microsoft.Maui.TestApp.Build</MauiTestAppGeneratedSourceNamespace>
  </PropertyGroup>

</Project>
