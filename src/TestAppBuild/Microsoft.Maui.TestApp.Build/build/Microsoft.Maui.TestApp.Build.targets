<Project>

  <PropertyGroup>
    <MauiTestAppAppTargetsPath Condition="'$(MauiTestAppAppTargetsPath)' == ''">$(MSBuildThisFileDirectory)Microsoft.Maui.TestApp.Build.App.targets</MauiTestAppAppTargetsPath>
    <MauiTestAppCustomAfterMicrosoftCommonTargetsPath Condition="'$(MauiTestAppCustomAfterMicrosoftCommonTargetsPath)' == ''">$(MSBuildThisFileDirectory)Microsoft.Maui.TestApp.Build.CustomAfter.targets</MauiTestAppCustomAfterMicrosoftCommonTargetsPath>
    <MauiTestAppOutputRoot Condition="'$(MauiTestAppOutputRoot)' == ''">$(BaseIntermediateOutputPath)maui-test-apps\</MauiTestAppOutputRoot>
  </PropertyGroup>

  <Target Name="_CollectMauiTestAppProjectReferences"
          BeforeTargets="AssignProjectConfiguration;ResolveProjectReferences">
    <ItemGroup>
      <MauiTestAppProjectReference Remove="@(MauiTestAppProjectReference)" />
      <MauiTestAppProjectReference Include="@(ProjectReference)"
                                   Condition="'%(ProjectReference.MauiTestApp)' == 'true' or '%(ProjectReference.OutputItemType)' == 'MauiTestAppReference'" />
      <ProjectReference Remove="@(MauiTestAppProjectReference)" />
    </ItemGroup>
  </Target>

  <Target Name="_MauiTestAppBuildOnBuild"
          BeforeTargets="$(MauiTestAppBuildBeforeTargets)"
          DependsOnTargets="BuildMauiTestApps"
          Condition="'$(MauiTestAppBuildEnabled)' == 'true' and '$(MauiTestAppBuildOnBuild)' == 'true'" />

  <Target Name="_MauiTestAppBuildOnTest"
          BeforeTargets="VSTest"
          DependsOnTargets="BuildMauiTestApps"
          Condition="'$(MauiTestAppBuildEnabled)' == 'true' and '$(MauiTestAppBuildOnTest)' == 'true'" />

  <Target Name="ResolveMauiTestAppReferences"
          DependsOnTargets="_CollectMauiTestAppProjectReferences">
    <ItemGroup>
      <_MauiTestAppProjectReference Include="@(MauiTestAppProjectReference)">
        <_MauiTestAppUserProperties>%(MauiTestAppProjectReference.Properties)</_MauiTestAppUserProperties>
        <_MauiTestAppUserAdditionalProperties>%(MauiTestAppProjectReference.AdditionalProperties)</_MauiTestAppUserAdditionalProperties>
        <_MauiTestAppUserCustomAfterMicrosoftCommonTargets>$([System.Text.RegularExpressions.Regex]::Match('%(MauiTestAppProjectReference.Properties);%(MauiTestAppProjectReference.AdditionalProperties)', '(^|;)CustomAfterMicrosoftCommonTargets=([^;]+)').Groups[2].Value)</_MauiTestAppUserCustomAfterMicrosoftCommonTargets>
        <Properties></Properties>
      </_MauiTestAppProjectReference>

      <_MauiTestAppExplicitReference Include="@(MauiTestAppReference)">
        <_MauiTestAppUserProperties>%(MauiTestAppReference.Properties)</_MauiTestAppUserProperties>
        <_MauiTestAppUserAdditionalProperties>%(MauiTestAppReference.AdditionalProperties)</_MauiTestAppUserAdditionalProperties>
        <_MauiTestAppUserCustomAfterMicrosoftCommonTargets>$([System.Text.RegularExpressions.Regex]::Match('%(MauiTestAppReference.Properties);%(MauiTestAppReference.AdditionalProperties)', '(^|;)CustomAfterMicrosoftCommonTargets=([^;]+)').Groups[2].Value)</_MauiTestAppUserCustomAfterMicrosoftCommonTargets>
        <Properties></Properties>
      </_MauiTestAppExplicitReference>

      <_ResolvedMauiTestAppReference Include="@(_MauiTestAppProjectReference)">
        <ReferenceName Condition="'%(_MauiTestAppProjectReference.ReferenceName)' != ''">%(_MauiTestAppProjectReference.ReferenceName)</ReferenceName>
        <ReferenceName Condition="'%(_MauiTestAppProjectReference.ReferenceName)' == ''">%(_MauiTestAppProjectReference.Filename)</ReferenceName>
        <ProjectPath>%(_MauiTestAppProjectReference.FullPath)</ProjectPath>
        <TargetFramework Condition="'%(_MauiTestAppProjectReference.TargetFramework)' != ''">%(_MauiTestAppProjectReference.TargetFramework)</TargetFramework>
        <TargetFramework Condition="'%(_MauiTestAppProjectReference.TargetFramework)' == '' and '%(_MauiTestAppProjectReference.SetTargetFramework)' != ''">$([System.Text.RegularExpressions.Regex]::Match('%(_MauiTestAppProjectReference.SetTargetFramework)', 'TargetFramework=([^;]+)').Groups[1].Value)</TargetFramework>
        <Configuration Condition="'%(_MauiTestAppProjectReference.Configuration)' != ''">%(_MauiTestAppProjectReference.Configuration)</Configuration>
        <Configuration Condition="'%(_MauiTestAppProjectReference.Configuration)' == ''">$(Configuration)</Configuration>
        <RuntimeIdentifier>%(_MauiTestAppProjectReference.RuntimeIdentifier)</RuntimeIdentifier>
        <Platform>%(_MauiTestAppProjectReference.Platform)</Platform>
        <BuildTarget Condition="'%(_MauiTestAppProjectReference.BuildTarget)' != ''">%(_MauiTestAppProjectReference.BuildTarget)</BuildTarget>
        <BuildTarget Condition="'%(_MauiTestAppProjectReference.BuildTarget)' == ''">$(MauiTestAppInnerBuildTarget)</BuildTarget>
        <ArtifactName Condition="'%(_MauiTestAppProjectReference.ArtifactName)' != ''">%(_MauiTestAppProjectReference.ArtifactName)</ArtifactName>
        <ArtifactName Condition="'%(_MauiTestAppProjectReference.ArtifactName)' == ''">%(_MauiTestAppProjectReference.Filename)</ArtifactName>
        <ExpectedArtifact>%(_MauiTestAppProjectReference.ExpectedArtifact)</ExpectedArtifact>
        <SetPlatformOutputPaths Condition="'%(_MauiTestAppProjectReference.SetPlatformOutputPaths)' != ''">%(_MauiTestAppProjectReference.SetPlatformOutputPaths)</SetPlatformOutputPaths>
        <SetPlatformOutputPaths Condition="'%(_MauiTestAppProjectReference.SetPlatformOutputPaths)' == ''">$(MauiTestAppSetPlatformOutputPaths)</SetPlatformOutputPaths>
        <_MauiTestAppOutputRootExplicit Condition="'%(_MauiTestAppProjectReference.OutputRoot)' != ''">true</_MauiTestAppOutputRootExplicit>
        <OutputRoot Condition="'%(_MauiTestAppProjectReference.OutputRoot)' != ''">%(_MauiTestAppProjectReference.OutputRoot)</OutputRoot>
        <OutputRoot Condition="'%(_MauiTestAppProjectReference.OutputRoot)' == ''">$(MauiTestAppOutputRoot)%(_MauiTestAppProjectReference.Filename)\</OutputRoot>
        <PreviousCustomAfterMicrosoftCommonTargets Condition="'%(_MauiTestAppProjectReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)' != ''">%(_MauiTestAppProjectReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)</PreviousCustomAfterMicrosoftCommonTargets>
        <PreviousCustomAfterMicrosoftCommonTargets Condition="'%(_MauiTestAppProjectReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)' == ''">$(CustomAfterMicrosoftCommonTargets)</PreviousCustomAfterMicrosoftCommonTargets>
        <_MauiTestAppUserProperties>%(_MauiTestAppProjectReference._MauiTestAppUserProperties)</_MauiTestAppUserProperties>
        <_MauiTestAppUserAdditionalProperties>%(_MauiTestAppProjectReference._MauiTestAppUserAdditionalProperties)</_MauiTestAppUserAdditionalProperties>
        <Properties></Properties>
      </_ResolvedMauiTestAppReference>

      <_ResolvedMauiTestAppReference Include="@(_MauiTestAppExplicitReference)">
        <ReferenceName Condition="'%(_MauiTestAppExplicitReference.ReferenceName)' != ''">%(_MauiTestAppExplicitReference.ReferenceName)</ReferenceName>
        <ReferenceName Condition="'%(_MauiTestAppExplicitReference.ReferenceName)' == ''">%(_MauiTestAppExplicitReference.Filename)</ReferenceName>
        <ProjectPath>%(_MauiTestAppExplicitReference.FullPath)</ProjectPath>
        <TargetFramework>%(_MauiTestAppExplicitReference.TargetFramework)</TargetFramework>
        <Configuration Condition="'%(_MauiTestAppExplicitReference.Configuration)' != ''">%(_MauiTestAppExplicitReference.Configuration)</Configuration>
        <Configuration Condition="'%(_MauiTestAppExplicitReference.Configuration)' == ''">$(Configuration)</Configuration>
        <RuntimeIdentifier>%(_MauiTestAppExplicitReference.RuntimeIdentifier)</RuntimeIdentifier>
        <Platform>%(_MauiTestAppExplicitReference.Platform)</Platform>
        <BuildTarget Condition="'%(_MauiTestAppExplicitReference.BuildTarget)' != ''">%(_MauiTestAppExplicitReference.BuildTarget)</BuildTarget>
        <BuildTarget Condition="'%(_MauiTestAppExplicitReference.BuildTarget)' == ''">$(MauiTestAppInnerBuildTarget)</BuildTarget>
        <ArtifactName Condition="'%(_MauiTestAppExplicitReference.ArtifactName)' != ''">%(_MauiTestAppExplicitReference.ArtifactName)</ArtifactName>
        <ArtifactName Condition="'%(_MauiTestAppExplicitReference.ArtifactName)' == ''">%(_MauiTestAppExplicitReference.Filename)</ArtifactName>
        <ExpectedArtifact>%(_MauiTestAppExplicitReference.ExpectedArtifact)</ExpectedArtifact>
        <SetPlatformOutputPaths Condition="'%(_MauiTestAppExplicitReference.SetPlatformOutputPaths)' != ''">%(_MauiTestAppExplicitReference.SetPlatformOutputPaths)</SetPlatformOutputPaths>
        <SetPlatformOutputPaths Condition="'%(_MauiTestAppExplicitReference.SetPlatformOutputPaths)' == ''">$(MauiTestAppSetPlatformOutputPaths)</SetPlatformOutputPaths>
        <_MauiTestAppOutputRootExplicit Condition="'%(_MauiTestAppExplicitReference.OutputRoot)' != ''">true</_MauiTestAppOutputRootExplicit>
        <OutputRoot Condition="'%(_MauiTestAppExplicitReference.OutputRoot)' != ''">%(_MauiTestAppExplicitReference.OutputRoot)</OutputRoot>
        <OutputRoot Condition="'%(_MauiTestAppExplicitReference.OutputRoot)' == ''">$(MauiTestAppOutputRoot)%(_MauiTestAppExplicitReference.Filename)\</OutputRoot>
        <PreviousCustomAfterMicrosoftCommonTargets Condition="'%(_MauiTestAppExplicitReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)' != ''">%(_MauiTestAppExplicitReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)</PreviousCustomAfterMicrosoftCommonTargets>
        <PreviousCustomAfterMicrosoftCommonTargets Condition="'%(_MauiTestAppExplicitReference._MauiTestAppUserCustomAfterMicrosoftCommonTargets)' == ''">$(CustomAfterMicrosoftCommonTargets)</PreviousCustomAfterMicrosoftCommonTargets>
        <_MauiTestAppUserProperties>%(_MauiTestAppExplicitReference._MauiTestAppUserProperties)</_MauiTestAppUserProperties>
        <_MauiTestAppUserAdditionalProperties>%(_MauiTestAppExplicitReference._MauiTestAppUserAdditionalProperties)</_MauiTestAppUserAdditionalProperties>
        <Properties></Properties>
      </_ResolvedMauiTestAppReference>
    </ItemGroup>

    <Error Condition="'@(_ResolvedMauiTestAppReference)' != '' and !Exists('$(MauiTestAppAppTargetsPath)')"
            Text="The MAUI test app child targets file was not found at '$(MauiTestAppAppTargetsPath)'." />

    <Error Condition="'@(_ResolvedMauiTestAppReference)' != '' and !Exists('$(MauiTestAppCustomAfterMicrosoftCommonTargetsPath)')"
           Text="The MAUI test app custom-after wrapper targets file was not found at '$(MauiTestAppCustomAfterMicrosoftCommonTargetsPath)'." />

    <ItemGroup>
      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference._MauiTestAppOutputRootExplicit)' != 'true' and '%(_ResolvedMauiTestAppReference.TargetFramework)' != ''">
        <OutputRoot>%(_ResolvedMauiTestAppReference.OutputRoot)%(_ResolvedMauiTestAppReference.TargetFramework)\</OutputRoot>
      </_ResolvedMauiTestAppReference>

      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference._MauiTestAppOutputRootExplicit)' != 'true' and '%(_ResolvedMauiTestAppReference.RuntimeIdentifier)' != ''">
        <OutputRoot>%(_ResolvedMauiTestAppReference.OutputRoot)%(_ResolvedMauiTestAppReference.RuntimeIdentifier)\</OutputRoot>
      </_ResolvedMauiTestAppReference>
    </ItemGroup>

    <ItemGroup>
      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)">
        <AdditionalProperties>%(_ResolvedMauiTestAppReference._MauiTestAppUserProperties);%(_ResolvedMauiTestAppReference._MauiTestAppUserAdditionalProperties);Configuration=%(_ResolvedMauiTestAppReference.Configuration);MauiTestAppInnerBuildTarget=%(_ResolvedMauiTestAppReference.BuildTarget);MauiTestAppOutputRoot=%(_ResolvedMauiTestAppReference.OutputRoot);MauiTestAppReferenceName=%(_ResolvedMauiTestAppReference.ReferenceName);MauiTestAppArtifactName=%(_ResolvedMauiTestAppReference.ArtifactName);MauiTestAppExpectedArtifact=%(_ResolvedMauiTestAppReference.ExpectedArtifact);MauiTestAppSetPlatformOutputPaths=%(_ResolvedMauiTestAppReference.SetPlatformOutputPaths);MauiTestAppAppTargetsPath=$(MauiTestAppAppTargetsPath);MauiTestAppPreviousCustomAfterMicrosoftCommonTargets=%(_ResolvedMauiTestAppReference.PreviousCustomAfterMicrosoftCommonTargets);CustomAfterMicrosoftCommonTargets=$(MauiTestAppCustomAfterMicrosoftCommonTargetsPath)</AdditionalProperties>
      </_ResolvedMauiTestAppReference>

      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference.TargetFramework)' != ''">
        <AdditionalProperties>%(_ResolvedMauiTestAppReference.AdditionalProperties);TargetFramework=%(_ResolvedMauiTestAppReference.TargetFramework)</AdditionalProperties>
      </_ResolvedMauiTestAppReference>

      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference.RuntimeIdentifier)' != ''">
        <AdditionalProperties>%(_ResolvedMauiTestAppReference.AdditionalProperties);RuntimeIdentifier=%(_ResolvedMauiTestAppReference.RuntimeIdentifier)</AdditionalProperties>
      </_ResolvedMauiTestAppReference>

      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference.Platform)' != ''">
        <AdditionalProperties>%(_ResolvedMauiTestAppReference.AdditionalProperties);Platform=%(_ResolvedMauiTestAppReference.Platform)</AdditionalProperties>
      </_ResolvedMauiTestAppReference>
    </ItemGroup>

    <ItemGroup>
      <_ResolvedMauiTestAppReference Update="@(_ResolvedMauiTestAppReference)"
                                    Condition="'%(_ResolvedMauiTestAppReference.SetPlatformOutputPaths)' == 'true'">
        <AdditionalProperties Condition="'%(_ResolvedMauiTestAppReference.SetPlatformOutputPaths)' == 'true'">%(_ResolvedMauiTestAppReference.AdditionalProperties);OutputPath=%(_ResolvedMauiTestAppReference.OutputRoot)bin\;AndroidPackageOutputPath=%(_ResolvedMauiTestAppReference.OutputRoot)package\;AndroidBuildApplicationPackage=true;AppBundleDir=%(_ResolvedMauiTestAppReference.OutputRoot)app\%(_ResolvedMauiTestAppReference.ArtifactName).app;IpaPackageDir=%(_ResolvedMauiTestAppReference.OutputRoot)package\;PublishDir=%(_ResolvedMauiTestAppReference.OutputRoot)publish\</AdditionalProperties>
      </_ResolvedMauiTestAppReference>
    </ItemGroup>
  </Target>

  <Target Name="BuildMauiTestApps"
          DependsOnTargets="ResolveMauiTestAppReferences">
    <MSBuild Projects="@(_ResolvedMauiTestAppReference)"
             Targets="_MauiTestAppBuildAndGetArtifacts"
             BuildInParallel="$(BuildInParallel)"
             SkipNonexistentProjects="false"
             SkipNonexistentTargets="false">
      <Output TaskParameter="TargetOutputs" ItemName="_MauiTestAppBuiltArtifact" />
    </MSBuild>

    <ItemGroup>
      <MauiTestAppArtifact Include="@(_MauiTestAppBuiltArtifact)" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(MauiTestAppArtifact)"
                      Condition="'@(MauiTestAppArtifact)' != ''">
      <Output TaskParameter="Filtered" ItemName="_MauiTestAppDistinctBuiltArtifact" />
    </RemoveDuplicates>

    <ItemGroup Condition="'@(_MauiTestAppDistinctBuiltArtifact)' != ''">
      <MauiTestAppArtifact Remove="@(MauiTestAppArtifact)" />
      <MauiTestAppArtifact Include="@(_MauiTestAppDistinctBuiltArtifact)" />
    </ItemGroup>

    <PropertyGroup>
      <MauiTestAppArtifacts>@(MauiTestAppArtifact)</MauiTestAppArtifacts>
      <MauiTestAppArtifactPaths>@(MauiTestAppArtifact->'%(FullPath)')</MauiTestAppArtifactPaths>
    </PropertyGroup>

    <Message Importance="High"
             Condition="'@(MauiTestAppArtifact)' != ''"
             Text="Resolved MAUI test app artifact: %(MauiTestAppArtifact.Identity) (%(MauiTestAppArtifact.TargetFramework) %(MauiTestAppArtifact.RuntimeIdentifier))" />

    <Error Condition="'@(_ResolvedMauiTestAppReference)' != '' and '$(MauiTestAppFailIfNoArtifacts)' == 'true' and '@(MauiTestAppArtifact)' == ''"
           Text="No MAUI test app artifacts were produced. Check MauiTestApp ProjectReference metadata, target framework, runtime identifier, and child build properties." />
  </Target>

  <Target Name="CleanMauiTestAppArtifacts"
          AfterTargets="Clean"
          Condition="'$(MauiTestAppOutputRoot)' != '' and Exists('$(MauiTestAppOutputRoot)')">
    <PropertyGroup>
      <_MauiTestAppCleanOutputRoot>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(MauiTestAppOutputRoot)'))))</_MauiTestAppCleanOutputRoot>
      <_MauiTestAppCleanBaseIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))))</_MauiTestAppCleanBaseIntermediateOutputPath>
      <_MauiTestAppCleanOutputRootUpper>$([System.String]::Copy('$(_MauiTestAppCleanOutputRoot)').ToUpperInvariant())</_MauiTestAppCleanOutputRootUpper>
      <_MauiTestAppCleanBaseIntermediateOutputPathUpper>$([System.String]::Copy('$(_MauiTestAppCleanBaseIntermediateOutputPath)').ToUpperInvariant())</_MauiTestAppCleanBaseIntermediateOutputPathUpper>
      <_MauiTestAppCleanOutputRootIsSafe Condition="'$(_MauiTestAppCleanOutputRootUpper)' != '$(_MauiTestAppCleanBaseIntermediateOutputPathUpper)' and $([System.String]::Copy('$(_MauiTestAppCleanOutputRootUpper)').StartsWith('$(_MauiTestAppCleanBaseIntermediateOutputPathUpper)'))">true</_MauiTestAppCleanOutputRootIsSafe>
    </PropertyGroup>

    <Warning Condition="'$(_MauiTestAppCleanOutputRootIsSafe)' != 'true'"
             Text="Skipping MAUI test app artifact clean because '$(MauiTestAppOutputRoot)' is outside '$(BaseIntermediateOutputPath)' or resolves to the intermediate root itself." />

    <RemoveDir Directories="$(MauiTestAppOutputRoot)"
               Condition="'$(_MauiTestAppCleanOutputRootIsSafe)' == 'true'" />
  </Target>

</Project>
