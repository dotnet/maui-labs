<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="xunit" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cli\Microsoft.Maui.Cli\Microsoft.Maui.Cli.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Agent.Core\Microsoft.Maui.DevFlow.Agent.Core.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Analyzers\Microsoft.Maui.DevFlow.Analyzers.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Driver\Microsoft.Maui.DevFlow.Driver.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Logging\Microsoft.Maui.DevFlow.Logging.csproj" />
  </ItemGroup>

  <!--
    MauiFreeAssemblyTests reads Agent.Native and Agent.Native.Essentials straight out of
    artifacts/bin via PE metadata, because their real TFMs (android/ios/maccatalyst/macos) cannot
    be a normal compile-time ProjectReference from this net10.0 project. Without something forcing
    a build, "dotnet test" on this project alone finds stale or absent output and the guard passes
    vacuously. These are build-only references (no assembly is added to this project's compilation)
    that force MSBuild to build the android TFM — present unconditionally on every OS — as part of
    building this test project, so the assemblies the guard inspects are always current.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Agent.Native\Microsoft.Maui.DevFlow.Agent.Native.csproj"
                       ReferenceOutputAssembly="false"
                       SkipGetTargetFrameworkProperties="true"
                       SetTargetFramework="TargetFramework=net10.0-android" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Agent.Native.Essentials\Microsoft.Maui.DevFlow.Agent.Native.Essentials.csproj"
                       ReferenceOutputAssembly="false"
                       SkipGetTargetFrameworkProperties="true"
                       SetTargetFramework="TargetFramework=net10.0-android" />
  </ItemGroup>

  <!-- Compiled by reference (not a project reference) because the source lives in the
       macOS-only (net10.0-macos) MacOS platform project, which this net10.0 test project
       cannot reference. Both files have no AppKit/MAUI dependency, so they can be compiled
       and unit tested here directly. -->
  <ItemGroup>
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\DialogNativeRegistrationScope.cs"
              Link="DialogNativeRegistrationScope.cs" />
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\DialogNativeElementContract.cs"
              Link="DialogNativeElementContract.cs" />
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\DialogCompletionScope.cs"
              Link="DialogCompletionScope.cs" />
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\ToolbarItemInvocationOutcome.cs"
              Link="ToolbarItemInvocationOutcome.cs" />
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\ActionSheetResultResolver.cs"
              Link="ActionSheetResultResolver.cs" />
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\ShellSearchHandlerCoordinator.cs"
              Link="ShellSearchHandlerCoordinator.cs" />
    <!-- The production diagnostic publishers used by the non-MAUI platform backends. Linking the
         real bridges — rather than
         re-typing its DiagnosticListener name/event names/payload shape by hand in a test — is
         what makes NativeElementDiagnosticContractTests an actual cross-assembly contract check
         instead of a test that only compares MauiNativeElementDiagnosticSubscriber's constants
         against themselves. Has no AppKit/MAUI Controls dependency; only needs IMauiContext,
         which is already on the graph via Agent.Core -> Microsoft.Maui.Controls. -->
    <Compile Include="..\..\..\platforms\MacOS\src\MacOS\Platform\NativeElementDiagnosticsBridge.cs"
              Link="NativeElementDiagnosticsBridge.cs" />
    <Compile Include="..\..\..\platforms\Linux.Gtk4\src\Linux.Gtk4\Platform\NativeElementDiagnosticsBridge.cs"
              Link="GtkNativeElementDiagnosticsBridge.cs" />
    <Compile Include="..\..\..\platforms\Windows.WPF\src\Windows.WPF\Platform\NativeElementDiagnosticsBridge.cs"
              Link="WpfNativeElementDiagnosticsBridge.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent.Native only multi-targets platform TFMs, so it cannot be referenced from this net10.0
         project. Link the registry source instead: its id bookkeeping is platform-agnostic (the one
         platform-specific bit, the ObjC stable key, is injectable) and is worth covering here
         because the alternative is relying on device integration runs, where the GC timing that
         drives this code is nondeterministic. -->
    <Compile Include="..\Microsoft.Maui.DevFlow.Agent.Native\NativeElementRegistry.cs"
             Link="Native\NativeElementRegistry.cs" />
    <!-- The AppKit window-base-to-top-left flip is pure math with no AppKit dependency, so it is
         worth covering here directly: it is the part of the native agent's coordinate reporting
         most likely to regress silently, since the bug it fixes (screen-absolute bounds instead
         of window-logical ones) only shows up once a window moves away from the screen origin. -->
    <Compile Include="..\Microsoft.Maui.DevFlow.Agent.Native\NativeUi.Coordinates.cs"
             Link="Native\NativeUi.Coordinates.cs" />
  </ItemGroup>

</Project>
