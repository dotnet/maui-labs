<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS_BUILD</DefineConstants>
    <!-- Only pack from the DevFlow pipeline job; the Cli job includes this project
         as a ProjectReference but the DevFlow job owns the package. -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(PackDriverNuGet)' == 'true'">true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Microsoft.Maui.DevFlow.Driver</PackageId>
    <IsShipping>true</IsShipping>
    <Description>Driver library for connecting to Microsoft.Maui.DevFlow Agent and orchestrating MAUI app automation.</Description>
    <PackageTags>maui;automation;testing;driver</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Xamarin.Android.Tools.AndroidSdk" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Interop.UIAutomationClient" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Client\Microsoft.Maui.DevFlow.Client.csproj" />
  </ItemGroup>

  <!-- This dependency is only published to a transport feed, not NuGet.org.
       Bundle its entire library folder, including localized resources and symbols. -->
  <ItemGroup>
    <None Include="$(PkgXamarin_Android_Tools_AndroidSdk)\lib\netstandard2.0\**\*"
          Pack="true"
          PackagePath="lib\$(TargetFramework)\"
          Visible="false" />
  </ItemGroup>

</Project>
