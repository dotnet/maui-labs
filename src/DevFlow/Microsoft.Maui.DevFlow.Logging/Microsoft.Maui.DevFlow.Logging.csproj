<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.Maui.DevFlow.Logging</PackageId>
    <IsShipping>true</IsShipping>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Buffered rotating JSONL file logger for Microsoft.Maui.DevFlow. No MAUI dependency.</Description>
    <PackageTags>logging;jsonl;rotating</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Maui.DevFlow.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
