<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 is the point of the portable client: it proves a .NET Framework harness (Visual
         Studio Apex tests) can drive the same protocol as modern .NET consumers, running the exact
         same test source against the netstandard2.0 asset. .NET Framework only runs on Windows, so
         non-Windows CI legs still get the modern-target family. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net472;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Client\Microsoft.Maui.DevFlow.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
