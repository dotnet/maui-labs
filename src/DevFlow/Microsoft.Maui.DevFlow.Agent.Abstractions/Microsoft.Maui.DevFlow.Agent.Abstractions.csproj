<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>

    <PackageId>Microsoft.Maui.DevFlow.Agent.Abstractions</PackageId>
    <Description>Framework-neutral agent infrastructure for Microsoft.Maui.DevFlow. HTTP server, protocol handling, CSS querying, network capture, and profiling — with no dependency on .NET MAUI. UI frameworks plug in through the backend interfaces.</Description>
    <PackageTags>maui;automation;testing;agent;abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fizzler" />
    <PackageReference Include="SkiaSharp" />

    <!-- The SQLite browser. .Core rather than Microsoft.Data.Sqlite so nothing registers a provider
         behind our back: the host app may already have one, and replacing it would change how the
         app under test talks to its own database. SqliteGateway decides. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Logging\Microsoft.Maui.DevFlow.Logging.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Analyzers\Microsoft.Maui.DevFlow.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
