<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>

    <PackageId>Microsoft.Maui.DevFlow.Agent.Core</PackageId>
    <Description>The .NET MAUI backend for Microsoft.Maui.DevFlow. Implements visual tree walking, element interaction, screenshots, storage and device endpoints on top of Microsoft.Maui.DevFlow.Agent.Abstractions.</Description>
    <PackageTags>maui;automation;testing;agent;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fizzler" />
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(DevFlowMauiMinVersion)" />
    <PackageReference Include="Microsoft.Maui.Essentials" VersionOverride="$(DevFlowMauiMinVersion)" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Essentials endpoint implementations, shared with the optional add-on for plain .NET apps. -->
  <ItemGroup>
    <Compile Include="..\Shared.Essentials\**\*.cs"
             Exclude="..\Shared.Essentials\NativePreferenceKeys.cs"
             LinkBase="Essentials" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Agent.Abstractions\Microsoft.Maui.DevFlow.Agent.Abstractions.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Logging\Microsoft.Maui.DevFlow.Logging.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Analyzers\Microsoft.Maui.DevFlow.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Pack the DevFlow analyzers/source generators into the analyzers folder so NuGet consumers
       (MAUI apps) run the XAML source-map generator against their own .xaml files. -->
  <!-- Package files are collected in the outer build, where @(Analyzer) is not populated. -->
  <Target Name="_ResolveDevFlowAnalyzerPath" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('OutputItemType', 'Analyzer'))"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_DevFlowAnalyzerAssembly" />
    </MSBuild>
    <Error Condition="'@(_DevFlowAnalyzerAssembly)' == '' or !Exists('%(_DevFlowAnalyzerAssembly.Identity)')"
           Text="The DevFlow analyzer assembly is missing. Build the project before packing with --no-build." />
    <ItemGroup>
      <None Include="@(_DevFlowAnalyzerAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Ship the buildTransitive props/targets that promote @(MauiXaml) -> @(AdditionalFiles) for the
       generator (gated on $(DevFlowXamlSourceMapsEnabled)). Remove-then-Include so we never collide
       with the SDK's default None glob. -->

  <ItemGroup>
    <None Remove="buildTransitive\**" />
    <None Include="buildTransitive\Microsoft.Maui.DevFlow.Agent.Core.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Microsoft.Maui.DevFlow.Agent.Core.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
