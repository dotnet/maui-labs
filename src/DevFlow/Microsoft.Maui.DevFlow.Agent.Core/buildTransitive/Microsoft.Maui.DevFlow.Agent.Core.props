<Project>

  <!--
    DevFlow XAML source maps power "click-to-XAML-source" in the DevFlow inspector: the build-time
    generator records each XAML element's source position so the running app's visual tree can point
    back at the .xaml line that declared it.

    Enabled for DEBUG builds only by default, because it embeds XAML text and developer-machine file
    paths into the app assembly — undesirable for Release / AOT / store builds. Set
    DevFlowXamlSourceMapsEnabled explicitly in your project to force it on or off.
  -->
  <PropertyGroup>
    <MauiDevFlowProfileMode Condition="'$(MauiDevFlowProfileMode)' == ''">false</MauiDevFlowProfileMode>
    <MauiDevFlowEnabled Condition="'$(MauiDevFlowEnabled)' == '' and '$(MauiDevFlowProfileMode)' == 'true'">true</MauiDevFlowEnabled>
    <MauiDevFlowEnabled Condition="'$(MauiDevFlowEnabled)' == '' and '$(Configuration)' == 'Debug'">true</MauiDevFlowEnabled>
    <MauiDevFlowEnabled Condition="'$(MauiDevFlowEnabled)' == ''">false</MauiDevFlowEnabled>
    <DevFlowXamlSourceMapsEnabled Condition="'$(DevFlowXamlSourceMapsEnabled)' == '' and '$(MauiDevFlowEnabled)' == 'true' and '$(MauiDevFlowProfileMode)' != 'true' and '$(Configuration)' == 'Debug'">true</DevFlowXamlSourceMapsEnabled>
    <DevFlowXamlSourceMapsEnabled Condition="'$(DevFlowXamlSourceMapsEnabled)' == ''">false</DevFlowXamlSourceMapsEnabled>
    <EnableMauiDiagnostics Condition="'$(EnableMauiDiagnostics)' == '' and '$(MauiDevFlowEnabled)' == 'true' and '$(MauiDevFlowProfileMode)' != 'true'">true</EnableMauiDiagnostics>
  </PropertyGroup>

</Project>
