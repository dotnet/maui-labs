<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <PackageId>Microsoft.Maui.DevFlow.Blazor.Gtk</PackageId>
    <Description>Blazor WebView CDP debugging for Maui.Gtk apps using WebKitGTK. Enables Chrome DevTools Protocol access for Blazor Hybrid content on Linux.</Description>
    <PackageTags>maui;blazor;debugging;cdp;gtk;linux;webkit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Maui.DevFlow.Agent.Gtk.Tests" />
    <ProjectReference Include="..\Microsoft.Maui.DevFlow.Agent.Core\Microsoft.Maui.DevFlow.Agent.Core.csproj" />
    <ProjectReference Include="..\..\..\platforms\Linux.Gtk4\src\Linux.Gtk4.BlazorWebView\Linux.Gtk4.BlazorWebView.csproj" />
  </ItemGroup>

  <!-- Embed JS scripts as resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Scripts\*.js" />
  </ItemGroup>

</Project>
