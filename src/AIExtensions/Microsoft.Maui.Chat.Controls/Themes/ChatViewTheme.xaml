<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="clr-namespace:Microsoft.Maui.Chat.Controls"
                    x:Class="Microsoft.Maui.Chat.Controls.Themes.ChatViewTheme">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: ChatView (the whole chat surface)              -->
    <!--                                                                 -->
    <!-- Every PART_* is optional: drop one to remove that section.      -->
    <!-- All state flows through template bindings, so replacing this     -->
    <!-- template never requires code. Colours come from the styles in    -->
    <!-- ChatStyles.xaml, which carry their own light and dark values.    -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiChat.ChatViewTemplate">
        <Grid x:DataType="chat:ChatView" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="0">

            <!-- Header -->
            <ContentView x:Name="PART_Header" Grid.Row="0" IsVisible="False" />

            <!-- Messages, welcome, empty state, and busy indicator share one cell -->
            <Grid Grid.Row="1">
                <chat:ChatMessagesView x:Name="PART_MessageList"
                                       Margin="12,8,12,0"
                                       Conversation="{TemplateBinding Conversation}"
                                       ContentTemplates="{TemplateBinding ContentTemplates}"
                                       UseDefaultContentTemplates="{TemplateBinding UseDefaultContentTemplates}"
                                       Appearance="{TemplateBinding Appearance}"
                                       AutoScrollToLatest="{TemplateBinding AutoScrollToLatest}" />

                <VerticalStackLayout x:Name="PART_WelcomePanel"
                                     Padding="24"
                                     Spacing="12"
                                     InputTransparent="True"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     IsVisible="{TemplateBinding ShowWelcome}">
                    <Label x:Name="PART_WelcomeIcon"
                           Style="{DynamicResource MauiChat.WelcomeIcon}"
                           Text="{TemplateBinding WelcomeIcon}" />
                    <Label x:Name="PART_WelcomeMessage"
                           Style="{DynamicResource MauiChat.WelcomeMessage}"
                           Text="{TemplateBinding WelcomeMessage}"
                           SemanticProperties.Description="{TemplateBinding WelcomeMessage}" />
                </VerticalStackLayout>

                <ContentView x:Name="PART_EmptyView"
                             IsVisible="{TemplateBinding ShowEmptyView}" />

                <ActivityIndicator x:Name="PART_BusyIndicator"
                                   Margin="0,0,0,12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   AutomationId="ChatBusyIndicator"
                                   SemanticProperties.Description="Waiting for a response"
                                   IsRunning="{TemplateBinding IsBusy}"
                                   IsVisible="{TemplateBinding IsBusy}" />
            </Grid>

            <!-- Suggestions -->
            <FlexLayout x:Name="PART_Suggestions"
                        Grid.Row="2"
                        Margin="12,4"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AutomationId="ChatSuggestions"
                        IsVisible="{TemplateBinding ShowSuggestions}" />

            <!-- Footer -->
            <ContentView x:Name="PART_Footer" Grid.Row="3" IsVisible="False" />

            <!-- Send error -->
            <Label Grid.Row="4"
                   Margin="16,0"
                   Style="{DynamicResource MauiChat.ErrorText}"
                   AutomationId="ChatSendError"
                   Text="{TemplateBinding SendError}"
                   IsVisible="{TemplateBinding HasSendError}" />

            <!-- Composer -->
            <Border x:Name="PART_InputArea"
                    Grid.Row="5"
                    Margin="12,8,12,12"
                    Padding="6"
                    StrokeThickness="0"
                    Style="{DynamicResource MauiChat.InputArea}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="6" RowSpacing="4">

                    <FlexLayout x:Name="PART_Attachments"
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Wrap="Wrap"
                                AutomationId="ChatAttachments"
                                IsVisible="{TemplateBinding HasAttachments}" />

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="8,0"
                           Style="{DynamicResource MauiChat.ErrorText}"
                           AutomationId="ChatAttachmentError"
                           Text="{TemplateBinding AttachmentError}"
                           IsVisible="{TemplateBinding HasAttachmentError}" />

                    <Button x:Name="PART_AttachButton"
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{DynamicResource MauiChat.AttachButton}"
                            Text="{TemplateBinding AttachButtonText}"
                            AutomationId="ChatAttachButton"
                            SemanticProperties.Description="Add attachment"
                            IsVisible="{TemplateBinding AllowAttachments}" />

                    <Entry x:Name="PART_InputEntry"
                           Grid.Row="2"
                           Grid.Column="1"
                           Style="{DynamicResource MauiChat.InputEntry}"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           Placeholder="{TemplateBinding Placeholder}"
                           AutomationId="ChatInput"
                           SemanticProperties.Description="Message text" />

                    <Button x:Name="PART_SendButton"
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{DynamicResource MauiChat.SendButton}"
                            Text="{TemplateBinding SendButtonText}"
                            AutomationId="ChatSendButton"
                            SemanticProperties.Description="Send message"
                            IsEnabled="{TemplateBinding CanSend}" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
