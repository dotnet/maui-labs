<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Microsoft.Maui.AI.Chat.Controls.MarkdownTheme"
                    x:ClassModifier="internal">

    <!--
        Markdown-specific styles, merged into AIChatTheme (see AIChatTheme.xaml) and listed as the
        AIChat.Markdown.* keys in AIChatThemeKeys. They have no palette of their own: colors and fonts
        come from the AIChat.Color.* and AIChat.FontFamily.* keys, so overriding one of those (or
        switching to dark mode) restyles Markdown with everything else. Font sizes come from
        AIChat.FontSize.Body (headings scale from it), AIChat.FontSize.Code and AIChat.FontSize.Small.

        Markdown also uses the general chat styles: AIChat.Style.AssistantText for paragraphs and list
        text, AIChat.Style.LinkSpan for links, and AIChat.Style.CodeBlock and AIChat.Style.CodeText for
        fenced code, so code looks the same in answers and in tool cards.
    -->

    <x:Double x:Key="AIChat.Markdown.BlockSpacing">10</x:Double>

    <Style x:Key="AIChat.Markdown.HeadingStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AIChat.Markdown.InlineCodeStyle" TargetType="Span">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.Text}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AIChat.Color.CodeBackground}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily.Code}" />
    </Style>

    <Style x:Key="AIChat.Markdown.CodeBlockLanguageStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.SecondaryText}" />
        <Setter Property="FontSize" Value="{DynamicResource AIChat.FontSize.Small}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="AIChat.Markdown.BlockQuoteBarStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource AIChat.Color.Stroke}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="WidthRequest" Value="3" />
    </Style>

    <Style x:Key="AIChat.Markdown.BlockQuoteTextStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.SecondaryText}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AIChat.Markdown.ListMarkerStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.SecondaryText}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
    </Style>

    <Style x:Key="AIChat.Markdown.TableBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource AIChat.Color.Stroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="8" StrokeThickness="1" />
        </Setter>
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AIChat.Markdown.TableLineStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource AIChat.Color.Stroke}" />
    </Style>

    <Style x:Key="AIChat.Markdown.TableHeaderCellStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.Text}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AIChat.Color.Surface}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AIChat.Markdown.TableCellStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AIChat.Color.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource AIChat.FontFamily}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AIChat.Markdown.ThematicBreakStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource AIChat.Color.Stroke}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

</ResourceDictionary>
