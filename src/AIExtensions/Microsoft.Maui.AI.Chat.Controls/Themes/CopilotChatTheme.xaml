<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls"
                    x:Class="Microsoft.Maui.AI.Chat.Controls.Themes.CopilotChatTheme">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: CopilotChatView (the entire chat surface)    -->
    <!-- All named parts (PART_*) are optional — omit any to suppress  -->
    <!-- that section. Replace the whole template to redesign the chat. -->
    <!-- The messages are rendered by a nested MessageListView, styled   -->
    <!-- by MessageListTheme.xaml. Colors come from ChatColors.xaml.     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.CopilotChatViewTemplate">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="0">

            <!-- Row 0: Header (optional) -->
            <ContentView x:Name="PART_Header" Grid.Row="0" IsVisible="False" />

            <!-- Row 1: Welcome + Messages overlay -->
            <Grid Grid.Row="1">
                <!-- Welcome panel (shown when no messages) -->
                <VerticalStackLayout x:Name="PART_WelcomePanel"
                                     IsVisible="False"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="12" Padding="24">
                    <Label x:Name="PART_WelcomeIcon" Text="💬" FontSize="48"
                           HorizontalOptions="Center" />
                    <Label x:Name="PART_WelcomeMessage" FontSize="16"
                           HorizontalTextAlignment="Center"
                           Opacity="0.7" />
                </VerticalStackLayout>

                <!-- Custom empty-state host (shown when EmptyViewTemplate is set) -->
                <ContentView x:Name="PART_EmptyView"
                             IsVisible="False"
                             VerticalOptions="Fill" HorizontalOptions="Fill" />

                <!-- Messages list (a nested MessageListView renders the blocks) -->
                <chat:MessageListView x:Name="PART_MessageList"
                                      AutomationId="ChatMessages"
                                      Margin="12,8,12,0" />
            </Grid>

            <!-- Row 3: Suggestion chips -->
            <FlexLayout x:Name="PART_Suggestions" Grid.Row="3"
                        IsVisible="False"
                        Wrap="Wrap" JustifyContent="Center"
                        Margin="12,4" />

            <!-- Row 4: Footer (optional) -->
            <ContentView x:Name="PART_Footer" Grid.Row="4" IsVisible="False" />

            <!-- Row 5: Input Area -->
            <Border x:Name="PART_InputArea" Grid.Row="5" Margin="12,8,12,12" Padding="6"
                    BackgroundColor="{TemplateBinding EffectiveInputAreaBackgroundColor}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{TemplateBinding InputAreaCornerRadius}" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Entry x:Name="PART_InputEntry"
                           Placeholder="{TemplateBinding Placeholder}"
                           AutomationId="ChatInput"
                           SemanticProperties.Description="Chat message input"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           FontSize="14"
                           BackgroundColor="Transparent" />
                    <Button x:Name="PART_SendButton" Grid.Column="1"
                            Text="{TemplateBinding SendButtonText}"
                            AutomationId="SendMessageButton"
                            SemanticProperties.Description="Send message"
                            BackgroundColor="{TemplateBinding EffectiveSendButtonBackgroundColor}"
                            TextColor="{DynamicResource MauiAIChat.Send.TextColor}"
                            FontSize="16"
                            WidthRequest="42" HeightRequest="42"
                            CornerRadius="12" Padding="0" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="chat:CopilotChatView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.CopilotChatViewTemplate}" />
    </Style>

</ResourceDictionary>
