<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls"
                    x:Class="Microsoft.Maui.AI.Chat.Controls.Themes.MessageListTheme">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Templates and styles for MessageListView and the per-block views -->
    <!-- it renders. Colors come from ChatColors.xaml (merged alongside   -->
    <!-- this dictionary by the root ChatTheme).                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: FunctionInvocationView                        -->
    <!-- Starts as the pending call, then swaps to the result in place. -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.FunctionInvocationTemplate">
        <Grid Padding="0,2">
            <!-- Pending: "Calling <tool>..." -->
            <Border Padding="10,6" HorizontalOptions="Start"
                    IsVisible="{TemplateBinding IsPending}"
                    BackgroundColor="{DynamicResource MauiAIChat.FunctionCall.Background}"
                    StrokeThickness="0" Opacity="0.85">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="⚙️" FontSize="12" VerticalOptions="Center" />
                    <Label Text="{TemplateBinding FunctionName, StringFormat='Calling {0}...'}"
                           FontSize="12" FontAttributes="Italic"
                           TextColor="{DynamicResource MauiAIChat.FunctionCall.TextColor}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Completed: result text -->
            <Border Padding="10,6" HorizontalOptions="Start"
                    IsVisible="{TemplateBinding HasResult}"
                    BackgroundColor="{DynamicResource MauiAIChat.FunctionResult.Background}"
                    StrokeThickness="0" Opacity="0.85">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="✅" FontSize="12" VerticalOptions="Start" />
                    <Label Text="{TemplateBinding ResultText}" FontSize="11"
                           LineBreakMode="WordWrap" MaximumWidthRequest="300"
                           TextColor="{DynamicResource MauiAIChat.FunctionResult.TextColor}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: DefaultMessageView                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.DefaultTemplate">
        <Grid>
            <Label Text="{TemplateBinding DisplayText}" FontSize="13" Padding="4"
                   TextColor="{DynamicResource MauiAIChat.Default.TextColor}" />
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: ToolApprovalView                              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.ToolApprovalTemplate">
        <Border Padding="14,12" Margin="0,6" HorizontalOptions="Fill"
                BackgroundColor="{DynamicResource MauiAIChat.Approval.Background}"
                Stroke="{DynamicResource MauiAIChat.Approval.Border}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid x:Name="PART_Root" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ApprovalStates">
                        <VisualState x:Name="Pending">
                            <VisualState.Setters>
                                <Setter TargetName="ButtonsRow" Property="IsVisible" Value="True" />
                                <Setter TargetName="ResolutionLabel" Property="IsVisible" Value="False" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Resolved">
                            <VisualState.Setters>
                                <Setter TargetName="ButtonsRow" Property="IsVisible" Value="False" />
                                <Setter TargetName="ResolutionLabel" Property="IsVisible" Value="True" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Label Text="⚠️ Approval Required"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Approval.HeaderColor}" />

                <Label Grid.Row="1"
                       Text="{TemplateBinding ToolName}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Default.TextColor}" />

                <ContentPresenter Grid.Row="2" />

                <Grid x:Name="ButtonsRow"
                      Grid.Row="3"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Button x:Name="PART_ApproveButton"
                            Text="Approve"
                            AutomationId="ApproveToolButton"
                            SemanticProperties.Description="Approve tool invocation"
                            Command="{TemplateBinding ApproveCommand}"
                            BackgroundColor="{DynamicResource MauiAIChat.Button.Approve}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40" />
                    <Button x:Name="PART_RejectButton"
                            Grid.Column="1"
                            Text="Reject"
                            AutomationId="RejectToolButton"
                            SemanticProperties.Description="Reject tool invocation"
                            Command="{TemplateBinding RejectCommand}"
                            BackgroundColor="{DynamicResource MauiAIChat.Button.Reject}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40" />
                </Grid>

                <Label x:Name="ResolutionLabel"
                       Grid.Row="3"
                       IsVisible="False"
                       Text="{TemplateBinding ResolutionText}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Approval.HeaderColor}"
                       HorizontalOptions="Center"
                       Padding="8,6" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style x:Key="MauiAIChat.ToolApproval.ArgsStackStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgsRowStyle" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.EmptyArgsLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.Default.TextColor}" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgNameLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.FunctionCall.TextColor}" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgValueLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.Default.TextColor}" />
    </Style>

    <!-- CopilotChatView replaces only the list projection inside the shared neutral shell. -->
    <DataTemplate x:Key="MauiAIChat.MessageListTemplate">
        <chat:MessageListView />
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Implicit Styles — wire ControlTemplate via DynamicResource     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style TargetType="chat:FunctionInvocationView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.FunctionInvocationTemplate}" />
    </Style>

    <Style TargetType="chat:DefaultMessageView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.DefaultTemplate}" />
    </Style>

    <Style TargetType="chat:ToolApprovalView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.ToolApprovalTemplate}" />
    </Style>

</ResourceDictionary>
