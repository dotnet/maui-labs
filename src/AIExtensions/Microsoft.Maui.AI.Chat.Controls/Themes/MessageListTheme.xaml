<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls"
                    x:Class="Microsoft.Maui.AI.Chat.Controls.Themes.MessageListTheme">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Templates and styles for MessageListView and the per-block views -->
    <!-- it renders. Colors come from ChatColors.xaml (merged alongside   -->
    <!-- this dictionary by the root ChatTheme).                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: ChatMessageView (User + Assistant)           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.ChatMessageTemplate">
        <Grid x:Name="PART_Root"
              Padding="0,4"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              SemanticProperties.Description="{TemplateBinding SemanticDescription}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="RoleStates">
                    <VisualState x:Name="User">
                        <VisualState.Setters>
                            <Setter TargetName="AssistantAvatar" Property="IsVisible" Value="False" />
                            <Setter TargetName="MessageContent" Property="VerticalStackLayout.HorizontalOptions"
                                    Value="End" />
                            <Setter TargetName="DisplayNameLabel" Property="Label.HorizontalTextAlignment"
                                    Value="End" />
                            <Setter TargetName="MessageBorder" Property="Border.BackgroundColor"
                                    Value="{DynamicResource MauiAIChat.User.Background}" />
                            <Setter TargetName="MessageBorder" Property="Border.HorizontalOptions"
                                    Value="End" />
                            <Setter TargetName="MessageLabel" Property="Label.TextColor"
                                    Value="{DynamicResource MauiAIChat.User.TextColor}" />
                            <Setter TargetName="TimestampLabel" Property="Label.HorizontalTextAlignment"
                                    Value="End" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Assistant">
                        <VisualState.Setters>
                            <Setter TargetName="UserAvatar" Property="IsVisible" Value="False" />
                            <Setter TargetName="MessageContent" Property="VerticalStackLayout.HorizontalOptions"
                                    Value="Start" />
                            <Setter TargetName="DisplayNameLabel" Property="Label.HorizontalTextAlignment"
                                    Value="Start" />
                            <Setter TargetName="MessageBorder" Property="Border.BackgroundColor"
                                    Value="{DynamicResource MauiAIChat.Assistant.Background}" />
                            <Setter TargetName="MessageBorder" Property="Border.HorizontalOptions"
                                    Value="Start" />
                            <Setter TargetName="MessageLabel" Property="Label.TextColor"
                                    Value="{DynamicResource MauiAIChat.Assistant.TextColor}" />
                            <Setter TargetName="TimestampLabel" Property="Label.HorizontalTextAlignment"
                                    Value="Start" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="AssistantAvatar"
                    Grid.Column="0"
                    IsVisible="{TemplateBinding ShowAvatars}"
                    WidthRequest="{TemplateBinding AvatarSize}"
                    HeightRequest="{TemplateBinding AvatarSize}"
                    Padding="0"
                    VerticalOptions="End"
                    BackgroundColor="{DynamicResource MauiAIChat.Assistant.Background}"
                    StrokeThickness="0"
                    SemanticProperties.Description="{TemplateBinding DisplayName}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="100" />
                </Border.StrokeShape>
                <Label Text="{TemplateBinding AvatarText}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource MauiAIChat.Assistant.TextColor}"
                       FontAttributes="Bold" />
            </Border>

            <VerticalStackLayout x:Name="MessageContent" Grid.Column="1" Spacing="2">
                <Label x:Name="DisplayNameLabel"
                       Text="{TemplateBinding DisplayName}"
                       IsVisible="{TemplateBinding ShowAvatars}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Default.TextColor}"
                       Margin="4,0" />
                <Border x:Name="MessageBorder" Padding="12,10"
                        MaximumWidthRequest="{TemplateBinding MaxBubbleWidth}"
                        HorizontalOptions="Start"
                        BackgroundColor="{DynamicResource MauiAIChat.Assistant.Background}"
                        Stroke="{TemplateBinding BubbleStrokeColor}"
                        StrokeThickness="{TemplateBinding BubbleStrokeThickness}">
                    <Border.StrokeShape>
                        <RoundRectangle x:Name="MessageShape"
                                        CornerRadius="{TemplateBinding BubbleCornerRadii}" />
                    </Border.StrokeShape>
                    <Label x:Name="MessageLabel"
                           Text="{TemplateBinding Text}" FontSize="14"
                           TextColor="{DynamicResource MauiAIChat.Assistant.TextColor}" />
                </Border>
                <Label x:Name="TimestampLabel"
                       Text="{TemplateBinding TimestampText}"
                       IsVisible="{TemplateBinding ShowTimestamp}"
                       FontSize="{DynamicResource MauiAIChat.Timestamp.FontSize}"
                       TextColor="{DynamicResource MauiAIChat.Timestamp.TextColor}"
                       Margin="4,0" />
            </VerticalStackLayout>

            <Border x:Name="UserAvatar"
                    Grid.Column="2"
                    IsVisible="{TemplateBinding ShowAvatars}"
                    WidthRequest="{TemplateBinding AvatarSize}"
                    HeightRequest="{TemplateBinding AvatarSize}"
                    Padding="0"
                    VerticalOptions="End"
                    BackgroundColor="{DynamicResource MauiAIChat.User.Background}"
                    StrokeThickness="0"
                    SemanticProperties.Description="{TemplateBinding DisplayName}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="100" />
                </Border.StrokeShape>
                <Label Text="{TemplateBinding AvatarText}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource MauiAIChat.User.TextColor}"
                       FontAttributes="Bold" />
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: FunctionInvocationView                        -->
    <!-- Starts as the pending call, then swaps to the result in place. -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.FunctionInvocationTemplate">
        <Grid Padding="0,2">
            <!-- Pending: "Calling <tool>..." -->
            <Border Padding="10,6" HorizontalOptions="Start"
                    IsVisible="{TemplateBinding IsPending}"
                    BackgroundColor="{DynamicResource MauiAIChat.FunctionCall.Background}"
                    StrokeThickness="0" Opacity="0.85">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="⚙️" FontSize="12" VerticalOptions="Center" />
                    <Label Text="{TemplateBinding FunctionName, StringFormat='Calling {0}...'}"
                           FontSize="12" FontAttributes="Italic"
                           TextColor="{DynamicResource MauiAIChat.FunctionCall.TextColor}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Completed: result text -->
            <Border Padding="10,6" HorizontalOptions="Start"
                    IsVisible="{TemplateBinding HasResult}"
                    BackgroundColor="{DynamicResource MauiAIChat.FunctionResult.Background}"
                    StrokeThickness="0" Opacity="0.85">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="✅" FontSize="12" VerticalOptions="Start" />
                    <Label Text="{TemplateBinding ResultText}" FontSize="11"
                           LineBreakMode="WordWrap" MaximumWidthRequest="300"
                           TextColor="{DynamicResource MauiAIChat.FunctionResult.TextColor}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: DefaultMessageView                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.DefaultTemplate">
        <Grid>
            <Label Text="{TemplateBinding DisplayText}" FontSize="13" Padding="4"
                   TextColor="{DynamicResource MauiAIChat.Default.TextColor}" />
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: ToolApprovalView                              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.ToolApprovalTemplate">
        <Border Padding="14,12" Margin="0,6" HorizontalOptions="Fill"
                BackgroundColor="{DynamicResource MauiAIChat.Approval.Background}"
                Stroke="{DynamicResource MauiAIChat.Approval.Border}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid x:Name="PART_Root" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ApprovalStates">
                        <VisualState x:Name="Pending">
                            <VisualState.Setters>
                                <Setter TargetName="ButtonsRow" Property="IsVisible" Value="True" />
                                <Setter TargetName="ResolutionLabel" Property="IsVisible" Value="False" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Resolved">
                            <VisualState.Setters>
                                <Setter TargetName="ButtonsRow" Property="IsVisible" Value="False" />
                                <Setter TargetName="ResolutionLabel" Property="IsVisible" Value="True" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Label Text="⚠️ Approval Required"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Approval.HeaderColor}" />

                <Label Grid.Row="1"
                       Text="{TemplateBinding ToolName}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Assistant.TextColor}" />

                <ContentPresenter Grid.Row="2" />

                <Grid x:Name="ButtonsRow"
                      Grid.Row="3"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Button x:Name="PART_ApproveButton"
                            Text="Approve"
                            AutomationId="ApproveToolButton"
                            SemanticProperties.Description="Approve tool invocation"
                            Command="{TemplateBinding ApproveCommand}"
                            BackgroundColor="{DynamicResource MauiAIChat.Button.Approve}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40" />
                    <Button x:Name="PART_RejectButton"
                            Grid.Column="1"
                            Text="Reject"
                            AutomationId="RejectToolButton"
                            SemanticProperties.Description="Reject tool invocation"
                            Command="{TemplateBinding RejectCommand}"
                            BackgroundColor="{DynamicResource MauiAIChat.Button.Reject}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40" />
                </Grid>

                <Label x:Name="ResolutionLabel"
                       Grid.Row="3"
                       IsVisible="False"
                       Text="{TemplateBinding ResolutionText}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource MauiAIChat.Approval.HeaderColor}"
                       HorizontalOptions="Center"
                       Padding="8,6" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style x:Key="MauiAIChat.ToolApproval.ArgsStackStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgsRowStyle" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.EmptyArgsLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.Default.TextColor}" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgNameLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.FunctionCall.TextColor}" />
    </Style>

    <Style x:Key="MauiAIChat.ToolApproval.ArgValueLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MauiAIChat.Assistant.TextColor}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ControlTemplate: MessageListView — just the messages, no chrome  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="MauiAIChat.MessageListViewTemplate">
        <CollectionView x:Name="PART_Messages"
                        AutomationId="ChatMessages"
                        ItemsUpdatingScrollMode="KeepLastItemInView" />
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Implicit Styles — wire ControlTemplate via DynamicResource     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style TargetType="chat:ChatMessageView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.ChatMessageTemplate}" />
    </Style>

    <Style TargetType="chat:FunctionInvocationView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.FunctionInvocationTemplate}" />
    </Style>

    <Style TargetType="chat:DefaultMessageView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.DefaultTemplate}" />
    </Style>

    <Style TargetType="chat:ToolApprovalView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.ToolApprovalTemplate}" />
    </Style>

    <Style TargetType="chat:MessageListView">
        <Setter Property="ControlTemplate" Value="{DynamicResource MauiAIChat.MessageListViewTemplate}" />
    </Style>

</ResourceDictionary>
