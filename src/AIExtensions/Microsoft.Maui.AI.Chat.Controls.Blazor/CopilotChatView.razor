@namespace Microsoft.Maui.AI.Chat.Controls.Blazor
@implements IDisposable

<CascadingValue Value="EffectivePresentation" IsFixed="true">
<Microsoft.Maui.Chat.Controls.Blazor.ChatView Conversation="@EffectivePresentation"
                                                  @attributes="AdditionalAttributes">
    <MessageContentRenderer TContent="AgentTextMessageContent">
        <ChildContent Context="content"><AgentContentView Content="content" /></ChildContent>
    </MessageContentRenderer>
    <MessageContentRenderer TContent="AgentStructuredTextMessageContent">
        <ChildContent Context="content"><AgentContentView Content="content" /></ChildContent>
    </MessageContentRenderer>
    <MessageContentRenderer TContent="AgentMediaMessageContent">
        <ChildContent Context="content"><AgentContentView Content="content" /></ChildContent>
    </MessageContentRenderer>
    <MessageContentRenderer TContent="AgentBlockContent">
        <ChildContent Context="content"><AgentContentView Content="content" /></ChildContent>
    </MessageContentRenderer>
    @ChildContent
</Microsoft.Maui.Chat.Controls.Blazor.ChatView>
</CascadingValue>

@code {
    private AgentChatPresentation? _ownedPresentation;

    /// <summary>Gets or sets the shared presentation to render. It is never disposed by this component.</summary>
    [Parameter]
    public AgentChatPresentation? Presentation { get; set; }

    /// <summary>Gets or sets the session from which an internally owned presentation is created.</summary>
    [Parameter]
    public AgentContext? Session { get; set; }

    /// <summary>Gets or sets caller renderer registrations appended after the built-in registrations.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets attributes forwarded to the neutral chat view.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Gets the active presentation.</summary>
    public AgentChatPresentation? EffectivePresentation => Presentation ?? _ownedPresentation;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Presentation is not null)
        {
            DisposeOwnedPresentation();
            return;
        }

        if (Session is null)
        {
            DisposeOwnedPresentation();
            return;
        }

        if (!ReferenceEquals(_ownedPresentation?.Session, Session))
        {
            DisposeOwnedPresentation();
            _ownedPresentation = new AgentChatPresentation(Session);
        }
    }

    /// <inheritdoc />
    public void Dispose() => DisposeOwnedPresentation();

    private void DisposeOwnedPresentation()
    {
        _ownedPresentation?.Dispose();
        _ownedPresentation = null;
    }
}
