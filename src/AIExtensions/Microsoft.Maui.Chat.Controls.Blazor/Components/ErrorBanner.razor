    User-safe error banner. Shows the composer or send error string when one is present.
    Intentionally does NOT expose a retry contract: the neutral layer preserves the draft
    on failure so the ordinary Submit path re-tries; layer 2 (AI bridge) owns AgentContext
    retry UI on top of this shell.
*@
@namespace Microsoft.Maui.Chat.Controls.Blazor
@using Microsoft.Maui.Chat.Controls

@if (!string.IsNullOrEmpty(Message))
{
    <div class="mchat-error" role="alert">
        <span class="mchat-error__message">@Message</span>
    </div>
}

@code {
    /// <summary>Gets or sets the user-safe error message. When empty, nothing renders.</summary>
    [Parameter]
    public string? Message { get; set; }
}
