@*
    Licensed to the .NET Foundation under one or more agreements.
    The .NET Foundation licenses this file to you under the MIT license.

    The provider-neutral MAUI Blazor Hybrid chat shell. Header + body + footer inside a
    ChatViewContext cascade. Owns the composer state machine, subscribes to the
    conversation for status changes, and wires the leading/trailing action fragments to
    the ambient IChatComposerContext so layer 2 (AI bridge) can slot AI-specific actions
    in without touching the shell.

    Layout adapted from Microsoft.AspNetCore.Components.AI.ChatPage at commit
    31b20463068f8d9ad900393bf96c9a182c397216 (MIT). See Components/UPSTREAM-NOTES.md.
*@
@namespace Microsoft.Maui.Chat.Controls.Blazor
@using Microsoft.Maui.Chat.Controls
@implements IDisposable

<div @attributes="AdditionalAttributes" class="@RootClass" data-theme="@ThemeAttribute">
    @* Key the cascade on the context so a conversation swap forces every descendant
       (including MessageContentRenderer<T> registrations) to be recreated against the
       new ChatViewContext instead of clinging to the old one via IsFixed=true. *@
    <CascadingValue @key="_context" Value="_context" IsFixed="true">
        <div class="mchat-chat-page__header">
            @if (Header is not null)
            {
                @Header
            }
        </div>

        <div class="mchat-chat-page__body">
            <ChatMessagesView ChildContent="ChildContent"
                              EmptyContent="EffectiveEmptyContent"
                              AutoScrollToLatest="AutoScrollToLatest" />
        </div>

        <div class="mchat-chat-page__footer">
            <div class="mchat-chat-page__composer-container">
                @if (Footer is not null)
                {
                    @Footer
                }

                <Composer @ref="_composer_ref"
                          Context="_composer"
                          AllowAttachments="AllowAttachments"
                          AllowAudioCapture="AllowAudioCapture"
                          AllowLiveSpeech="AllowLiveSpeech"
                          Placeholder="@Placeholder"
                          LeadingActions="InputLeadingActions"
                          TrailingActions="InputTrailingActions"
                          AttachmentTemplate="Attachment" />
            </div>
        </div>
    </CascadingValue>
</div>

@code {
    private ChatComposerContext _composer = default!;
    private ChatViewContext _context = default!;
    private Composer? _composer_ref;
    private ChatConversation? _observed;
    private IDisposable? _subscription;
    private CancellationTokenSource? _sendCts;
    private CancellationTokenSource? _pickCts;
    private CancellationTokenSource? _audioCts;
    private IChatAudioRecorder? _activeRecorder;
    private IChatSpeechRecognizer? _activeRecognizer;

    // Operation-generation token. Bumped whenever the bound conversation changes so any
    // in-flight send/pick/audio/speech operation that captured the old value fails its
    // identity guard when the await unblocks. Every post-await write to _composer.* is
    // gated on StillValid(gen, capturedConversation) so a stale completion cannot leak
    // into the new conversation's composer state.
    private int _operationGeneration;

    /// <summary>Gets or sets the conversation this view renders and sends to.</summary>
    [Parameter, EditorRequired]
    public ChatConversation Conversation { get; set; } = default!;

    /// <summary>Gets or sets content rendered above the message list.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets content rendered below the message list and above the composer.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>Gets or sets content rendered inside the empty state, replacing the built-in welcome panel.</summary>
    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>Gets or sets the welcome message shown by the default empty-state panel.</summary>
    [Parameter]
    public string? WelcomeMessage { get; set; } = "Start the conversation";

    /// <summary>Gets or sets the icon glyph shown by the default empty-state panel.</summary>
    [Parameter]
    public string? WelcomeIcon { get; set; } = "💬";

    /// <summary>Gets or sets the composer placeholder.</summary>
    [Parameter]
    public string Placeholder { get; set; } = "Type a message";

    /// <summary>Gets or sets rich suggestions rendered as chips while the conversation is empty.</summary>
    [Parameter]
    public IReadOnlyList<ChatSuggestion>? Suggestions { get; set; }

    /// <summary>Gets or sets plain-string suggestions, a shorthand for <see cref="Suggestions"/>.</summary>
    [Parameter]
    public IReadOnlyList<string>? SuggestionPrompts { get; set; }

    /// <summary>Gets or sets an optional per-suggestion template.</summary>
    [Parameter]
    public RenderFragment<ChatSuggestion>? SuggestionTemplate { get; set; }

    /// <summary>Gets or sets the per-attachment chip template.</summary>
    [Parameter]
    public RenderFragment<ChatAttachment>? Attachment { get; set; }

    /// <summary>Gets or sets any child content that should live inside the ChatViewContext cascade.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets whether the attach button is available.</summary>
    [Parameter]
    public bool AllowAttachments { get; set; }

    /// <summary>Gets or sets whether the audio-capture button is available.</summary>
    [Parameter]
    public bool AllowAudioCapture { get; set; }

    /// <summary>Gets or sets whether the live-speech button is available.</summary>
    [Parameter]
    public bool AllowLiveSpeech { get; set; }

    /// <summary>
    /// Gets or sets whether a finalized speech-recognition utterance is auto-submitted through the
    /// ordinary Submit path. Defaults to <see langword="true"/>.
    /// </summary>
    /// <remarks>
    /// When <see langword="false"/> the final text lands in the composer and the recognizer is
    /// detached, leaving the user to review and submit manually. Auto-submit deliberately performs
    /// one send per recognition pass: this is a single-pass model, not a continuous-resume model.
    /// A consumer that wants continuous voice can toggle live speech back on after the send lands.
    /// </remarks>
    [Parameter]
    public bool AutoSubmitLiveSpeech { get; set; } = true;

    /// <summary>Gets or sets whether the message list stays anchored to the bottom while new content arrives.</summary>
    [Parameter]
    public bool AutoScrollToLatest { get; set; } = true;

    /// <summary>Gets or sets the maximum attachment size in bytes. Defaults to 10 MB.</summary>
    [Parameter]
    public long MaxAttachmentBytes { get; set; } = 10L * 1024 * 1024;

    /// <summary>Gets or sets the maximum number of staged attachments. Defaults to 10.</summary>
    [Parameter]
    public int MaxAttachmentCount { get; set; } = 10;

    /// <summary>Gets or sets the maximum total size across all staged attachments in bytes. Defaults to 50 MB.</summary>
    [Parameter]
    public long MaxTotalAttachmentBytes { get; set; } = 50L * 1024 * 1024;

    /// <summary>Gets or sets an optional theme override. When <see langword="null"/>, the CSS respects <c>prefers-color-scheme</c>.</summary>
    [Parameter]
    public ChatViewTheme? Theme { get; set; }

    /// <summary>Gets or sets the fragment rendered before the composer textarea. Bound to the composer context.</summary>
    [Parameter]
    public RenderFragment<IChatComposerContext>? InputLeadingActions { get; set; }

    /// <summary>Gets or sets the fragment rendered after the composer textarea. Replaces the default send button when set.</summary>
    [Parameter]
    public RenderFragment<IChatComposerContext>? InputTrailingActions { get; set; }

    /// <summary>Gets or sets any unmatched attributes applied to the shell root.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    /// <summary>Gets the composer context, which layer 2 or custom composers bind to.</summary>
    public IChatComposerContext ComposerContext => _composer;

    private string RootClass
    {
        get
        {
            var custom = AdditionalAttributes is not null
                && AdditionalAttributes.TryGetValue("class", out var raw)
                && raw is string s
                    ? " " + s
                    : string.Empty;
            return "mchat-root mchat-chat-page" + custom;
        }
    }

    private string? ThemeAttribute => Theme switch
    {
        ChatViewTheme.Light => "light",
        ChatViewTheme.Dark => "dark",
        _ => null,
    };

    private RenderFragment? EffectiveEmptyContent =>
        EmptyContent ?? BuildDefaultEmptyContent();

    private RenderFragment BuildDefaultEmptyContent() => builder =>
    {
        builder.OpenComponent<WelcomePanel>(0);
        builder.AddComponentParameter(1, nameof(WelcomePanel.Icon), WelcomeIcon);
        builder.AddComponentParameter(2, nameof(WelcomePanel.Message), WelcomeMessage);
        builder.AddComponentParameter(3, nameof(WelcomePanel.Suggestions), (IReadOnlyList<ChatSuggestion>)ResolveSuggestions());
        if (SuggestionTemplate is not null)
        {
            builder.AddComponentParameter(4, nameof(WelcomePanel.SuggestionTemplate), SuggestionTemplate);
        }

        builder.AddComponentParameter(5, nameof(WelcomePanel.OnSuggestionPicked),
            EventCallback.Factory.Create<ChatSuggestion>(this, OnSuggestionPicked));
        builder.CloseComponent();
    };

    private IReadOnlyList<ChatSuggestion> ResolveSuggestions()
    {
        var rich = Suggestions;
        var text = SuggestionPrompts;

        if ((rich is null || rich.Count == 0) && (text is null || text.Count == 0))
        {
            return Array.Empty<ChatSuggestion>();
        }

        var combined = new List<ChatSuggestion>((rich?.Count ?? 0) + (text?.Count ?? 0));
        if (rich is not null)
        {
            foreach (var suggestion in rich)
            {
                if (suggestion is not null)
                {
                    combined.Add(suggestion);
                }
            }
        }

        if (text is not null)
        {
            foreach (var prompt in text)
            {
                if (!string.IsNullOrWhiteSpace(prompt))
                {
                    combined.Add(new ChatSuggestion(prompt));
                }
            }
        }

        return combined;
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _composer = new ChatComposerContext();
        _composer.AttachActions(
            onSubmit: () => SendAsync(),
            onStop: () => StopAsync(),
            onPickAttachments: () => PickAttachmentsAsync(),
            onToggleAudioCapture: ToggleAudioCaptureAsync,
            onToggleLiveSpeech: ToggleLiveSpeechAsync);

        _composer.AllowAttachments = AllowAttachments;
        _composer.AllowAudioCapture = AllowAudioCapture;
        _composer.AllowLiveSpeech = AllowLiveSpeech;

        _context = new ChatViewContext(Conversation, _composer);
        _composer.AttachConversation(Conversation);

        AttachConversation(Conversation);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _composer.AllowAttachments = AllowAttachments;
        _composer.AllowAudioCapture = AllowAudioCapture;
        _composer.AllowLiveSpeech = AllowLiveSpeech;

        if (!ReferenceEquals(_observed, Conversation))
        {
            AttachConversation(Conversation);
            _composer.AttachConversation(Conversation);
            _context = new ChatViewContext(Conversation, _composer);
        }
    }

    private void AttachConversation(ChatConversation? conversation)
    {
        // Bump the operation generation FIRST so any in-flight async that reads
        // _operationGeneration after AttachConversation fails its identity check even in the
        // narrow window between the field bump and the CTS cancel. Guards run inside the
        // async continuation which is single-thread-affine on the renderer's sync context.
        _operationGeneration++;

        // Cancel in-flight ops so their awaits unblock; their catches surface user-safe
        // strings or silently swallow cancellation. Each async method also gates every
        // post-await write on StillValid so any race between "we cancelled" and "await
        // completed with a non-cancelled result" cannot bleed into the new conversation.
        CancelInFlightOperations();
        DetachActiveRecognizer(swallowStopExceptions: true);

        // Reset transient composer state that was tied to the previous conversation. The user's
        // draft text and staged attachments are preserved because those are user data - the
        // shell only owns the send/record/status/error indicators, and leaving them behind
        // would advertise a "Sending message." or "Failed" state that belongs to the old
        // conversation on the new one.
        if (_composer is not null)
        {
            _composer.SetIsSending(false);
            _composer.SetIsRecordingAudio(false);
            _composer.SetIsTranscribingAudio(false);
            _composer.SetIsLiveSpeechEnabled(false);
            _composer.SetIsListening(false);
            _composer.SetStatusMessage(null);
            _composer.SetErrorMessage(null);
        }

        _subscription?.Dispose();
        _subscription = null;
        _observed = conversation;

        if (conversation is not null)
        {
            _subscription = conversation.Subscribe(OnConversationChange);
        }
    }

    private void CancelInFlightOperations()
    {
        CancelAndDispose(ref _sendCts);
        CancelAndDispose(ref _pickCts);
        CancelAndDispose(ref _audioCts);

        // If a recording was in progress the recorder's own StartAsync/StopAsync do not
        // observe our tokens; fire CancelAsync on the tracked recorder so any pending
        // buffer read unblocks. We do not await because the caller (AttachConversation)
        // is synchronous; failures here are swallowed.
        var recorder = _activeRecorder;
        _activeRecorder = null;
        if (recorder is not null && recorder.IsRecording)
        {
            _ = recorder.CancelAsync();
        }
    }

    private static void CancelAndDispose(ref CancellationTokenSource? cts)
    {
        var current = cts;
        cts = null;
        if (current is null)
        {
            return;
        }

        try
        {
            current.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        current.Dispose();
    }

    private bool StillValid(int operationGeneration, ChatConversation? capturedConversation) =>
        operationGeneration == _operationGeneration
        && ReferenceEquals(capturedConversation, Conversation);

    private void OnConversationChange(ChatConversationChange change)
    {
        if (change.Kind is ChatConversationChangeKind.StatusChanged
            or ChatConversationChangeKind.Reset)
        {
            _composer.NotifyChanged();
        }
    }

    private Task OnSuggestionPicked(ChatSuggestion suggestion)
    {
        _composer.Text = suggestion.Prompt;
        return SendAsync();
    }

    /// <summary>Focuses the composer textarea.</summary>
    public Task FocusAsync() =>
        _composer_ref is null ? Task.CompletedTask : _composer_ref.FocusAsync();

    /// <summary>Creates the draft the composer would send right now.</summary>
    /// <returns>The trimmed, staged draft.</returns>
    public ChatDraft CreateDraft() => _composer.CreateDraft();

    /// <summary>Sends the current draft. Never throws; failures land in the composer error message.</summary>
    /// <param name="cancellationToken">Cancels the send.</param>
    public async Task SendAsync(CancellationToken cancellationToken = default)
    {
        var conversation = Conversation;
        if (conversation is null)
        {
            return;
        }

        if (!_composer.CanSubmit)
        {
            return;
        }

        var draft = _composer.CreateDraft();
        if (!conversation.CanSend(draft))
        {
            return;
        }

        var linked = cancellationToken.CanBeCanceled
            ? CancellationTokenSource.CreateLinkedTokenSource(cancellationToken)
            : new CancellationTokenSource();

        // Capture the generation and conversation identity BEFORE the first observable
        // state change so a swap that races the send cannot make the "start" side of the
        // operation appear to belong to the new conversation.
        var gen = _operationGeneration;
        var startConversation = conversation;
        _sendCts = linked;
        _composer.SetIsSending(true);
        _composer.SetErrorMessage(null);
        _composer.SetStatusMessage("Sending message.");

        try
        {
            var accepted = await conversation.SendAsync(draft, linked.Token).ConfigureAwait(true);

            // Identity guard: if the conversation changed underneath us, the accepted flag
            // refers to a send that targeted a different conversation. Do NOT mutate the
            // new conversation's composer.
            if (!StillValid(gen, startConversation))
            {
                return;
            }

            if (accepted)
            {
                _composer.ClearAcceptedDraft(draft);
                _composer.SetStatusMessage("Message sent.");
            }
            else
            {
                _composer.SetStatusMessage(null);
            }
        }
        catch (OperationCanceledException)
        {
            if (StillValid(gen, startConversation))
            {
                _composer.SetStatusMessage(null);
            }
        }
        catch (Exception)
        {
            if (StillValid(gen, startConversation))
            {
                _composer.SetErrorMessage(ChatComposerContext.DefaultSendErrorMessage);
                _composer.SetStatusMessage(null);
            }
        }
        finally
        {
            // Only clear the shared field if it still points at OUR CTS. A swap already
            // reset _sendCts to null; a new send may have replaced it. Either way we
            // dispose our own CTS and only touch IsSending when identity still holds.
            if (ReferenceEquals(_sendCts, linked))
            {
                _sendCts = null;
            }

            if (StillValid(gen, startConversation))
            {
                _composer.SetIsSending(false);
            }

            linked.Dispose();
        }
    }

    /// <summary>Cancels the active send or streaming response.</summary>
    /// <param name="cancellationToken">Cancels the cancellation request itself.</param>
    public async Task StopAsync(CancellationToken cancellationToken = default)
    {
        var conversation = Conversation;
        var cts = _sendCts;
        if (cts is not null && !cts.IsCancellationRequested)
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException)
            {
            }
        }

        if (conversation?.CanCancel == true)
        {
            var gen = _operationGeneration;
            try
            {
                await conversation.CancelAsync(cancellationToken).ConfigureAwait(true);
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception)
            {
                if (StillValid(gen, conversation))
                {
                    _composer.SetErrorMessage(ChatComposerContext.DefaultSendErrorMessage);
                }
            }
        }
    }

    /// <summary>Opens the injected attachment picker and stages the picked files.</summary>
    /// <param name="cancellationToken">Cancels the pick.</param>
    public async Task PickAttachmentsAsync(CancellationToken cancellationToken = default)
    {
        var conversation = Conversation;
        var picker = Services.GetService(typeof(IChatAttachmentPicker)) as IChatAttachmentPicker;
        if (picker is null)
        {
            _composer.SetErrorMessage(ChatComposerContext.DefaultAttachmentErrorMessage);
            return;
        }

        var previous = _pickCts;
        _pickCts = null;
        previous?.Cancel();
        previous?.Dispose();

        var linked = cancellationToken.CanBeCanceled
            ? CancellationTokenSource.CreateLinkedTokenSource(cancellationToken)
            : new CancellationTokenSource();
        _pickCts = linked;

        var gen = _operationGeneration;
        _composer.SetErrorMessage(null);
        _composer.SetComposing(true);

        try
        {
            var picked = await picker.PickAsync(null, MaxAttachmentBytes, linked.Token).ConfigureAwait(true);

            if (!StillValid(gen, conversation))
            {
                // A conversation swap happened while the picker was open. Discard the pick;
                // staging attachments into the new conversation would leak the wrong intent.
                return;
            }

            if (picked is null || picked.Count == 0)
            {
                return;
            }

            if (_composer.Attachments.Count + picked.Count > MaxAttachmentCount)
            {
                _composer.SetErrorMessage($"Attach no more than {MaxAttachmentCount} files.");
                return;
            }

            var totalBytes = 0L;
            foreach (var attachment in _composer.Attachments)
            {
                totalBytes += attachment.ByteCount;
            }

            foreach (var attachment in picked)
            {
                if (attachment is not null)
                {
                    totalBytes += attachment.ByteCount;
                }
            }

            if (totalBytes > MaxTotalAttachmentBytes)
            {
                _composer.SetErrorMessage(
                    $"Attachments must be smaller than {MaxTotalAttachmentBytes / (1024 * 1024)} MB in total.");
                return;
            }

            foreach (var attachment in picked)
            {
                if (attachment is not null)
                {
                    // Re-check identity between iterations; the collection is small so
                    // the extra cost is negligible and it guarantees a swap during Add
                    // does not stage into the new conversation.
                    if (!StillValid(gen, conversation))
                    {
                        return;
                    }

                    await _composer.AddAttachmentAsync(attachment).ConfigureAwait(true);
                }
            }

            if (StillValid(gen, conversation))
            {
                _composer.SetStatusMessage(
                    picked.Count == 1 ? "1 file attached." : $"{picked.Count} files attached.");
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            if (StillValid(gen, conversation))
            {
                _composer.SetErrorMessage(ChatComposerContext.DefaultAttachmentErrorMessage);
            }
        }
        finally
        {
            if (ReferenceEquals(_pickCts, linked))
            {
                _pickCts = null;
            }

            if (StillValid(gen, conversation))
            {
                _composer.SetComposing(false);
            }

            linked.Dispose();
        }
    }

    /// <summary>
    /// Toggles audio capture using the injected <see cref="IChatAudioRecorder"/>. Guarded against
    /// conversation swap so an in-flight recording that finishes after the swap cannot stage its
    /// attachment into the new conversation.
    /// </summary>
    public async Task ToggleAudioCaptureAsync()
    {
        var conversation = Conversation;
        var recorder = Services.GetService(typeof(IChatAudioRecorder)) as IChatAudioRecorder;
        if (recorder is null || !recorder.IsSupported)
        {
            _composer.SetErrorMessage("Microphone is not available.");
            return;
        }

        var gen = _operationGeneration;

        try
        {
            if (_composer.IsRecordingAudio)
            {
                _composer.SetIsRecordingAudio(false);
                var recording = await recorder.StopAsync(50L * 1024 * 1024).ConfigureAwait(true);

                if (!StillValid(gen, conversation))
                {
                    return;
                }

                if (recording is not null)
                {
                    await _composer.AddAttachmentAsync(recording).ConfigureAwait(true);
                }

                if (ReferenceEquals(_activeRecorder, recorder))
                {
                    _activeRecorder = null;
                }
            }
            else
            {
                await recorder.StartAsync().ConfigureAwait(true);

                if (!StillValid(gen, conversation))
                {
                    // Swap happened while StartAsync was running; discard the recording
                    // rather than parading a "recording" state on the new conversation.
                    _ = recorder.CancelAsync();
                    return;
                }

                _activeRecorder = recorder;
                _composer.SetIsRecordingAudio(true);
            }
        }
        catch (Exception)
        {
            if (StillValid(gen, conversation))
            {
                _composer.SetIsRecordingAudio(false);
                _composer.SetErrorMessage("The audio recording could not be completed.");
            }
        }
    }

    /// <summary>
    /// Toggles continuous live speech using the injected <see cref="IChatSpeechRecognizer"/>. The
    /// active recognizer and an epoch are tracked so we unsubscribe on every terminal path
    /// (toggle-off, error, conversation swap, dispose) instead of leaking a subscription into a
    /// singleton recognizer that then keeps the ChatView alive and mutable.
    /// </summary>
    public async Task ToggleLiveSpeechAsync()
    {
        var conversation = Conversation;
        var recognizer = Services.GetService(typeof(IChatSpeechRecognizer)) as IChatSpeechRecognizer;
        if (recognizer is null || !recognizer.IsSupported)
        {
            _composer.SetErrorMessage("Speech recognition is not available.");
            return;
        }

        var gen = _operationGeneration;

        try
        {
            if (_composer.IsLiveSpeechEnabled)
            {
                DetachActiveRecognizer(swallowStopExceptions: true);
                if (StillValid(gen, conversation))
                {
                    _composer.SetIsLiveSpeechEnabled(false);
                    _composer.SetIsListening(false);
                }

                await recognizer.StopAsync().ConfigureAwait(true);
                return;
            }

            var granted = await recognizer.RequestPermissionsAsync().ConfigureAwait(true);
            if (!StillValid(gen, conversation))
            {
                if (granted)
                {
                    // Ensure we do not leave the recognizer running on the swap's tail.
                    _ = recognizer.StopAsync();
                }

                return;
            }

            if (!granted)
            {
                _composer.SetErrorMessage("Speech recognition permission was denied.");
                return;
            }

            // Detach any prior recognizer identity FIRST so a stale event from a previous
            // pass does not race the new subscription.
            DetachActiveRecognizer(swallowStopExceptions: true);
            _activeRecognizer = recognizer;
            recognizer.RecognitionChanged += OnRecognition;

            await recognizer.StartAsync(
                System.Globalization.CultureInfo.CurrentCulture,
                reportPartialResults: true).ConfigureAwait(true);

            if (!StillValid(gen, conversation))
            {
                // Swap during StartAsync: unwind cleanly.
                DetachActiveRecognizer(swallowStopExceptions: true);
                return;
            }

            _composer.SetIsLiveSpeechEnabled(true);
            _composer.SetIsListening(true);
        }
        catch (Exception)
        {
            DetachActiveRecognizer(swallowStopExceptions: true);
            if (StillValid(gen, conversation))
            {
                _composer.SetIsLiveSpeechEnabled(false);
                _composer.SetIsListening(false);
                _composer.SetErrorMessage("Live voice could not continue.");
            }
        }
    }

    private void DetachActiveRecognizer(bool swallowStopExceptions)
    {
        var recognizer = _activeRecognizer;
        _activeRecognizer = null;
        if (recognizer is null)
        {
            return;
        }

        try
        {
            recognizer.RecognitionChanged -= OnRecognition;
        }
        catch (Exception) when (swallowStopExceptions)
        {
            // Ignore: unsubscribe failure on a disposed recognizer is not actionable here.
        }

        // Fire-and-forget StopAsync to avoid holding the sync path (AttachConversation
        // and Dispose call this synchronously). Any recognizer that surfaces recognition
        // events after we detached is dropped by OnRecognition's identity guard.
        try
        {
            _ = recognizer.StopAsync();
        }
        catch (Exception) when (swallowStopExceptions)
        {
        }
    }

    private async void OnRecognition(object? sender, ChatSpeechRecognitionEventArgs e)
    {
        // Identity guard: only the *current* recognizer's events are honoured. A recognizer
        // singleton that fires a stale event after we detached (or after a conversation swap
        // installed a new pass) is silently dropped.
        if (!ReferenceEquals(sender, _activeRecognizer))
        {
            return;
        }

        var conversation = Conversation;
        var gen = _operationGeneration;

        // The one-pass model treats any of the following as terminal for the current pass:
        //   * e.IsFinal (the recognizer explicitly ended the pass)
        //   * Fatal / PermissionDenied / LanguageNotSupported (unrecoverable regardless of
        //     whether the platform bothered to set IsFinal)
        // Non-terminal events are either interim success (stream text) or interim
        // non-fatal errors (drop; the recognizer keeps listening for the next chunk).
        var isTerminal = e.IsFinal
            || e.ErrorKind is ChatSpeechRecognitionErrorKind.PermissionDenied
                or ChatSpeechRecognitionErrorKind.Fatal
                or ChatSpeechRecognitionErrorKind.LanguageNotSupported;

        if (!isTerminal)
        {
            if (e.ErrorKind == ChatSpeechRecognitionErrorKind.None && StillValid(gen, conversation))
            {
                _composer.Text = e.Text;
            }

            return;
        }

        // === TERMINAL PATH — TEAR DOWN THE PASS EXACTLY ONCE ===
        //
        // Detach the recognizer FIRST so it stops holding this ChatView, then clear the
        // IsListening/IsLiveSpeechEnabled composer flags. Together these collapse
        // IsComposing so the ordinary Submit path can accept the auto-submit (for a
        // successful final) or so the user can compose+submit manually (for any error kind).
        // Guarded on identity to avoid mutating a new conversation's composer if a swap
        // happened underneath us. Stale/duplicate finals from the same recognizer are
        // dropped by the ReferenceEquals(sender, _activeRecognizer) check at the top.
        DetachActiveRecognizer(swallowStopExceptions: true);
        if (!StillValid(gen, conversation))
        {
            return;
        }

        _composer.SetIsLiveSpeechEnabled(false);
        _composer.SetIsListening(false);

        switch (e.ErrorKind)
        {
            case ChatSpeechRecognitionErrorKind.None:
                // Successful final. Preserve the recognized text so either AutoSubmit sends
                // it, or the user reviews it manually when AutoSubmit is off. An empty final
                // (recognizer decided the pass ended with no text) is left as-is: the
                // composer's CanSubmit gate will reject it, so no accidental empty send.
                _composer.Text = e.Text;
                if (AutoSubmitLiveSpeech
                    && !string.IsNullOrWhiteSpace(e.Text)
                    && StillValid(gen, conversation))
                {
                    await SendAsync().ConfigureAwait(true);
                }

                break;

            case ChatSpeechRecognitionErrorKind.NoSpeech:
            case ChatSpeechRecognitionErrorKind.Aborted:
                // Recoverable: silence timeout or user-initiated abort. Neither is a real
                // failure worth surfacing; the recognizer is detached and the composer is
                // usable, which is exactly what a next-time-lucky retry needs.
                break;

            case ChatSpeechRecognitionErrorKind.Transient:
                // Transient recoverable interruption (e.g. network flake). Show a
                // user-safe status so the user knows why the pass ended, but do not stay
                // listening and do not raise an error banner - the user can toggle live
                // speech back on to try again.
                _composer.SetStatusMessage("Live voice was interrupted.");
                break;

            case ChatSpeechRecognitionErrorKind.PermissionDenied:
            case ChatSpeechRecognitionErrorKind.Fatal:
            case ChatSpeechRecognitionErrorKind.LanguageNotSupported:
                _composer.SetErrorMessage("Live voice could not continue.");
                break;
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        // Cancel every in-flight op and unhook the recognizer so nothing outside this
        // component keeps mutating our composer after teardown.
        _operationGeneration++;
        CancelInFlightOperations();
        DetachActiveRecognizer(swallowStopExceptions: true);

        _subscription?.Dispose();
        _subscription = null;
    }
}

