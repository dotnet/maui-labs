    Generic user-safe error/retry banner. Bound to the composer context's error message
    string, or explicitly to a send-side error the shell surfaced.
*@
@namespace Microsoft.Maui.Chat.Controls.Blazor
@using Microsoft.Maui.Chat.Controls

@if (!string.IsNullOrEmpty(Message))
{
    <div class="mchat-error" role="alert">
        <span class="mchat-error__message">@Message</span>
        @if (Retry.HasDelegate)
        {
            <button type="button" class="mchat-btn mchat-btn--secondary" @onclick="Retry">
                Retry
            </button>
        }
    </div>
}

@code {
    /// <summary>Gets or sets the user-safe error message. When empty, nothing renders.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Gets or sets an optional retry callback. When set, a Retry button appears.</summary>
    [Parameter]
    public EventCallback Retry { get; set; }
}
