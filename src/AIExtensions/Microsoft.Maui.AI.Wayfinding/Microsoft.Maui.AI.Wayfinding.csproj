<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.AI.Wayfinding</RootNamespace>
    <PackageId>Microsoft.Maui.AI.Wayfinding</PackageId>
    <Description>AI tools and chat middleware for semantic MAUI UI search, current context, and deep navigation.</Description>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <PackageTags>$(PackageTags) ai wayfinding navigation indexer maui</PackageTags>
    <PackRepoRootReadme>false</PackRepoRootReadme>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Maui.AI.Attributes\Microsoft.Maui.AI.Attributes.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.AI.Attributes.Generators\Microsoft.Maui.AI.Attributes.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Microsoft.Maui.AI.Indexer\Microsoft.Maui.AI.Indexer.csproj" />
    <ProjectReference Include="..\Microsoft.Maui.AI.Indexer.Generators\Microsoft.Maui.AI.Indexer.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Microsoft.Maui.AI.Navigation\Microsoft.Maui.AI.Navigation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Microsoft.Maui.AI.Indexer\build\Microsoft.Maui.AI.Indexer.targets"
          Link="build\Microsoft.Maui.AI.Indexer.targets"
          Pack="true"
          PackagePath="build/Microsoft.Maui.AI.Wayfinding.targets" />
    <None Include="..\Microsoft.Maui.AI.Indexer\build\Microsoft.Maui.AI.Indexer.targets"
          Link="buildTransitive\Microsoft.Maui.AI.Indexer.targets"
          Pack="true"
          PackagePath="buildTransitive/Microsoft.Maui.AI.Wayfinding.targets" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);_IncludeWayfindingIndexerGenerator
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_IncludeWayfindingIndexerGenerator"
          DependsOnTargets="ResolveProjectReferences"
          Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)"
                              Condition="'%(Filename)' == 'Microsoft.Maui.AI.Indexer.Generators'">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
