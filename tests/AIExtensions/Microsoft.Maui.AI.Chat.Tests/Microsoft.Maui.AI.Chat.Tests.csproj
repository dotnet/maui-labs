<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.Maui.AI.Chat.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="xunit" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Recording\**\*.cs"
             Link="Recording\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Search\**\*.cs"
             Link="Search\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\**\*.cs"
             Link="Chat\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Models\PlaygroundJsonContext.cs" Link="Models\PlaygroundJsonContext.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Models\PlaygroundResponse.cs" Link="Models\PlaygroundResponse.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\ChatClientDescriptor.cs" Link="Services\ChatClientDescriptor.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\PlaygroundChatClientBuilderExtensions.cs" Link="Services\PlaygroundChatClientBuilderExtensions.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\SettingsPaneViewModel.cs" Link="ViewModels\SettingsPaneViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\ChatLibraryViewModel.cs" Link="ViewModels\ChatLibraryViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_sample.png"
             Link="TestData\playground_sample.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
