<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.Maui.AI.Chat.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="xunit" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\Models\*.cs"
             Link="Chat\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\Recording\*.cs"
             Link="Chat\Recording\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\Services\*.cs"
             Link="Chat\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\ViewModels\SettingsPaneViewModel.cs"
             Link="Chat\ViewModels\SettingsPaneViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Embeddings\Models\*.cs"
             Link="Embeddings\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Embeddings\Services\*.cs"
             Link="Embeddings\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Embeddings\ViewModels\EmbeddingPlaygroundViewModel.cs"
             Link="Embeddings\ViewModels\EmbeddingPlaygroundViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Embeddings\ViewModels\EmbeddingSettingsViewModel.cs"
             Link="Embeddings\ViewModels\EmbeddingSettingsViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Images\Models\*.cs"
             Link="Images\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Images\Services\*.cs"
             Link="Images\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Images\ViewModels\ImageSettingsViewModel.cs"
             Link="Images\ViewModels\ImageSettingsViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Shared\Models\*.cs"
             Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Shared\Storage\*.cs"
             Link="Shared\Storage\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_chat.json"
             Link="TestData\multi-turn-image-in-out.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_sample.png"
             Link="TestData\playground_sample.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
