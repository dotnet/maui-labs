<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.Maui.AI.Chat.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="xunit" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Recording\**\*.cs"
             Link="Recording\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Embeddings\**\*.cs"
             Link="Embeddings\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Images\**\*.cs"
             Link="Images\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Storage\**\*.cs"
             Link="Storage\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Features\Chat\**\*.cs"
             Link="Chat\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Models\PlaygroundJsonContext.cs" Link="Models\PlaygroundJsonContext.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Models\PlaygroundResponse.cs" Link="Models\PlaygroundResponse.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Models\ImageAttachment.cs" Link="Models\ImageAttachment.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\ChatClientDescriptor.cs" Link="Services\ChatClientDescriptor.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\EmbeddingGeneratorDescriptor.cs" Link="Services\EmbeddingGeneratorDescriptor.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\ImageGeneratorDescriptor.cs" Link="Services\ImageGeneratorDescriptor.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\PlaygroundChatClientBuilderExtensions.cs" Link="Services\PlaygroundChatClientBuilderExtensions.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\SettingsPaneViewModel.cs" Link="ViewModels\SettingsPaneViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\EmbeddingPlaygroundViewModel.cs" Link="ViewModels\EmbeddingPlaygroundViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\EmbeddingSettingsViewModel.cs" Link="ViewModels\EmbeddingSettingsViewModel.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\ViewModels\ImageSettingsViewModel.cs" Link="ViewModels\ImageSettingsViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_chat.json"
             Link="TestData\multi-turn-image-in-out.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_sample.png"
             Link="TestData\playground_sample.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
