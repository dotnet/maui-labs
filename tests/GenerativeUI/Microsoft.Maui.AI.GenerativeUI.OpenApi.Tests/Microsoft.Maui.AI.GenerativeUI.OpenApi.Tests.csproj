<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Microsoft.Maui.AI.GenerativeUI.OpenApi.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The library (and thus this test) targets Microsoft.OpenApi 2.0.0 - the version .NET 10's
         ASP.NET ships - rather than the repo's 3.5.0 central pin. See the library csproj. -->
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\GenerativeUI\Microsoft.Maui.AI.GenerativeUI.OpenApi\Microsoft.Maui.AI.GenerativeUI.OpenApi.csproj" />
    <!-- Host the sample server in-memory for the round-trip test (WebApplicationFactory). -->
    <ProjectReference Include="..\..\..\samples\GenerativeUI.Sample.Garden.Server\GenerativeUI.Sample.Garden.Server.csproj" />
  </ItemGroup>

  <!-- The reducer/invoker tests parse the checked-in OpenAPI snapshot shared with the server tests. -->
  <ItemGroup>
    <Content Include="..\snapshots\garden.openapi.json" Link="garden.openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
