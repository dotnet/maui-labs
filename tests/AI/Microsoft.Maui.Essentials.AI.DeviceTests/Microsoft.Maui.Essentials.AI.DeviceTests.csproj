<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseXcode27Preview)' != 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseXcode27Preview)' == 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios27.0;net10.0-maccatalyst27.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(UseXcode27Preview)' == 'true' and $(TargetFramework.Contains('-maccatalyst'))">17.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <SingleProject>true</SingleProject>
    <UseMaui>true</UseMaui>
    <RootNamespace>Microsoft.Maui.Essentials.AI.DeviceTests</RootNamespace>
    <AssemblyName>Microsoft.Maui.Essentials.AI.DeviceTests</AssemblyName>
    <!-- Disable multi-RID builds to workaround a parallel build issue -->
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-maccatalyst'))">maccatalyst-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-maccatalyst')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'arm64'">maccatalyst-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MAUIAI0001;MEAI001;CA1416;XCODE_27_0_PREVIEW</NoWarn>
    <UserSecretsId>808cc184-141a-409e-addd-565c973dbce6</UserSecretsId>
    <!-- Required for DeviceRunners dotnet test integration -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- Live model generation can exceed the runner's default 30-second gap between results. -->
    <DeviceRunnersDataTimeout>180</DeviceRunnersDataTimeout>
  </PropertyGroup>

  <!-- Opt in with -p:EnableOpenAIClient=true or -p:EnableOpenAITests=true. -->
  <PropertyGroup Condition="'$(EnableOpenAIClient)' == 'true' or '$(EnableOpenAITests)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_OPENAI_CLIENT</DefineConstants>
  </PropertyGroup>

  <!-- Image tests are separate from the chat/embedding baseline and require AI:ImageDeploymentName.
       EnableOpenAIImageEditTests also opts into generation tests; use it only with an edit-capable deployment. -->
  <PropertyGroup Condition="'$(EnableOpenAIImageTests)' == 'true' or '$(EnableOpenAIImageEditTests)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_OPENAI_IMAGE_TESTS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableOpenAIImageEditTests)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_OPENAI_IMAGE_EDIT_TESTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationTitle>AI Tests</ApplicationTitle>
    <ApplicationId>com.microsoft.maui.ai.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Prevent MSBuild from overriding MaxVersionTested (required for systemAIModels capability) -->
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
  </PropertyGroup>

  <!-- Windows: self-contained publish to bundle WinAppSDK experimental runtime -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The experimental SDK's generated XAML metadata references experimental chart/table providers. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8305</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.utility" />
    <!-- OSS device test runner -->
    <PackageReference Include="DeviceRunners.UITesting.Maui" />
    <PackageReference Include="DeviceRunners.UITesting.Xunit" />
    <PackageReference Include="DeviceRunners.VisualRunners.Xunit" />
    <PackageReference Include="DeviceRunners.VisualRunners.Maui" />
    <PackageReference Include="DeviceRunners.Testing.Targets" />
  </ItemGroup>

  <!-- Windows AI WinRT APIs -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.WindowsAppSDK" VersionOverride="$(MicrosoftWindowsAppSDKVersion_Experimental)" />
    <!-- Enables dotnet run for packaged MSIX apps (registers loose layout, activates via AUMID) -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\appiconfg.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AI\Microsoft.Maui.Essentials.AI\Microsoft.Maui.Essentials.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the sample's portable request/response path, not a test copy or its MAUI DI registrations. -->
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Images\Services\ImageGenerationService.cs"
             Link="Sample\ImageGenerationService.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Images\Services\GeneratedImage.cs"
             Link="Sample\GeneratedImage.cs" />
    <Compile Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Services\ImageAttachment.cs"
             Link="Sample\ImageAttachment.cs" />
    <EmbeddedResource Include="..\..\..\samples\AIExtensions.Sample.ChatPlayground\Resources\Raw\playground_sample.png"
                      LogicalName="Microsoft.Maui.Essentials.AI.DeviceTests.ImageInput.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableOpenAIClient)' == 'true' or '$(EnableOpenAITests)' == 'true' or '$(EnableOpenAIImageTests)' == 'true' or '$(EnableOpenAIImageEditTests)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <Target Name="AddUserSecrets" BeforeTargets="PrepareForBuild" Condition=" '$(UserSecretsId)' != '' And '$(Configuration)' == 'Debug' ">
    <PropertyGroup>
      <UserSecretsFilePath Condition=" '$(OS)' == 'Windows_NT' ">
        $([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\AppData\Roaming\Microsoft\UserSecrets\$(UserSecretsId)\secrets.json
      </UserSecretsFilePath>
      <UserSecretsFilePath Condition=" '$(OS)' == 'Unix' ">
        $([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.microsoft/usersecrets/$(UserSecretsId)/secrets.json
      </UserSecretsFilePath>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(UserSecretsFilePath)" Condition="Exists($(UserSecretsFilePath))" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveVisualStudioTestRunner" BeforeTargets="_ComputeAppxPackagePayload">
    <ItemGroup>
      <_VisualStudioTestRunnerFiles Include="@(PackagingOutputs)" Condition="$([System.String]::Copy('%(PackagingOutputs.FullPath)').Contains('xunit.runner.visualstudio'))" />
      <PackagingOutputs Remove="@(_VisualStudioTestRunnerFiles)" />
    </ItemGroup>
  </Target>

</Project>
