{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dotnet/maui-labs/main/docs/DevFlow/spec/schemas/maui-xaml-source-proposal-v1.json",
  "title": "MAUI XAML Source Proposal v1",
  "description": "A reviewable proposal to add or replace one static literal AutomationId. It never approves a flow repair or authorizes source writes.",
  "type": "object",
  "required": [
    "schema",
    "proposalId",
    "operation",
    "element",
    "baseContentDigest",
    "patch",
    "patchDigest",
    "eligibility"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "proposed",
        "previewed",
        "stale",
        "rejected"
      ]
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "element": {
      "$ref": "#/$defs/Element"
    },
    "baseContentDigest": {
      "$ref": "#/$defs/Digest"
    },
    "patch": {
      "$ref": "#/$defs/Patch"
    },
    "patchDigest": {
      "$ref": "#/$defs/Digest"
    },
    "diffDigest": {
      "$ref": "#/$defs/Digest"
    },
    "diff": {
      "type": "string"
    },
    "eligibility": {
      "$ref": "#/$defs/Eligibility"
    },
    "uniqueness": {
      "$ref": "#/$defs/Uniqueness"
    },
    "affectedFlows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FlowFollowUp"
      }
    },
    "affectedPlatforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlatformVerification"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "Operation": {
      "type": "object",
      "required": [
        "operationId",
        "kind",
        "fileRelativePath",
        "sourceHash",
        "sourceAnchor",
        "newLiteral",
        "attribute"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "add-literal-automation-id",
            "replace-literal-automation-id"
          ]
        },
        "fileRelativePath": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.xaml$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{16}$"
        },
        "sourceAnchor": {
          "$ref": "#/$defs/Digest"
        },
        "oldLiteral": {
          "type": [
            "string",
            "null"
          ]
        },
        "newLiteral": {
          "type": "string",
          "pattern": "^[A-Za-z](?:[A-Za-z0-9]|[._-](?=[A-Za-z0-9])){0,127}$"
        },
        "attribute": {
          "const": "AutomationId"
        }
      },
      "additionalProperties": true
    },
    "Element": {
      "type": "object",
      "properties": {
        "elementType": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "sourceAnchor": {
          "$ref": "#/$defs/Digest"
        },
        "startTagOffset": {
          "type": "integer",
          "minimum": 0
        },
        "startTagLength": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "Patch": {
      "type": "object",
      "required": [
        "format",
        "operation",
        "beforeDigest",
        "afterDigest",
        "start",
        "length",
        "replacement"
      ],
      "properties": {
        "format": {
          "const": "text-replace-v1"
        },
        "operation": {
          "type": "string"
        },
        "beforeDigest": {
          "$ref": "#/$defs/Digest"
        },
        "afterDigest": {
          "$ref": "#/$defs/Digest"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "replacement": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": true
    },
    "Eligibility": {
      "type": "object",
      "required": [
        "eligible",
        "reasons"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "policy": {
          "const": "xaml-automation-id-proposal-v1"
        }
      },
      "additionalProperties": true
    },
    "Uniqueness": {
      "type": "object",
      "properties": {
        "projectScope": {
          "type": "string"
        },
        "projectMatchCount": {
          "type": "integer",
          "minimum": 0
        },
        "liveScope": {
          "type": "string"
        },
        "liveMatchCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "liveScopeAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "FlowFollowUp": {
      "type": "object",
      "properties": {
        "flowPath": {
          "type": "string"
        },
        "flowId": {
          "type": "string"
        },
        "flowDigest": {
          "type": "string"
        },
        "stepIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresSeparateApproval": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "PlatformVerification": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "targetFramework": {
          "type": "string"
        },
        "buildState": {
          "type": "string"
        },
        "runtimeRemapState": {
          "type": "string"
        },
        "uniquenessState": {
          "type": "string"
        },
        "replayState": {
          "type": "string"
        },
        "oracleState": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
