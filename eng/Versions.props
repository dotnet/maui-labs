<Project>
  <PropertyGroup>
    <_MauiLabsVersionsPropsImported>true</_MauiLabsVersionsPropsImported>
    <!-- Product version -->
    <MajorVersion>0</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionPrefix>$(MajorVersion).$(MinorVersion).$(PatchVersion)</VersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>14</PreReleaseVersionIteration>
    <StabilizePackageVersion>false</StabilizePackageVersion>
    <!-- Arcade features -->
    <UsingToolXliff>false</UsingToolXliff>
  </PropertyGroup>
  <!-- Dependencies flowing via darc/maestro (match Version.Details.xml) -->
  <PropertyGroup Label="Dotnet MAUI">
    <MicrosoftMauiControlsVersion>11.0.10</MicrosoftMauiControlsVersion>
    <!-- Minimum MAUI version required by DevFlow shipping packages (which target net11.0).
         Kept low so consumers can use any compatible MAUI 11.0.x release. -->
    <DevFlowMauiMinVersion>11.0.0</DevFlowMauiMinVersion>
    <!-- Microsoft.Maui.Controls.Compatibility has no MAUI 11 release (the last one is
         11.0.0-preview.6), so it stays on the last 10.x version. No project references it
         directly; it only arrives transitively (e.g. via AathifMahir.Maui.MauiIcons). -->
    <MicrosoftMauiControlsCompatibilityVersion>10.0.41</MicrosoftMauiControlsCompatibilityVersion>
    <MicrosoftMauiEssentialsVersion>$(MicrosoftMauiControlsVersion)</MicrosoftMauiEssentialsVersion>
    <!-- Blazor WebView core matching MAUI 11 (Microsoft.AspNetCore.Components.WebView.Maui 11.0.x
         depends on 11.0.0). -->
    <MicrosoftAspNetCoreComponentsWebViewVersion>11.0.0</MicrosoftAspNetCoreComponentsWebViewVersion>
    <MicrosoftMauiControlsMapsVersion>$(MicrosoftMauiControlsVersion)</MicrosoftMauiControlsMapsVersion>
    <MicrosoftAspNetCoreComponentsWebViewMauiVersion>$(MicrosoftMauiControlsVersion)</MicrosoftAspNetCoreComponentsWebViewMauiVersion>
    <!-- Aliases kept for the stacked platform PRs (macOS AppKit, Linux GTK4, WPF), which still
         reference these names. Every product is on MAUI 11 now; remove once those have merged. -->
    <MicrosoftMauiControlsNet11Version>$(MicrosoftMauiControlsVersion)</MicrosoftMauiControlsNet11Version>
    <MicrosoftAspNetCoreComponentsWebViewNet11Version>$(MicrosoftAspNetCoreComponentsWebViewVersion)</MicrosoftAspNetCoreComponentsWebViewNet11Version>
  </PropertyGroup>
  <PropertyGroup Label="AndroidX">
    <!-- WorkManager: used by DevFlow.Sample to exercise background job inspection/triggering.
         Held at 2.10.0.5 because it is the newest version whose *complete* dependency graph is
         available on this repo's feeds. From 2.10.1 on, WorkManager depends on Room 2.7+, which
         AndroidX split into KMP-style sub-packages (Room.Runtime.Android, Room.Common.JVM,
         Sqlite.Android, Sqlite.Framework.Android). Those sub-packages are not mirrored to
         dotnet-public, so restore fails with NU1101 in CI even though it succeeds on a machine
         with a warm package cache. Room 2.6.x, which 2.10.0.5 uses, predates the split.
         Revisit once the Room/Sqlite platform packages are mirrored. -->
    <XamarinAndroidXWorkRuntimeVersion>2.10.0.5</XamarinAndroidXWorkRuntimeVersion>
    <XamarinAndroidXKtxFacadeVersion>1.3.0.1</XamarinAndroidXKtxFacadeVersion>
    <!-- MAUI 11 resolves AndroidX.Core 1.19, which needs Lifecycle.Runtime 2.11.x. -->
    <XamarinAndroidXLifecycleServiceVersion>2.11.0.1</XamarinAndroidXLifecycleServiceVersion>
    <!-- Alias kept for the stacked platform PRs; remove once those have merged. -->
    <XamarinAndroidXLifecycleServiceNet11Version>$(XamarinAndroidXLifecycleServiceVersion)</XamarinAndroidXLifecycleServiceNet11Version>
  </PropertyGroup>
  <PropertyGroup Label="Dotnet Runtime / Extensions">
    <!-- The .NET 11 line: MAUI 11 depends on Microsoft.Extensions.* >= 11.0.0, so anything lower
         is a package downgrade (NU1109) under transitive pinning. -->
    <MicrosoftExtensionsDependencyInjectionVersion>11.0.0</MicrosoftExtensionsDependencyInjectionVersion>
    <MicrosoftExtensionsConfigurationVersion>11.0.0</MicrosoftExtensionsConfigurationVersion>
    <MicrosoftExtensionsHttpVersion>11.0.0</MicrosoftExtensionsHttpVersion>
    <MicrosoftExtensionsHostingVersion>11.0.0</MicrosoftExtensionsHostingVersion>
    <MicrosoftExtensionsLoggingAbstractionsVersion>11.0.0</MicrosoftExtensionsLoggingAbstractionsVersion>
    <MicrosoftExtensionsLoggingConsoleVersion>11.0.0</MicrosoftExtensionsLoggingConsoleVersion>
    <MicrosoftExtensionsLoggingVersion>11.0.0</MicrosoftExtensionsLoggingVersion>
    <MicrosoftExtensionsLoggingDebugVersion>11.0.0</MicrosoftExtensionsLoggingDebugVersion>
    <MicrosoftExtensionsConfigurationJsonVersion>11.0.0</MicrosoftExtensionsConfigurationJsonVersion>
    <MicrosoftExtensionsConfigurationUserSecretsVersion>11.0.0</MicrosoftExtensionsConfigurationUserSecretsVersion>
    <SystemTextJsonVersion>11.0.0</SystemTextJsonVersion>
    <!-- The 11.0 packages above only support net10.0+ on .NETCoreApp. Down-level TFMs
         (net8.0/net9.0/netstandard2.0/net472) use these instead; see Directory.Packages.props. -->
    <MicrosoftExtensionsDownlevelVersion>10.0.5</MicrosoftExtensionsDownlevelVersion>
    <SystemTextJsonDownlevelVersion>10.0.5</SystemTextJsonDownlevelVersion>
    <!-- Alias kept for the stacked platform PRs; remove once those have merged. -->
    <MicrosoftExtensionsNet11Version>$(MicrosoftExtensionsDependencyInjectionVersion)</MicrosoftExtensionsNet11Version>
  </PropertyGroup>
  <PropertyGroup Label="AI">
    <MicrosoftExtensionsAIVersion>10.4.1</MicrosoftExtensionsAIVersion>
    <MicrosoftExtensionsAIOpenAIVersion>10.4.1</MicrosoftExtensionsAIOpenAIVersion>
    <AzureAIOpenAIVersion>2.1.0</AzureAIOpenAIVersion>
  </PropertyGroup>
  <PropertyGroup Label="Roslyn">
    <MicrosoftCodeAnalysisAnalyzersVersion>3.11.0</MicrosoftCodeAnalysisAnalyzersVersion>
  </PropertyGroup>
  <!-- Pinned dependencies (third party, not flowing via maestro) -->
  <PropertyGroup Label="Third Party">
    <AathifMahirMauiIconsCupertinoVersion>5.0.0</AathifMahirMauiIconsCupertinoVersion>
    <CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>
    <FizzlerVersion>1.3.1</FizzlerVersion>
    <SkiaSharpVersion>3.119.2</SkiaSharpVersion>
    <SyncfusionMauiToolkitVersion>1.0.11</SyncfusionMauiToolkitVersion>
    <SpectreConsoleVersion>0.54.0</SpectreConsoleVersion>
    <SystemCommandLineStableVersion>2.0.5</SystemCommandLineStableVersion>
    <WebsocketClientVersion>5.3.0</WebsocketClientVersion>
    <XenoAtomTerminalUIVersion>1.7.1</XenoAtomTerminalUIVersion>
    <ModelContextProtocolVersion>1.1.0</ModelContextProtocolVersion>
    <InteropUIAutomationClientVersion>10.19041.0</InteropUIAutomationClientVersion>
    <MicrosoftCodeAnalysisCSharpVersion>4.14.0</MicrosoftCodeAnalysisCSharpVersion>
    <MicrosoftOpenApiVersion>3.5.4</MicrosoftOpenApiVersion>
    <YamlDotNetVersion>16.3.0</YamlDotNetVersion>
  </PropertyGroup>
  <!-- Android platform tooling (managed via darc/maestro — see eng/Version.Details.xml) -->
  <PropertyGroup Label="Android Tools">
    <XamarinAndroidToolsAndroidSdkVersion>37.2.1-preview.14</XamarinAndroidToolsAndroidSdkVersion>
  </PropertyGroup>
  <!-- Apple platform tooling (managed via darc/maestro — see eng/Version.Details.xml) -->
  <PropertyGroup Label="Apple Tools">
    <XamarinAppleToolsMaciOSVersion>1.0.0-preview.1.26521.1</XamarinAppleToolsMaciOSVersion>
  </PropertyGroup>
  <PropertyGroup Label="Platform Extensions">
    <PlatformMauiLinuxGtk4Version>0.6.0</PlatformMauiLinuxGtk4Version>
    <PlatformMauiLinuxGtk4BlazorWebViewVersion>$(PlatformMauiLinuxGtk4Version)</PlatformMauiLinuxGtk4BlazorWebViewVersion>
    <PlatformMauiLinuxGtk4EssentialsVersion>$(PlatformMauiLinuxGtk4Version)</PlatformMauiLinuxGtk4EssentialsVersion>
    <PlatformMauiWindowsWpfVersion>0.1.0</PlatformMauiWindowsWpfVersion>
    <PlatformMauiWindowsWpfEssentialsVersion>$(PlatformMauiWindowsWpfVersion)</PlatformMauiWindowsWpfEssentialsVersion>
    <PlatformMauiMacOSVersion>0.3.0</PlatformMauiMacOSVersion>
    <PlatformMauiMacOSBlazorWebViewVersion>$(PlatformMauiMacOSVersion)</PlatformMauiMacOSBlazorWebViewVersion>
    <PlatformMauiMacOSEssentialsVersion>$(PlatformMauiMacOSVersion)</PlatformMauiMacOSEssentialsVersion>
  </PropertyGroup>
  <!-- EssentialsAI package version (continues the NuGet line that existed before moving into this repo). -->
  <PropertyGroup Label="EssentialsAI">
    <EssentialsAIMajorVersion>11</EssentialsAIMajorVersion>
    <EssentialsAIMinorVersion>0</EssentialsAIMinorVersion>
    <EssentialsAIPatchVersion>0</EssentialsAIPatchVersion>
    <EssentialsAIPreReleaseVersionLabel>preview</EssentialsAIPreReleaseVersionLabel>
    <EssentialsAIPreviewVersionIteration>8</EssentialsAIPreviewVersionIteration>
    <!-- Microsoft Extensions AI -->
    <MicrosoftExtensionsAIAbstractionsVersion>10.4.1</MicrosoftExtensionsAIAbstractionsVersion>
    <!-- Microsoft Agents AI (sample only) -->
    <MicrosoftAgentsAIVersion>1.0.0-rc2</MicrosoftAgentsAIVersion>
    <MicrosoftAgentsAIWorkflowsVersion>1.0.0-rc2</MicrosoftAgentsAIWorkflowsVersion>
    <MicrosoftAgentsAIWorkflowsGeneratorsVersion>1.0.0-rc2</MicrosoftAgentsAIWorkflowsGeneratorsVersion>
    <MicrosoftAgentsAIHostingVersion>1.0.0-preview.260225.1</MicrosoftAgentsAIHostingVersion>
    <!-- DeviceRunners (device test runner OSS replacement) -->
    <DeviceRunnersVersion>0.1.0-preview.12</DeviceRunnersVersion>
    <!-- Stable library baseline; development apps override the umbrella SDK only. -->
    <MicrosoftWindowsAppSDKAIVersion>2.4.4</MicrosoftWindowsAppSDKAIVersion>
    <MicrosoftWindowsAppSDKVersion_Experimental>2.5.4-experimental</MicrosoftWindowsAppSDKVersion_Experimental>
    <!-- Windows: enables dotnet run for packaged MSIX apps. Microsoft.Maui.Core 11 (Windows)
         depends on WinApp >= 0.7.1. -->
    <MicrosoftWindowsSDKBuildToolsWinAppVersion>0.7.1</MicrosoftWindowsSDKBuildToolsWinAppVersion>
    <!-- Alias kept for the stacked platform PRs; remove once those have merged. -->
    <MicrosoftWindowsSDKBuildToolsWinAppNet11Version>$(MicrosoftWindowsSDKBuildToolsWinAppVersion)</MicrosoftWindowsSDKBuildToolsWinAppNet11Version>
  </PropertyGroup>
  <PropertyGroup Label="Testing">
    <MicrosoftNETTestSdkVersion>18.3.0</MicrosoftNETTestSdkVersion>
    <MicrosoftTestingPlatformVersion>2.3.2</MicrosoftTestingPlatformVersion>
    <MSTestVersion>4.3.2</MSTestVersion>
    <NUnitVersion>4.4.0</NUnitVersion>
    <NUnit3TestAdapterVersion>6.2.0</NUnit3TestAdapterVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVisualstudioVersion>3.1.5</XunitRunnerVisualstudioVersion>
    <CoverletCollectorVersion>8.0.0</CoverletCollectorVersion>
    <VerifyXunitVersion>28.15.0</VerifyXunitVersion>
    <VerifySourceGeneratorsVersion>2.5.0</VerifySourceGeneratorsVersion>
  </PropertyGroup>
  <PropertyGroup Label="SourceLink">
    <MicrosoftSourceLinkGitHubVersion>10.0.201</MicrosoftSourceLinkGitHubVersion>
  </PropertyGroup>
  <PropertyGroup Label="MAUI Go">
    <QRCoderVersion>1.7.0</QRCoderVersion>
    <ZXingNetMauiVersion>0.7.4</ZXingNetMauiVersion>
  </PropertyGroup>
</Project>
