<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GenerativeUI.Sample.Garden.Server</RootNamespace>
    <!-- Sample server: not shipped, not packed. -->
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- ASP.NET's OpenAPI stack targets Microsoft.OpenApi 2.0.0; override the repo's 3.5.0 central pin. -->
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenerativeUI.Sample.Garden.Shared\GenerativeUI.Sample.Garden.Shared.csproj" />
  </ItemGroup>

</Project>
