<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ChatClientPlayground.ViewModels"
             xmlns:views="clr-namespace:ChatClientPlayground.Views"
             x:Class="ChatClientPlayground.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="IChatClient Playground"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid x:Name="RootGrid" RowDefinitions="*" Padding="12" ColumnSpacing="12" SafeAreaEdges="Container">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SettingsPanel" Grid.Column="0" ZIndex="10"
                BackgroundColor="{StaticResource PanelBackground}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12"
                AutomationId="SettingsSidebar">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="16,16,16,0" ColumnDefinitions="*,Auto">
                    <Label Text="Playground settings" FontSize="20" FontAttributes="Bold" />
                    <ImageButton x:Name="CloseSettingsButton" Grid.Column="1" Source="close.png" IsVisible="False"
                            Clicked="CloseSettingsClicked" BackgroundColor="#64748B" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                            SemanticProperties.Description="Close settings" ToolTipProperties.Text="Close settings" AutomationId="CloseSettingsButton" />
                </Grid>
                <views:SettingsPane Grid.Row="1" BindingContext="{Binding Settings}" />
            </Grid>
        </Border>

        <Grid x:Name="ChatPanel" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <Border BackgroundColor="{StaticResource PanelBackground}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ImageButton x:Name="OpenSettingsButton" Source="settings.png" IsVisible="False"
                            Clicked="OpenSettingsClicked" BackgroundColor="#64748B" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                            SemanticProperties.Description="Open settings" ToolTipProperties.Text="Open settings" AutomationId="OpenSettingsButton" />
                    <VerticalStackLayout x:Name="HeaderContent" Grid.Column="1" Spacing="2">
                        <Label Text="IChatClient Playground" FontSize="22" FontAttributes="Bold" />
                        <Label Text="{Binding Chat.StatusMessage}" FontSize="12" TextColor="{StaticResource MutedText}" AutomationId="RequestStatusLabel" />
                    </VerticalStackLayout>
                    <ImageButton x:Name="ClearConversationButton" Grid.Column="2" Source="trash.png" Command="{Binding ClearConversationCommand}"
                                 BackgroundColor="#64748B" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                                 SemanticProperties.Description="Clear conversation" ToolTipProperties.Text="Clear conversation" AutomationId="ClearConversationButton" />
                </Grid>
            </Border>

            <views:ChatArea x:Name="ChatArea" Grid.Row="1" BindingContext="{Binding Chat}" />
        </Grid>
    </Grid>
</ContentPage>
