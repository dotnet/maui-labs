<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ScrollAnchor: keeps the end of a CollectionView or ScrollView in view while content arrives or grows, the way a
    chat or a log should behave. Written as a self-contained feature so it can be proposed to (and copied into)
    dotnet/maui; see README.md.

    net10.0 holds the platform-agnostic core, which tests/AIExtensions/AIExtensions.Sample.Scrolling.Tests compiles and
    tests; on other platforms (such as Windows) setting the mode has no effect. The platform TFMs add the thin adapters
    that feed the core. UseMaui is deliberately not set: on net10.0 it would import the maui workload SDK, and nothing
    here needs the MAUI SDK's resources or XAML compilation.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseXcode27Preview)' != 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseXcode27Preview)' == 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios27.0;net10.0-maccatalyst27.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(UseXcode27Preview)' == 'true' and $(TargetFramework.Contains('-maccatalyst'))">17.0</SupportedOSPlatformVersion>
    <RootNamespace>AIExtensions.Sample.Scrolling</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
  </PropertyGroup>

  <!-- Platform files follow dotnet/maui's naming: *.Android.cs, *.iOS.cs (iOS and Mac Catalyst), *.Standard.cs (no platform). -->
  <PropertyGroup>
    <_ScrollAnchorPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_ScrollAnchorPlatform>
  </PropertyGroup>
  <ItemGroup Condition="'$(_ScrollAnchorPlatform)' != 'android'">
    <Compile Remove="**\*.Android.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(_ScrollAnchorPlatform)' != 'ios' and '$(_ScrollAnchorPlatform)' != 'maccatalyst'">
    <Compile Remove="**\*.iOS.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(_ScrollAnchorPlatform)' == 'android' or '$(_ScrollAnchorPlatform)' == 'ios' or '$(_ScrollAnchorPlatform)' == 'maccatalyst'">
    <Compile Remove="**\*.Standard.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
