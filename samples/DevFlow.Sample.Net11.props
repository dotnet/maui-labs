<Project>
  <!--
    The DevFlow integration samples multi-target net10.0 (the backends' MAUI 10 compatibility
    assets) and net11.0 (the backends' MAUI 11 public-contract assets), so the integration suite
    can drive both. Repository-wide central transitive pinning can downgrade the backends'
    servicing dependencies to the repository's compatibility baseline, so these sample
    apps resolve their transitive graph normally. Their direct .NET 11 Extensions references
    follow the current repository version.
  -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <DevFlowSampleExtensions11Version Condition="'$(DevFlowSampleExtensions11Version)' == ''">$(MicrosoftExtensionsHttpVersion)</DevFlowSampleExtensions11Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) == '11.0'">
    <PackageReference Update="Microsoft.Extensions.Logging.Debug" VersionOverride="$(DevFlowSampleExtensions11Version)" />
    <PackageReference Update="Microsoft.Extensions.Http" VersionOverride="$(DevFlowSampleExtensions11Version)" />
  </ItemGroup>
</Project>
