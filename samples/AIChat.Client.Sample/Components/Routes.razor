@namespace AIChat.Client.Sample.Components
@using AIChat.Client.Sample
@using AIChat.Sample.Shared
@inject DirectChatComposition Host
@implements IDisposable

<main data-testid="direct-chat-root">
    <p data-testid="state-panel">@Host.StatusText</p>
    <Microsoft.Maui.AI.Chat.Controls.Blazor.CopilotChatView Presentation="@Host.Presentation"
                                                              ComposerController="@Host.ComposerController"
                                                              data-testid="blazor-copilot-chat">
        <Microsoft.Maui.Chat.Controls.Blazor.MessageContentRenderer TContent="AgentBlockContent"
                                                                     When="IsPredictiveProposal">
            <ChildContent Context="content">
                <section data-testid="predictive-proposal-card">
                    <p>@Host.State.PendingDocument?.Document.Content</p>
                    <button data-testid="proposal-accept" disabled="@(Host.State.PendingDocument is null)" @onclick="() => ResolveDocumentAsync(true)">Accept</button>
                    <button data-testid="proposal-reject" disabled="@(Host.State.PendingDocument is null)" @onclick="() => ResolveDocumentAsync(false)">Reject</button>
                </section>
            </ChildContent>
        </Microsoft.Maui.Chat.Controls.Blazor.MessageContentRenderer>
    </Microsoft.Maui.AI.Chat.Controls.Blazor.CopilotChatView>
    <aside data-testid="typed-state">
        @if (Host.State.Weather is { } weather) { <section data-testid="weather-card">@weather.Conditions (@weather.Temperature°C)</section> }
        @if (Host.State.Plan.Steps.Count > 0) { <section data-testid="plan-card">@string.Join(", ", Host.State.Plan.Steps.Select(step => $"{step.Description}: {step.Status}"))</section> }
        @if (Host.State.Recipe is { } recipe) { <section data-testid="recipe-card">@recipe.Title</section> }
        @if (Host.State.PendingDocument is { } proposal)
        {
            <section data-testid="predictive-document">
                <p>@proposal.Document.Content</p>
                <button data-testid="approve-document" @onclick="() => ResolveDocumentAsync(true)">Accept</button>
                <button data-testid="reject-document" @onclick="() => ResolveDocumentAsync(false)">Reject</button>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(Host.State.Document.Content)) { <section data-testid="document-card">@Host.State.Document.Content</section> }
    </aside>
    <div class="sample-actions">
        <button data-testid="blazor-retry" @onclick="Host.RetryAsync">Retry</button>
    </div>
</main>

@code {
    protected override void OnInitialized()
    {
        Host.PropertyChanged += OnHostChanged;
        Host.State.Changed += OnStateChanged;
    }

    private void OnHostChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private Task ResolveDocumentAsync(bool accepted) => Host.ResolveDocumentProposalAsync(accepted);
    private bool IsPredictiveProposal(AgentBlockContent content) =>
        Host.State.HasPendingDocument && PredictiveProposal.IsPredictiveProposal(content);

    public void Dispose()
    {
        Host.PropertyChanged -= OnHostChanged;
        Host.State.Changed -= OnStateChanged;
    }
}
