<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:aiThemes="clr-namespace:Microsoft.Maui.AI.Chat.Controls.Themes;assembly=Microsoft.Maui.AI.Chat.Controls"
             xmlns:chatThemes="clr-namespace:Microsoft.Maui.Chat.Controls.Themes;assembly=Microsoft.Maui.Chat.Controls"
             x:Class="AIChat.Client.Sample.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <chatThemes:ChatControlsTheme />
                <aiThemes:ChatTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
