<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Shiny is published to nuget.org only, and the repo-wide NuGet.config deliberately lists the dnceng
    feeds alone. This sample adds nuget.org for itself. It is not part of MauiLabs.slnx or any CI or
    official build, so the repo's feed policy is unchanged.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
