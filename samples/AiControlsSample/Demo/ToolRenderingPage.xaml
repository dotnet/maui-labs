<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
             xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
             xmlns:local="clr-namespace:AiControlsSample"
             x:Class="AiControlsSample.ToolRenderingPage"
             x:Name="ThisPage"
             Title="AI Chat">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🗑️" Clicked="OnClearClicked" />
    </ContentPage.ToolbarItems>

    <!-- Both panels share the SAME Session. Sending from the left (which owns the -->
    <!-- input) drives both. The left uses the full CopilotChatView with rich, custom -->
    <!-- templates (weather card, formatted text, plan approval); the right uses a bare -->
    <!-- MessageListView with only built-in templates, so the same blocks render plainly. -->
    <Grid ColumnDefinitions="*,1,*" RowDefinitions="Auto,*" ColumnSpacing="0">

        <Label Grid.Row="0" Grid.Column="0" Text="Templated — CopilotChatView"
               FontAttributes="Bold" FontSize="13" Margin="16,10"
               HorizontalTextAlignment="Center" Opacity="0.75" />
        <Label Grid.Row="0" Grid.Column="2" Text="Raw — MessageListView"
               FontAttributes="Bold" FontSize="13" Margin="16,10"
               HorizontalTextAlignment="Center" Opacity="0.75" />

        <BoxView Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                 Color="#22000000" WidthRequest="1" />

        <!-- Left: full experience with custom templates and the shared input box. -->
        <controls:CopilotChatView Grid.Row="1" Grid.Column="0"
                Session="{Binding Source={x:Reference ThisPage}, Path=Session}"
                WelcomeMessage="Try the core features: formatted text, image generation, a tool call, and an approval."
                WelcomeIcon="🔧">
            <controls:CopilotChatView.SuggestionPrompts>
                <x:String>Give me 3 tips for a tidy desk with **bold** keywords</x:String>
                <x:String>Draw a watercolor sunset over mountains</x:String>
                <x:String>What's the weather in Tokyo?</x:String>
                <x:String>Create a plan to organize my desk</x:String>
                <x:String>Trigger an error to test error handling</x:String>
            </controls:CopilotChatView.SuggestionPrompts>
            <controls:CopilotChatView.ContentTemplates>
                <chat:ThinkingContentTemplate />
                <chat:TextContentTemplate Role="User" />
                <chat:GenericContentTemplate BlockType="{x:Type local:FormattedTextBlock}" ViewType="{x:Type local:FormattedTextView}" />
                <chat:MediaContentTemplate />
                <chat:FunctionInvocationTemplate />
                <local:WeatherResultTemplate ToolName="GetCurrentWeather" ViewType="{x:Type local:WeatherResultView}" />
                <chat:ToolApprovalTemplate ToolName="create_plan" ViewType="{x:Type local:PlanStepsView}" />
                <chat:ErrorContentTemplate />
                <chat:DefaultContentTemplate />
            </controls:CopilotChatView.ContentTemplates>
        </controls:CopilotChatView>

        <!-- Right: same blocks, only the built-in templates. Weather shows as a plain -->
        <!-- tool call/result, formatted text shows as plain text. -->
        <controls:MessageListView Grid.Row="1" Grid.Column="2"
                Margin="12,8,12,12"
                Session="{Binding Source={x:Reference ThisPage}, Path=Session}">
            <controls:MessageListView.ContentTemplates>
                <chat:ThinkingContentTemplate />
                <chat:TextContentTemplate />
                <chat:MediaContentTemplate />
                <chat:FunctionInvocationTemplate />
                <chat:ToolApprovalTemplate />
                <chat:ErrorContentTemplate />
                <chat:DefaultContentTemplate />
            </controls:MessageListView.ContentTemplates>
        </controls:MessageListView>
    </Grid>
</ContentPage>
