<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
             xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
             xmlns:local="clr-namespace:AiControlsSample"
             x:Class="AiControlsSample.ToolRenderingPage"
             x:Name="ThisPage"
             Title="AI Chat">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🗑️" Clicked="OnClearClicked" />
    </ContentPage.ToolbarItems>

    <controls:CopilotChatView Session="{Binding Source={x:Reference ThisPage}, Path=Session}"
            WelcomeMessage="Try the core features: formatted text, image generation, a tool call, and an approval."
            WelcomeIcon="🔧">
            <controls:CopilotChatView.SuggestionPrompts>
                <x:String>Give me 3 tips for a tidy desk with **bold** keywords</x:String>
                <x:String>Draw a watercolor sunset over mountains</x:String>
                <x:String>What's the weather in Tokyo?</x:String>
                <x:String>Create a plan to organize my desk</x:String>
            </controls:CopilotChatView.SuggestionPrompts>
        <controls:CopilotChatView.ContentTemplates>
            <chat:ThinkingContentTemplate />
            <chat:TextContentTemplate Role="User" />
            <chat:GenericContentTemplate BlockType="{x:Type local:FormattedTextBlock}" ViewType="{x:Type local:FormattedTextView}" />
            <chat:MediaContentTemplate />
            <chat:FunctionCallTemplate />
            <local:WeatherResultTemplate ToolName="GetCurrentWeather" ViewType="{x:Type local:WeatherResultView}" />
            <chat:ToolApprovalTemplate ToolName="create_plan" ViewType="{x:Type local:PlanStepsView}" />
            <chat:FunctionResultTemplate />
            <chat:ErrorContentTemplate />
            <chat:DefaultContentTemplate />
        </controls:CopilotChatView.ContentTemplates>
    </controls:CopilotChatView>
</ContentPage>
