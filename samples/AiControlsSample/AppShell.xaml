<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AiControlsSample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AiControlsSample"
    Title="AI Controls"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{AppThemeBinding Light=#6366F1, Dark=#312E81}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <ShellContent Title="🔧  Tool Rendering"
                  Route="tool-rendering"
                  ContentTemplate="{DataTemplate local:ToolRenderingPage}" />

</Shell>
