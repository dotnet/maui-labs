<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.EmbeddingPage"
             x:DataType="local:EmbeddingPlaygroundViewModel"
             Title="Embeddings"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <local:PlaygroundPageLayout HeaderTitle="Embeddings"
                                       HeaderInfo="IEmbeddingGenerator indexes imported Markdown or text documents. Search uses that same model's stored vectors; documents never become chats."
                                       HeaderStatus="{Binding StatusMessage}"
                                       StatusAutomationId="EmbeddingStatusLabel"
                                       SidebarTitle="Embedding settings"
                                       DiagnosticsAutomationPrefix="Embedding"
                                       IsDiagnosticsOpen="{Binding Diagnostics.IsOpen}">
            <local:PlaygroundPageLayout.HeaderActions>
                <HorizontalStackLayout Spacing="4">
                    <VerticalStackLayout Spacing="2">
                        <ImageButton Source="folder.png" Style="{StaticResource ChatActionButton}"
                                     SemanticProperties.Description="Import a Markdown or text document"
                                     AutomationId="ImportDocumentButton">
                            <local:PopupMenu.Content>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="IMPORT DOCUMENT" Style="{StaticResource SectionHeading}" />
                                    <Button Text="Choose file" Clicked="ImportDocumentClicked"
                                            AutomationId="ChooseDocumentButton" />
                                    <Button Text="Use sample document" Clicked="ImportSampleDocumentClicked"
                                            AutomationId="SampleDocumentButton" />
                                </VerticalStackLayout>
                            </local:PopupMenu.Content>
                        </ImageButton>
                        <Label Text="Import" Style="{StaticResource ChatActionLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <ImageButton Source="more.png" Style="{StaticResource ChatActionButton}"
                                     SemanticProperties.Description="Embedding diagnostics options"
                                     AutomationId="EmbeddingMoreButton">
                            <local:PopupMenu.Content>
                                <Button Text="Show / hide logs" Command="{Binding Diagnostics.ToggleCommand}"
                                        SemanticProperties.Description="Show or hide AI diagnostics"
                                        AutomationId="ToggleEmbeddingLogsButton" />
                            </local:PopupMenu.Content>
                        </ImageButton>
                        <Label Text="More" Style="{StaticResource ChatActionLabel}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </local:PlaygroundPageLayout.HeaderActions>
            <local:PlaygroundPageLayout.DiagnosticsContent>
                <local:ChatLogsView BindingContext="{Binding Diagnostics}" AutomationPrefix="Embedding" />
            </local:PlaygroundPageLayout.DiagnosticsContent>
            <local:PlaygroundPageLayout.SettingsContent>
                <local:EmbeddingSettingsPane BindingContext="{Binding Settings}" />
            </local:PlaygroundPageLayout.SettingsContent>
            <local:PlaygroundPageLayout.MainContent>
                <local:EmbeddingArea />
            </local:PlaygroundPageLayout.MainContent>
            <local:PlaygroundPageLayout.InputContent>
                <local:EmbeddingComposer />
            </local:PlaygroundPageLayout.InputContent>
        </local:PlaygroundPageLayout>
    </Grid>
</ContentPage>
