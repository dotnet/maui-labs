<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.AttachmentPreview"
             x:Name="Preview"
             x:DataType="local:AttachmentPreview">
    <Grid BindingContext="{x:Reference Preview}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Image Source="{Binding PreviewSource}" Aspect="{Binding PreviewAspect}" WidthRequest="56" HeightRequest="56" />
        <Label Grid.Column="1" Text="{Binding FileName}" VerticalOptions="Center" LineBreakMode="TailTruncation"
               AutomationId="{Binding NameAutomationId}" />
        <ImageButton Grid.Column="2" Source="close.png" Command="{Binding RemoveCommand}"
                     Style="{StaticResource AttachmentButton}"
                     SemanticProperties.Description="{Binding RemoveDescription}"
                     AutomationId="{Binding RemoveAutomationId}" />
    </Grid>
</ContentView>
