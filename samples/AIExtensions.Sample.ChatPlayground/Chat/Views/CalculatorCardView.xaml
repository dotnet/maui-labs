<?xml version="1.0" encoding="utf-8" ?>
<!--
    A custom card for the playground's "calculate" tool, used through a chat:BlockTemplate that matches the tool's
    calls (see ChatPage.xaml). It reuses the chat theme's resources, so it follows light and dark mode with the
    built-in cards. It reads the session (to find the call's approval), so it is a chat:ChatBlockView.
-->
<chat:ChatBlockView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="http://schemas.microsoft.com/dotnet/2026/maui/ai/chat"
                    x:Class="AIExtensions.Sample.ChatPlayground.CalculatorCardView"
                    AutomationId="CalculatorCard">
    <Border x:Name="Card"
            Style="{DynamicResource AIChat.Style.Card}"
            HorizontalOptions="Start"
            MinimumWidthRequest="220">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{DynamicResource AIChat.Color.Accent}">
                <Label Text="="
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource AIChat.Color.OnAccent}"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="CALCULATOR"
                       Style="{DynamicResource AIChat.Style.SecondaryText}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="0.6" />
                <HorizontalStackLayout Spacing="8">
                    <Label x:Name="ExpressionLabel"
                           Style="{DynamicResource AIChat.Style.AssistantText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           AutomationId="CalculatorExpression" />
                    <ActivityIndicator x:Name="BusyIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center"
                                       Color="{DynamicResource AIChat.Color.SecondaryText}" />
                </HorizontalStackLayout>
                <Label x:Name="StatusLabel"
                       Style="{DynamicResource AIChat.Style.SecondaryText}"
                       IsVisible="False"
                       AutomationId="CalculatorStatus" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</chat:ChatBlockView>
