<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.ChatComposer"
             x:DataType="local:ChatAreaViewModel"
             IsVisible="{Binding IsLiveClient}"
             AutomationId="LiveComposerPresenter">
    <Border Style="{StaticResource ComposerPanel}">
        <VerticalStackLayout Spacing="8">
            <local:AttachmentPreview IsVisible="{Binding HasSelectedImage}"
                                     PreviewSource="{Binding SelectedImagePreview}" FileName="{Binding SelectedImageName}"
                                     RemoveCommand="{Binding RemoveImageAction}" RemoveDescription="Remove selected image"
                                     RemoveAutomationId="RemoveImageButton" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <ImageButton Source="add.png" Style="{StaticResource AttachmentButton}"
                             IsEnabled="{Binding IsImageSupported}"
                             SemanticProperties.Description="Add an image attachment"
                             AutomationId="AddAttachmentButton">
                    <local:PopupMenu.Content>
                        <VerticalStackLayout Spacing="8" x:DataType="local:ChatAreaViewModel">
                            <Label Text="ADD IMAGE" Style="{StaticResource SectionHeading}" />
                            <Button Text="Choose image" ImageSource="image.png"
                                    Command="{Binding ChooseImageAction}"
                                    AutomationId="ChooseImageMenuItem" />
                            <Button Text="Use sample image" ImageSource="sampleimage.png"
                                    Command="{Binding UseSampleImageAction}"
                                    AutomationId="UseSampleImageMenuItem" />
                        </VerticalStackLayout>
                    </local:PopupMenu.Content>
                </ImageButton>
                <Editor Grid.Column="1" Text="{Binding Prompt}"
                       AutoSize="TextChanges" MinimumWidthRequest="0"
                       MinimumHeightRequest="44" MaximumHeightRequest="120"
                       Placeholder="Ask the selected real chat client"
                       AutomationId="PromptEntry" />
                <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="End">
                    <ImageButton Source="send.png" Command="{Binding SendCommand}"
                                 IsVisible="{Binding IsIdle}" Style="{StaticResource AttachmentButton}"
                                 SemanticProperties.Description="Send message" AutomationId="SendButton" />
                    <ImageButton Source="stop.png" Command="{Binding CancelCommand}"
                                 IsVisible="{Binding IsBusy}" Style="{StaticResource CancelActionButton}"
                                 SemanticProperties.Description="Stop response" AutomationId="StopButton" />
                </Grid>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
