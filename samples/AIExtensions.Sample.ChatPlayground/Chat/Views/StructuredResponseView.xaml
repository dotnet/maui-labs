<?xml version="1.0" encoding="utf-8" ?>
<!--
    Renders assistant text that is a JSON object, selected by StructuredResponseTemplate. A response that follows
    the playground schema (PlaygroundResponse) is shown as a card; any other JSON is shown formatted. While the JSON
    streams in, the raw text is shown until it is complete.
-->
<chat:BlockView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:chat="http://schemas.microsoft.com/dotnet/2026/maui/ai/chat"
                x:Class="AIExtensions.Sample.ChatPlayground.StructuredResponseView"
                AutomationId="StructuredResponseCard">
    <Border Style="{DynamicResource AIChat.Style.Card}" Padding="14,12">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="HeadingLabel"
                       Text="STRUCTURED RESPONSE"
                       Style="{DynamicResource AIChat.Style.SecondaryText}"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="0.6"
                       VerticalOptions="Center" />
                <Button x:Name="JsonToggle"
                        Grid.Column="1"
                        Text="Show JSON"
                        Style="{DynamicResource AIChat.Style.SecondaryButton}"
                        FontSize="12"
                        Padding="10,2"
                        MinimumHeightRequest="26"
                        HeightRequest="26"
                        VerticalOptions="Center"
                        Clicked="OnJsonToggleClicked"
                        AutomationId="StructuredResponseJsonToggle" />
            </Grid>

            <VerticalStackLayout x:Name="ResponsePanel" Spacing="10">
                <Label x:Name="SummaryLabel"
                       Style="{DynamicResource AIChat.Style.AssistantText}"
                       AutomationId="StructuredResponseSummary" />
                <VerticalStackLayout x:Name="KeyPointsLayout" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" ColumnSpacing="4">
                                <Label Text="&#x2022;"
                                       Style="{DynamicResource AIChat.Style.AssistantText}"
                                       TextColor="{DynamicResource AIChat.Color.Accent}"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding .}"
                                       Style="{DynamicResource AIChat.Style.AssistantText}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <FlexLayout x:Name="Chips" Wrap="Wrap" AlignItems="Center">
                    <Border x:Name="CategoryChip"
                            Margin="0,0,6,4"
                            Padding="10,3"
                            StrokeThickness="1"
                            Stroke="{DynamicResource AIChat.Color.Stroke}"
                            StrokeShape="RoundRectangle 11"
                            BackgroundColor="{DynamicResource AIChat.Color.CodeBackground}"
                            AutomationId="StructuredResponseCategory">
                        <Label x:Name="CategoryLabel"
                               Style="{DynamicResource AIChat.Style.SecondaryText}"
                               FontSize="12"
                               TextColor="{DynamicResource AIChat.Color.Text}" />
                    </Border>
                    <Border x:Name="SentimentChip"
                            Margin="0,0,6,4"
                            Padding="10,3"
                            StrokeThickness="1"
                            Stroke="{DynamicResource AIChat.Color.Stroke}"
                            StrokeShape="RoundRectangle 11"
                            BackgroundColor="{DynamicResource AIChat.Color.CodeBackground}"
                            AutomationId="StructuredResponseSentiment">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView x:Name="SentimentDot"
                                     WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     VerticalOptions="Center" />
                            <Label x:Name="SentimentLabel"
                                   Style="{DynamicResource AIChat.Style.SecondaryText}"
                                   FontSize="12"
                                   TextColor="{DynamicResource AIChat.Color.Text}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>

            <Border x:Name="JsonPanel" Style="{DynamicResource AIChat.Style.CodeBlock}" IsVisible="False">
                <Label x:Name="JsonLabel"
                       Style="{DynamicResource AIChat.Style.CodeText}"
                       AutomationId="StructuredResponseJson" />
            </Border>
        </VerticalStackLayout>
    </Border>
</chat:BlockView>
