<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.ChatPage"
             x:DataType="local:ChatViewModel"
             Title="Chat"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <local:PlaygroundPageLayout x:Name="ChatLayout" HeaderTitle="Chat"
                                       HeaderInfo="Chat with the selected client. The conversation and the shared notes are saved as they change and come back when the app starts. More starts a new chat or shows the notes. Logs toggles local AI diagnostics."
                                       HeaderStatus="{Binding StatusMessage}"
                                       StatusAutomationId="RequestStatusLabel"
                                       SidebarTitle="Chat settings"
                                       Diagnostics="{Binding Diagnostics}">
            <local:PlaygroundPageLayout.HeaderActions>
                <VerticalStackLayout Spacing="2">
                    <ImageButton x:Name="MoreButton" Source="more.png"
                                 Style="{StaticResource ChatActionButton}"
                                 SemanticProperties.Description="Chat options"
                                 AutomationId="ChatMoreButton">
                        <local:PopupMenu.Content>
                            <VerticalStackLayout Spacing="8" x:DataType="local:ChatViewModel">
                                <Label Text="CHAT" Style="{StaticResource SectionHeading}" />
                                <Button Text="New chat" ImageSource="add.png"
                                        Command="{Binding NewChatAction}"
                                        SemanticProperties.Description="Start a new chat, replacing the saved conversation and notes"
                                        AutomationId="NewChatButton" />
                                <Button Text="{Binding Notes.ToggleShownText}"
                                        Command="{Binding Notes.ToggleShownAction}"
                                        AutomationId="ToggleNotesButton" />
                            </VerticalStackLayout>
                        </local:PopupMenu.Content>
                    </ImageButton>
                    <Label Text="More" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
            </local:PlaygroundPageLayout.HeaderActions>
            <local:PlaygroundPageLayout.SettingsContent>
                <local:SettingsPane BindingContext="{Binding Settings}" />
            </local:PlaygroundPageLayout.SettingsContent>
            <local:PlaygroundPageLayout.MainContent>
                <!-- The notes sit beside the messages, or below them on a narrow screen. -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                    <Border Style="{StaticResource PlaygroundPanel}" Padding="0" AutomationId="ChatPanel">
                        <local:ChatArea />
                    </Border>
                    <local:NotesView Grid.Column="1" WidthRequest="300" Margin="12,0,0,0"
                                     BindingContext="{Binding Notes}"
                                     IsCompact="{Binding IsCompact, Source={x:Reference ChatLayout}, x:DataType=local:PlaygroundPageLayout}">
                        <local:NotesView.Triggers>
                            <DataTrigger TargetType="local:NotesView" Value="True"
                                         Binding="{Binding IsCompact, Source={x:Reference ChatLayout}, x:DataType=local:PlaygroundPageLayout}">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="WidthRequest" Value="-1" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                            </DataTrigger>
                        </local:NotesView.Triggers>
                    </local:NotesView>
                </Grid>
            </local:PlaygroundPageLayout.MainContent>
            <local:PlaygroundPageLayout.InputContent>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border BindingContext="{Binding Readiness}" x:DataType="local:ModelReadinessViewModel"
                            IsVisible="{Binding IsVisible}" Padding="12,8" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ModelWarningBackground}, Dark={StaticResource ModelWarningBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource ModelWarningText}, Dark={StaticResource ModelWarningTextDark}}"
                            AutomationId="ModelReadinessBanner">
                        <Grid ColumnDefinitions="*,112" RowDefinitions="Auto,2" ColumnSpacing="12" RowSpacing="4">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                                <ActivityIndicator IsRunning="{Binding IsIndeterminateProgress}"
                                                   Opacity="{Binding IndeterminateProgressOpacity}"
                                                   VerticalOptions="Center" WidthRequest="20" HeightRequest="20"
                                                   AutomationId="ModelPreparationActivity" />
                                <Label Grid.Column="1" FontSize="13" VerticalOptions="Center"
                                       ToolTipProperties.Text="{Binding Message}"
                                       TextColor="{AppThemeBinding Light={StaticResource ModelWarningText}, Dark={StaticResource ModelWarningTextDark}}"
                                       AutomationId="ModelReadinessMessage">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Message}" />
                                            <Span Text="{Binding ProgressLine}" FontSize="12" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                            <Button Grid.Column="1" Text="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                    VerticalOptions="Center" HeightRequest="44" FontSize="12"
                                    AutomationId="ModelReadinessActionButton" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding ProgressFraction}"
                                         Opacity="{Binding DeterminateProgressOpacity}" VerticalOptions="Center"
                                         AutomationId="ModelPreparationProgress" />
                        </Grid>
                    </Border>
                    <local:ChatComposer Grid.Row="1" />
                </Grid>
            </local:PlaygroundPageLayout.InputContent>
        </local:PlaygroundPageLayout>
    </Grid>
</ContentPage>
