<?xml version="1.0" encoding="utf-8" ?>
<!--
    The conversation: a CollectionView over the session's turns. Each turn lays out its request and response blocks with
    the templates of ChatTemplates.xaml, then says how the response ended when it did not complete: stopped, or failed
    with Retry.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="http://schemas.microsoft.com/dotnet/2026/maui/ai/chat"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.ChatArea"
             x:DataType="local:ChatViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:ChatTemplates />
            </ResourceDictionary.MergedDictionaries>
            <local:TurnFooterConverter x:Key="TurnFooter" />
            <local:TurnErrorConverter x:Key="TurnError" />
        </ResourceDictionary>
    </ContentView.Resources>

    <CollectionView ItemsSource="{Binding Session.Turns}"
                    ItemsUpdatingScrollMode="KeepLastItemInView"
                    SelectionMode="None"
                    AutomationId="ChatTurns">

        <!-- Before the first message: what to do, and prompts to try. -->
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="28" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center"
                                 MaximumWidthRequest="560" AutomationId="ChatWelcome">
                <Label Text="{Binding WelcomeTitle}" FontSize="18" HorizontalTextAlignment="Center" />
                <Label Text="{Binding WelcomeMessage}" Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Suggestions}" Wrap="Wrap"
                            JustifyContent="Center" Margin="0,8,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}" Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                                    Command="{Binding SendSuggestionAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="ChatSuggestion" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="chat:ConversationTurn">
                <VerticalStackLayout Padding="16,6" AutomationId="ChatTurn">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RequestBlocks}"
                                         BindableLayout.ItemTemplateSelector="{StaticResource BlockTemplates}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResponseBlocks}"
                                         BindableLayout.ItemTemplateSelector="{StaticResource BlockTemplates}" />

                    <!-- A failed response: why it failed, and Retry while it is the last turn. -->
                    <Border Style="{StaticResource ErrorCardStyle}" IsVisible="{Binding IsFailed}"
                            AutomationId="TurnFailed">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Error, Converter={StaticResource TurnError}}"
                                   TextColor="{AppThemeBinding Light={StaticResource ErrorText}, Dark={StaticResource ErrorTextDark}}"
                                   LineBreakMode="WordWrap" AutomationId="TurnError" />
                            <Button Text="Retry" HorizontalOptions="Start" HeightRequest="36" Padding="14,0"
                                    Command="{Binding RetryAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="RetryButton" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Whether it was stopped, the model that answered and the tokens it used. -->
                    <Label Style="{StaticResource CardDetail}" Margin="0,2,0,0"
                           IsVisible="{Binding Text, Source={RelativeSource Self}, Converter={StaticResource HasValue}, x:DataType=Label}"
                           AutomationId="TurnFooter">
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource TurnFooter}">
                                <Binding Path="ModelId" />
                                <Binding Path="Usage" />
                                <Binding Path="IsStopped" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
