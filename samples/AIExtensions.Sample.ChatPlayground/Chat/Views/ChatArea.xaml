<?xml version="1.0" encoding="utf-8" ?>
<!--
    The conversation: a CollectionView over the conversation's rows (ConversationItems), so it creates, measures and
    recycles the view of each block on its own, and a long conversation costs only the rows on screen. Each turn is its
    request and response blocks, then a row of its own once it ended, which says whether it was stopped, or why it
    failed with Retry. The templates of all of them are in ChatTemplates.xaml.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="http://schemas.microsoft.com/dotnet/2026/maui/ai/chat"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.ChatArea"
             x:DataType="local:ChatViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:ChatTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <CollectionView ItemsSource="{Binding Items}"
                    ItemTemplate="{StaticResource BlockTemplates}"
                    ItemsUpdatingScrollMode="KeepLastItemInView"
                    SelectionMode="None"
                    Margin="16,0"
                    AutomationId="Conversation">

        <!-- Before the first message: what to do, and prompts to try. -->
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="28" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center"
                                 MaximumWidthRequest="560" AutomationId="ChatWelcome">
                <Label Text="{Binding WelcomeTitle}" FontSize="18" HorizontalTextAlignment="Center" />
                <Label Text="{Binding WelcomeMessage}" Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Suggestions}" Wrap="Wrap"
                            JustifyContent="Center" Margin="0,8,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}" Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                                    Command="{Binding SendSuggestionAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="ChatSuggestion" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentView>
