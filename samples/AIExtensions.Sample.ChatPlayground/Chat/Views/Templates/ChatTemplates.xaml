<?xml version="1.0" encoding="utf-8" ?>
<!--
    How each block of a conversation looks. The chat area lays out every turn's request and response blocks with the
    BlockTemplateSelector below, which uses the first template whose When matches a block: the specific templates come
    first. A block that no template matches shows nothing. An approval shows the card of its call, picked the same way,
    inside the approval wrapper's Approve and Reject.

    The templates bind to their block, which raises PropertyChanged as it streams and as its call runs, so they update in
    place. Buttons call the chat's view model, found with RelativeSource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="http://schemas.microsoft.com/dotnet/2026/maui/ai/chat"
                    xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                    x:Class="AIExtensions.Sample.ChatPlayground.ChatTemplates">

    <local:ToolArgumentsConverter x:Key="ToolArguments" />
    <local:ToolResultConverter x:Key="ToolResult" />
    <local:ApprovalStatusConverter x:Key="ApprovalStatus" />
    <local:MediaImageConverter x:Key="MediaImage" />
    <local:HasValueConverter x:Key="HasValue" />
    <local:BoldTextConverter x:Key="BoldText" />

    <chat:BlockTemplateSelector x:Key="BlockTemplates">

        <!--
            A call that waits for approval: the call's own card, from the templates below, then Approve and Reject
            while the call waits, or the decision once it no longer does. The chrome binds to the approval, and the
            card in its ContentPresenter to the call; a card finds the approval around it with RelativeSource.
        -->
        <chat:BlockTemplateSelector.Wrappers>
            <chat:ApprovalWrapper>
                <ControlTemplate x:DataType="chat:ToolApprovalBlock">
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,4" AutomationId="ApprovalCard">
                        <ContentPresenter />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsAwaitingInput}">
                            <Button Text="Approve" HeightRequest="36" Padding="14,0"
                                    Command="{Binding ApproveAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="ApproveButton" />
                            <Button Text="Reject" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RejectAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="RejectButton" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Status, Converter={StaticResource ApprovalStatus}}"
                               Style="{StaticResource CardCaption}" AutomationId="ApprovalStatus">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAwaitingInput}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </ControlTemplate>
            </chat:ApprovalWrapper>
        </chat:BlockTemplateSelector.Wrappers>

        <!-- What the user typed: a bubble on the right. -->
        <chat:BlockTemplate>
            <chat:BlockTemplate.When>
                <chat:AllMatch>
                    <chat:BlockTypeMatch Type="chat:RichContentBlock" />
                    <chat:RoleMatch Role="user" />
                </chat:AllMatch>
            </chat:BlockTemplate.When>
            <DataTemplate x:DataType="chat:RichContentBlock">
                <Border Style="{StaticResource UserBubbleStyle}" AutomationId="UserMessage">
                    <Label Text="{Binding RawText}" LineBreakMode="WordWrap" />
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

        <!-- An image the user sent, on the right, or one the model generated, on the left. -->
        <chat:BlockTemplate>
            <chat:BlockTemplate.When>
                <chat:AllMatch>
                    <chat:BlockTypeMatch Type="chat:MediaContentBlock" />
                    <chat:RoleMatch Role="user" />
                </chat:AllMatch>
            </chat:BlockTemplate.When>
            <DataTemplate x:DataType="chat:MediaContentBlock">
                <Image Source="{Binding Content, Converter={StaticResource MediaImage}}"
                       HorizontalOptions="End" Margin="0,4" WidthRequest="220" MaximumHeightRequest="240"
                       Aspect="AspectFit" AutomationId="UserImage" />
            </DataTemplate>
        </chat:BlockTemplate>
        <chat:BlockTemplate When="{chat:Is chat:MediaContentBlock}">
            <DataTemplate x:DataType="chat:MediaContentBlock">
                <Image Source="{Binding Content, Converter={StaticResource MediaImage}}"
                       HorizontalOptions="Start" Margin="0,4" WidthRequest="280" MaximumHeightRequest="280"
                       Aspect="AspectFit" AutomationId="ResponseImage" />
            </DataTemplate>
        </chat:BlockTemplate>

        <!-- Assistant text that is a JSON object, such as a structured response: its own card. -->
        <chat:BlockTemplate Template="{chat:ViewTemplate local:StructuredResponseView}">
            <chat:BlockTemplate.When>
                <local:StructuredResponseMatch />
            </chat:BlockTemplate.When>
        </chat:BlockTemplate>

        <!-- Reasoning sent only encrypted has no text: a template without a view shows nothing. -->
        <chat:BlockTemplate>
            <chat:BlockTemplate.When>
                <local:EncryptedReasoningMatch />
            </chat:BlockTemplate.When>
        </chat:BlockTemplate>

        <!-- The model's reasoning summary, muted, above its answer, with its **headings** in bold. -->
        <chat:BlockTemplate When="{chat:Is chat:ReasoningContentBlock}">
            <DataTemplate x:DataType="chat:ReasoningContentBlock">
                <VerticalStackLayout Spacing="2" Margin="0,4" AutomationId="Reasoning">
                    <Label Text="THINKING" Style="{StaticResource CardCaption}" />
                    <Label FormattedText="{Binding Text, Converter={StaticResource BoldText}}" Style="{StaticResource CardDetail}" />
                </VerticalStackLayout>
            </DataTemplate>
        </chat:BlockTemplate>

        <!-- The model's answer: plain text. -->
        <chat:BlockTemplate When="{chat:Is chat:RichContentBlock}">
            <DataTemplate x:DataType="chat:RichContentBlock">
                <Label Text="{Binding RawText}" LineBreakMode="WordWrap" Margin="0,4" AutomationId="AssistantMessage" />
            </DataTemplate>
        </chat:BlockTemplate>

        <!--
            Every calculation of a response on one worksheet, a row per calculate call, which fills in as the results
            arrive. A row still waiting when its turn stopped or failed will never get its result, so it says so; the
            row is not an engine block, so it reads that from its turn. A calculation that needs approval has a
            worksheet of its own inside the approval, which doesn't spin while it waits for the decision.
        -->
        <chat:BlockTemplate When="{chat:Is local:CalculatorWorksheetBlock}">
            <DataTemplate x:DataType="local:CalculatorWorksheetBlock">
                <Border Style="{StaticResource ToolCardStyle}" AutomationId="CalculatorWorksheet">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="CALCULATOR" Style="{StaticResource CardCaption}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CalculationRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                                          AutomationId="CalculationRow">
                                        <Label Text="{Binding Expression}" VerticalOptions="Center"
                                               AutomationId="CalculationExpression" />
                                        <Label Grid.Column="1" Text="{Binding Answer}" IsVisible="{Binding HasAnswer}"
                                               FontAttributes="Bold" VerticalOptions="Center"
                                               AutomationId="CalculationResult" />
                                        <ActivityIndicator Grid.Column="1" IsVisible="{Binding IsPending}"
                                                           IsRunning="{Binding IsPending}"
                                                           WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                           AutomationId="CalculationRunning">
                                            <ActivityIndicator.Triggers>
                                                <DataTrigger TargetType="ActivityIndicator" Value="True"
                                                             Binding="{Binding IsStopped, Source={RelativeSource AncestorType={x:Type chat:ConversationTurn}}, x:DataType=chat:ConversationTurn}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                    <Setter Property="IsRunning" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="ActivityIndicator" Value="True"
                                                             Binding="{Binding IsFailed, Source={RelativeSource AncestorType={x:Type chat:ConversationTurn}}, x:DataType=chat:ConversationTurn}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                    <Setter Property="IsRunning" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="ActivityIndicator" Value="True"
                                                             Binding="{Binding IsAwaitingInput, Source={RelativeSource AncestorType={x:Type chat:ToolApprovalBlock}}, x:DataType=chat:ToolApprovalBlock}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                    <Setter Property="IsRunning" Value="False" />
                                                </DataTrigger>
                                            </ActivityIndicator.Triggers>
                                        </ActivityIndicator>
                                        <Label Grid.Column="1" Text="No result" IsVisible="False"
                                               Style="{StaticResource CardDetail}" VerticalOptions="Center"
                                               AutomationId="CalculationNoResult">
                                            <Label.Triggers>
                                                <MultiTrigger TargetType="Label">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsPending}" Value="True" />
                                                        <BindingCondition Value="True"
                                                                          Binding="{Binding IsStopped, Source={RelativeSource AncestorType={x:Type chat:ConversationTurn}}, x:DataType=chat:ConversationTurn}" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="IsVisible" Value="True" />
                                                </MultiTrigger>
                                                <MultiTrigger TargetType="Label">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsPending}" Value="True" />
                                                        <BindingCondition Value="True"
                                                                          Binding="{Binding IsFailed, Source={RelativeSource AncestorType={x:Type chat:ConversationTurn}}, x:DataType=chat:ConversationTurn}" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="IsVisible" Value="True" />
                                                </MultiTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <!-- Anything but a number: why it failed, in red, or that the call never ran. -->
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}"
                                               IsVisible="{Binding HasMessage}" Style="{StaticResource CardDetail}"
                                               Margin="0,2,0,0" AutomationId="CalculationMessage">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource ErrorText}, Dark={StaticResource ErrorTextDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

        <!--
            A get_connection_status call, as the typed block that its [ToolBlock] generates: online or offline, and how.
        -->
        <chat:BlockTemplate When="{chat:Is local:ConnectionStatusBlock}">
            <DataTemplate x:DataType="local:ConnectionStatusBlock">
                <Border Style="{StaticResource ToolCardStyle}" AutomationId="ConnectionCard">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="CONNECTION" Style="{StaticResource CardCaption}" VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1" IsRunning="True" WidthRequest="16" HeightRequest="16"
                                               VerticalOptions="Center">
                                <ActivityIndicator.Triggers>
                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding HasResult}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding IsAbandoned}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ActivityIndicator" Value="True"
                                                 Binding="{Binding IsAwaitingInput, Source={RelativeSource AncestorType={x:Type chat:ToolApprovalBlock}}, x:DataType=chat:ToolApprovalBlock}">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                </ActivityIndicator.Triggers>
                            </ActivityIndicator>
                        </Grid>
                        <Label Text="{Binding Summary}" IsVisible="{Binding HasResult}" FontAttributes="Bold"
                               AutomationId="ConnectionSummary" />
                        <Label Text="{Binding ConnectionTypes}" Style="{StaticResource CardDetail}"
                               IsVisible="{Binding Text, Source={RelativeSource Self}, Converter={StaticResource HasValue}, x:DataType=Label}"
                               AutomationId="ConnectionTypes" />
                        <Label Text="No result" IsVisible="{Binding IsAbandoned}" Style="{StaticResource CardDetail}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

        <!--
            The model's proposal for the shared notes: the proposed text, and Accept or Reject while the turn waits for
            the decision, which the notes bar can make too. Then what the model heard.
        -->
        <chat:BlockTemplate>
            <chat:BlockTemplate.When>
                <chat:AllMatch>
                    <chat:BlockTypeMatch Type="chat:UIActionBlock" />
                    <chat:ToolMatch Name="propose_notes" />
                </chat:AllMatch>
            </chat:BlockTemplate.When>
            <DataTemplate x:DataType="chat:UIActionBlock">
                <Border Style="{StaticResource ToolCardStyle}" AutomationId="NotesProposalCard">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PROPOSED NOTES" Style="{StaticResource CardCaption}" />
                        <Label Text="{Binding Call, Converter={StaticResource ToolArguments}, ConverterParameter=text}"
                               MaxLines="6" LineBreakMode="TailTruncation" FontSize="13" />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsAwaitingInput}">
                            <Button Text="Accept" HeightRequest="36" Padding="14,0"
                                    Command="{Binding Notes.AcceptProposalAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="AcceptProposalButton" />
                            <Button Text="Reject" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding Notes.RejectProposalAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="RejectProposalButton" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Result, Converter={StaticResource ToolResult}}" IsVisible="{Binding HasResult}"
                               Style="{StaticResource CardDetail}" AutomationId="ProposalResult" />
                        <Label Text="Not decided: the response ended first, so the notes did not change."
                               IsVisible="{Binding IsAbandoned}" Style="{StaticResource CardDetail}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

        <!-- An action that runs in the app, such as set_theme: Run while it waits for the user, then what it returned. -->
        <chat:BlockTemplate When="{chat:Is chat:UIActionBlock}">
            <DataTemplate x:DataType="chat:UIActionBlock">
                <Border Style="{StaticResource ToolCardStyle}" AutomationId="ActionCard">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ACTION" Style="{StaticResource CardCaption}" />
                        <Label Text="{Binding ToolName}" FontAttributes="Bold" />
                        <Label Text="{Binding Call, Converter={StaticResource ToolArguments}}"
                               IsVisible="{Binding Text, Source={RelativeSource Self}, Converter={StaticResource HasValue}, x:DataType=Label}"
                               Style="{StaticResource CardDetail}" />
                        <Button Text="Run" HorizontalOptions="Start" HeightRequest="36" Padding="14,0"
                                IsVisible="{Binding IsAwaitingInput}"
                                Command="{Binding RunAction, Source={RelativeSource AncestorType={x:Type local:ChatViewModel}}, x:DataType=local:ChatViewModel}"
                                CommandParameter="{Binding .}"
                                AutomationId="RunActionButton" />
                        <Label Text="{Binding Result, Converter={StaticResource ToolResult}}"
                               IsVisible="{Binding HasResult}" LineBreakMode="WordWrap" FontSize="13"
                               AutomationId="ActionResult" />
                        <Label Text="No result" IsVisible="{Binding IsAbandoned}" Style="{StaticResource CardDetail}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

        <!--
            Any other tool call: its name and arguments, a spinner while it runs, then its result, or "No result" once
            its turn ended without one.
        -->
        <chat:BlockTemplate When="{chat:Is chat:FunctionInvocationContentBlock}">
            <DataTemplate x:DataType="chat:FunctionInvocationContentBlock">
                <Border Style="{StaticResource ToolCardStyle}" AutomationId="ToolCard">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding ToolName}" FontAttributes="Bold" VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1" IsRunning="True" WidthRequest="16" HeightRequest="16"
                                               VerticalOptions="Center" AutomationId="ToolRunning">
                                <ActivityIndicator.Triggers>
                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding HasResult}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding IsAbandoned}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ActivityIndicator" Value="True"
                                                 Binding="{Binding IsAwaitingInput, Source={RelativeSource AncestorType={x:Type chat:ToolApprovalBlock}}, x:DataType=chat:ToolApprovalBlock}">
                                        <Setter Property="IsVisible" Value="False" />
                                        <Setter Property="IsRunning" Value="False" />
                                    </DataTrigger>
                                </ActivityIndicator.Triggers>
                            </ActivityIndicator>
                        </Grid>
                        <Label Text="{Binding Call, Converter={StaticResource ToolArguments}}"
                               IsVisible="{Binding Text, Source={RelativeSource Self}, Converter={StaticResource HasValue}, x:DataType=Label}"
                               Style="{StaticResource CardDetail}" AutomationId="ToolArguments" />
                        <Label Text="{Binding Result, Converter={StaticResource ToolResult}}"
                               IsVisible="{Binding HasResult}" LineBreakMode="WordWrap" FontSize="13"
                               AutomationId="ToolResult" />
                        <Label Text="No result" IsVisible="{Binding IsAbandoned}" Style="{StaticResource CardDetail}"
                               AutomationId="ToolNoResult" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </chat:BlockTemplate>

    </chat:BlockTemplateSelector>
</ResourceDictionary>
