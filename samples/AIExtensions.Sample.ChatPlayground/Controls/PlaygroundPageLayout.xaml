<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AIExtensions.Sample.ChatPlayground.Controls"
             x:Class="AIExtensions.Sample.ChatPlayground.Controls.PlaygroundPageLayout"
             x:Name="PlaygroundLayout"
             x:DataType="controls:PlaygroundPageLayout"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid SafeAreaEdges="None">
        <Grid x:Name="RootGrid" ColumnDefinitions="330,*" ColumnSpacing="12" Padding="12"
              SafeAreaEdges="Container">
            <BoxView x:Name="SettingsBackdrop" Grid.ColumnSpan="2" ZIndex="9"
                     Color="{AppThemeBinding Light={StaticResource OverlayScrim}, Dark={StaticResource OverlayScrimDark}}"
                     IsVisible="False" AutomationId="SettingsDismissOverlay">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CloseSettingsClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="SettingsPanel" Grid.Column="0" ZIndex="10"
                    Style="{StaticResource PlaygroundPanel}" AutomationId="SettingsSidebar">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="16,16,16,0" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SidebarTitle, Source={x:Reference PlaygroundLayout}}"
                               FontSize="20" FontAttributes="Bold" />
                        <ImageButton x:Name="CloseSettingsButton" Grid.Column="1" Source="close.png"
                                     IsVisible="False" Clicked="CloseSettingsClicked"
                                     Style="{StaticResource AttachmentButton}"
                                     SemanticProperties.Description="Close settings"
                                     AutomationId="CloseSettingsButton" />
                    </Grid>
                    <ContentView Grid.Row="1"
                                 Content="{Binding SettingsContent, Source={x:Reference PlaygroundLayout}}" />
                </Grid>
            </Border>

            <Grid x:Name="MainPanel" Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Border Style="{StaticResource PlaygroundPanel}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <ImageButton x:Name="OpenSettingsButton" Source="settings.png"
                                     IsVisible="False" Clicked="OpenSettingsClicked"
                                     Style="{StaticResource AttachmentButton}"
                                     SemanticProperties.Description="Open settings"
                                     AutomationId="OpenSettingsButton" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding HeaderTitle, Source={x:Reference PlaygroundLayout}}"
                                       FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                                       MaxLines="1" LineBreakMode="TailTruncation"
                                       AutomationId="PageTitleLabel" />
                                <controls:InfoTip Text="{Binding HeaderInfo, Source={x:Reference PlaygroundLayout}}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding HeaderStatus, Source={x:Reference PlaygroundLayout}}"
                                   Style="{StaticResource MutedLabel}" FontSize="12" MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   AutomationId="{Binding StatusAutomationId, Source={x:Reference PlaygroundLayout}}" />
                        </VerticalStackLayout>
                        <ContentView x:Name="HeaderActionsPresenter" Grid.Column="2"
                                     Content="{Binding HeaderActions, Source={x:Reference PlaygroundLayout}}" />
                    </Grid>
                </Border>
                <ContentView Grid.Row="1"
                             Content="{Binding MainContent, Source={x:Reference PlaygroundLayout}}" />
                <ContentView Grid.Row="2"
                             Content="{Binding InputContent, Source={x:Reference PlaygroundLayout}}" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>
