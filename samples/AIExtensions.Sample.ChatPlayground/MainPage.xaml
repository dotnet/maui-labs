<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:AIExtensions.Sample.ChatPlayground.ViewModels"
             xmlns:views="clr-namespace:AIExtensions.Sample.ChatPlayground.Views"
             x:Class="AIExtensions.Sample.ChatPlayground.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="IChatClient Playground"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid SafeAreaEdges="None">
        <Grid x:Name="RootGrid" RowDefinitions="*" Padding="12" ColumnSpacing="12" SafeAreaEdges="Container">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsColumn" Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <BoxView x:Name="SettingsBackdrop" Grid.ColumnSpan="2" ZIndex="9"
                     Color="{AppThemeBinding Light={StaticResource OverlayScrim}, Dark={StaticResource OverlayScrimDark}}"
                     IsVisible="False"
                     AutomationId="SettingsDismissOverlay">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SettingsBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="SettingsPanel" Grid.Column="0" ZIndex="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackground}, Dark={StaticResource PanelBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    AutomationId="SettingsSidebar">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="16,16,16,0" ColumnDefinitions="*,Auto">
                        <Label Text="Playground settings" FontSize="20" FontAttributes="Bold" />
                        <ImageButton x:Name="CloseSettingsButton" Grid.Column="1"
                                     Source="close.png" IsVisible="False"
                                     Clicked="CloseSettingsClicked"
                                     Style="{StaticResource AttachmentButton}"
                                     SemanticProperties.Description="Close settings"
                                     ToolTipProperties.Text="Close settings"
                                     AutomationId="CloseSettingsButton" />
                    </Grid>
                    <views:SettingsPane Grid.Row="1" BindingContext="{Binding Settings}" />
                </Grid>
            </Border>

            <Grid x:Name="ChatPanel" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackground}, Dark={StaticResource PanelBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12" Padding="16">
                    <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <ImageButton x:Name="OpenSettingsButton"
                                     Source="settings.png" IsVisible="False"
                                     Clicked="OpenSettingsClicked"
                                     Style="{StaticResource AttachmentButton}"
                                     SemanticProperties.Description="Open settings"
                                     ToolTipProperties.Text="Open settings"
                                     AutomationId="OpenSettingsButton" />
                        <VerticalStackLayout x:Name="HeaderContent" Grid.Column="1" Spacing="2">
                            <Label Text="IChatClient Playground" FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding Chat.StatusMessage}" FontSize="12"
                                   Style="{StaticResource MutedLabel}"
                                   AutomationId="RequestStatusLabel" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="2" VerticalOptions="Start">
                            <VerticalStackLayout Margin="4,0" Spacing="2">
                                <ImageButton Source="add.png"
                                             Style="{StaticResource ChatActionButton}"
                                             Command="{Binding NewChatCommand}"
                                             SemanticProperties.Description="Start a new chat and keep the current one in saved chats"
                                             ToolTipProperties.Text="New chat (the current chat stays in Chats)"
                                             AutomationId="NewChatButton" />
                                <Label Text="New" Style="{StaticResource ChatActionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Margin="4,0" Spacing="2">
                                <ImageButton x:Name="ExportChatButton" Source="export.png"
                                             Style="{StaticResource ChatActionButton}"
                                             Command="{Binding ExportChatCommand}"
                                             CommandParameter="{x:Reference ExportChatButton}"
                                             SemanticProperties.Description="Export the current chat as a JSON file"
                                             ToolTipProperties.Text="Export the current chat to a file"
                                             AutomationId="ExportChatButton" />
                                <Label Text="Export" Style="{StaticResource ChatActionLabel}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <views:ChatArea x:Name="ChatArea" Grid.Row="1" BindingContext="{Binding Chat}" />
            </Grid>
        </Grid>
        <views:ChatLibraryView BindingContext="{Binding Library}" ZIndex="20" />
    </Grid>
</ContentPage>
