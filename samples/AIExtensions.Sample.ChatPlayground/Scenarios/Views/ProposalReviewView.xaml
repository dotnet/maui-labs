<?xml version="1.0" encoding="utf-8" ?>
<!--
    Predictive state: the review card of the propose_document UI action. Accept or Reject adds "accepted" to the
    call's arguments and runs the action, which accepts or rejects the predictive state the panel shows.
-->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.ProposalReviewView"
                        AutomationId="ProposalReviewCard">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}"
            HorizontalOptions="Start" MinimumWidthRequest="280" MaximumWidthRequest="460">
        <VerticalStackLayout Spacing="10">
            <VerticalStackLayout Spacing="1">
                <Label x:Name="CaptionLabel" Style="{DynamicResource AIChat.Style.SecondaryText}"
                       FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" />
                <Label x:Name="TitleLabel" Style="{DynamicResource AIChat.Style.CardTitle}" FontSize="16"
                       AutomationId="ProposalTitle" />
            </VerticalStackLayout>
            <Label x:Name="MessageLabel" Style="{DynamicResource AIChat.Style.AssistantText}"
                   AutomationId="ProposalMessage" />
            <HorizontalStackLayout x:Name="ButtonsRow" Spacing="8">
                <Button Text="Reject" Clicked="RejectClicked"
                        Style="{DynamicResource AIChat.Style.SecondaryButton}"
                        AutomationId="ProposalRejectButton" />
                <Button Text="Accept" Clicked="AcceptClicked"
                        Style="{DynamicResource AIChat.Style.PrimaryButton}"
                        AutomationId="ProposalAcceptButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</local:ScenarioCardView>
