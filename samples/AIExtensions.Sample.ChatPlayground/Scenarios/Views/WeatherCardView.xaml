<?xml version="1.0" encoding="utf-8" ?>
<!--
    The typed get_weather card: a WeatherToolBlock, whose generated handler filled City from the call and the other
    properties from the result. It shows the city while the tool runs and the weather once it returns.
-->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.WeatherCardView"
                        AutomationId="WeatherCard">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}"
            HorizontalOptions="Start" MinimumWidthRequest="260" MaximumWidthRequest="420">
        <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
            <Label x:Name="GlyphLabel" FontSize="34" HorizontalTextAlignment="Center" VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="WEATHER" Style="{DynamicResource AIChat.Style.SecondaryText}"
                       FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" />
                <Label x:Name="CityLabel" Style="{DynamicResource AIChat.Style.CardTitle}" FontSize="16"
                       AutomationId="WeatherCardCity" />
                <HorizontalStackLayout x:Name="PendingRow" Spacing="8">
                    <ActivityIndicator x:Name="BusyIndicator" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"
                                       Color="{DynamicResource AIChat.Color.SecondaryText}" />
                    <Label x:Name="PendingLabel" Style="{DynamicResource AIChat.Style.SecondaryText}"
                           VerticalOptions="Center" AutomationId="WeatherCardStatus" />
                </HorizontalStackLayout>
                <Grid x:Name="ResultRow" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,2,0,0">
                    <Label x:Name="TemperatureLabel" Style="{DynamicResource AIChat.Style.AssistantText}"
                           FontSize="30" FontAttributes="Bold" VerticalOptions="Center"
                           AutomationId="WeatherCardTemperature" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label x:Name="ConditionsLabel" Style="{DynamicResource AIChat.Style.AssistantText}"
                               FontAttributes="Bold" />
                        <Label x:Name="DetailsLabel" Style="{DynamicResource AIChat.Style.SecondaryText}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</local:ScenarioCardView>
