<?xml version="1.0" encoding="utf-8" ?>
<!--
    Combined tool calls: one card for a WeatherComparisonBlock, which WeatherComparisonHandler fills with every
    get_weather call of a response. A row per city fills in as its result arrives.
-->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.WeatherComparisonView"
                        AutomationId="WeatherComparisonCard">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}"
            HorizontalOptions="Start" MinimumWidthRequest="320" MaximumWidthRequest="480">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="1">
                    <Label Text="WEATHER COMPARISON" Style="{DynamicResource AIChat.Style.SecondaryText}"
                           FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" />
                    <Label x:Name="HeadlineLabel" Style="{DynamicResource AIChat.Style.CardTitle}" FontSize="16"
                           AutomationId="WeatherComparisonHeadline" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                    <ActivityIndicator x:Name="BusyIndicator" WidthRequest="14" HeightRequest="14"
                                       VerticalOptions="Center"
                                       Color="{DynamicResource AIChat.Color.SecondaryText}" />
                    <Label x:Name="ProgressLabel" Style="{DynamicResource AIChat.Style.SecondaryText}"
                           FontSize="12" VerticalOptions="Center" AutomationId="WeatherComparisonProgress" />
                </HorizontalStackLayout>
            </Grid>
            <VerticalStackLayout x:Name="RowsLayout" Spacing="0" />
        </VerticalStackLayout>
    </Border>
</local:ScenarioCardView>
