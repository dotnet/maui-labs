<?xml version="1.0" encoding="utf-8" ?>
<!--
    Frontend tools: set_accent_color is a UI action the app runs as soon as the model calls it. This chip shows that it
    ran in the app, with the color it set.
-->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.AccentActionView"
                        AutomationId="AccentActionChip">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}" Padding="12,8" HorizontalOptions="Start">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
            <Border x:Name="Swatch" WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11"
                    StrokeThickness="1" Stroke="{DynamicResource AIChat.Color.Stroke}" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label x:Name="TitleLabel" Style="{DynamicResource AIChat.Style.AssistantText}" FontSize="13"
                       AutomationId="AccentActionText" />
                <Label x:Name="DetailLabel" Style="{DynamicResource AIChat.Style.SecondaryText}" FontSize="12" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</local:ScenarioCardView>
