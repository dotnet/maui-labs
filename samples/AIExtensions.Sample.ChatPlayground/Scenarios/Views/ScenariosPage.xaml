<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.ScenariosPage"
             x:DataType="local:ScenariosViewModel"
             Title="Agentic"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <local:PlaygroundPageLayout x:Name="ScenariosLayout"
                                HeaderTitle="{Binding Selected.Title}"
                                HeaderInfo="{Binding Selected.Scenario.Description}"
                                HeaderStatus="{Binding Selected.StatusMessage}"
                                StatusAutomationId="ScenarioStatusLabel"
                                SidebarTitle="Scenarios"
                                SidebarIcon="list.png"
                                TitleBelowActionsWhenCompact="True"
                                Diagnostics="{Binding Diagnostics}"
                                DiagnosticsAutomationPrefix="Scenario">
        <local:PlaygroundPageLayout.HeaderActions>
            <HorizontalStackLayout Spacing="4">
                <VerticalStackLayout Spacing="2">
                    <ImageButton Source="add.png" Style="{StaticResource ChatActionButton}"
                                 Command="{Binding Selected.NewConversationAction}"
                                 SemanticProperties.Description="Start a new conversation in this scenario"
                                 ToolTipProperties.Text="Start a new conversation in this scenario"
                                 AutomationId="ScenarioNewButton" />
                    <Label Text="New" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2" IsVisible="{Binding Selected.IsNotReplaying}">
                    <ImageButton Source="play.png" Style="{StaticResource ChatActionButton}"
                                 Command="{Binding Selected.PlayExampleAction}"
                                 SemanticProperties.Description="Replay a recorded run of this scenario without contacting a model"
                                 ToolTipProperties.Text="Replay a recorded run of this scenario without contacting a model"
                                 AutomationId="ScenarioExampleButton" />
                    <Label Text="Example" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2" IsVisible="{Binding Selected.IsReplaying}">
                    <ImageButton Source="stop.png" Style="{StaticResource ChatActionButton}"
                                 Command="{Binding Selected.StopReplayAction}"
                                 SemanticProperties.Description="Stop replaying the example"
                                 AutomationId="ScenarioStopReplayButton" />
                    <Label Text="Stop" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </local:PlaygroundPageLayout.HeaderActions>

        <local:PlaygroundPageLayout.SettingsContent>
            <ScrollView>
                <!-- On iOS the tab bar floats over the bottom of the list, so the last scenario scrolls clear of it. -->
                <VerticalStackLayout Padding="{OnPlatform Default='16,12,16,16', iOS='16,12,16,96'}" Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="CLIENT" Style="{StaticResource SectionHeading}" />
                        <Picker Style="{StaticResource InputPicker}" ItemsSource="{Binding LiveClients}"
                                ItemDisplayBinding="{Binding Descriptor.DisplayName, x:DataType=local:ChatClientOption}"
                                SelectedItem="{Binding SelectedClient}"
                                IsEnabled="{Binding CanSelectClient}"
                                IsVisible="{Binding HasLiveClients}"
                                SemanticProperties.Description="The client the scenarios send their requests to"
                                AutomationId="ScenarioClientPicker" />
                        <Label Text="Scenarios with tools need a tool-capable model, such as Azure OpenAI. Each scenario's Example replays a recorded run offline."
                               Style="{StaticResource MutedLabel}" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SCENARIOS" Style="{StaticResource SectionHeading}" Margin="0,0,0,2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ScenarioItem">
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,8"
                                            BackgroundColor="Transparent"
                                            SemanticProperties.Description="{Binding Title}"
                                            SemanticProperties.Hint="{Binding Summary}"
                                            AutomationId="{Binding AutomationId}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{AppThemeBinding Light={StaticResource SelectedItemBackground}, Dark={StaticResource SelectedItemBackgroundDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="ScenarioTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                                            <Label Text="{Binding Glyph}" FontSize="18" VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </local:PlaygroundPageLayout.SettingsContent>

        <local:PlaygroundPageLayout.MainContent>
            <!-- The selected scenario's workspace: its chat, and a panel when it has state to show. -->
            <ContentView x:Name="ScenarioHost" AutomationId="ScenarioWorkspace" />
        </local:PlaygroundPageLayout.MainContent>
    </local:PlaygroundPageLayout>
</ContentPage>
