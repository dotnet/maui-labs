<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.AccentPanel"
             x:DataType="local:AccentColorController"
             AutomationId="AccentPanel">
    <!-- What set_accent_color changed: this scenario's AIChat.Color.Accent. -->
    <VerticalStackLayout Padding="16,0,16,16" Spacing="12">
        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
            <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                    BackgroundColor="{DynamicResource AIChat.Color.Accent}"
                    AutomationId="AccentSwatch" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding Description}" FontSize="18" FontAttributes="Bold"
                       AutomationId="AccentDescription" />
                <Label Text="The chat's accent: send button, primary buttons and progress."
                       Style="{StaticResource MutedLabel}" FontSize="12" />
            </VerticalStackLayout>
        </Grid>
        <Label Style="{StaticResource MutedLabel}" FontSize="12"
               Text="set_accent_color runs the moment the model calls it. reset_accent_color waits until you press Run on its card." />
    </VerticalStackLayout>
</ContentView>
