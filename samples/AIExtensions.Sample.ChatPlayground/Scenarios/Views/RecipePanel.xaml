<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.RecipePanel"
             x:DataType="local:RecipeEditorViewModel"
             AutomationId="RecipePanel">
    <!--
        The shared recipe: the agent's typed state, UIAgent<RecipeState>.State. Edits become the state at once and
        reach the model with the next message; update_recipe calls from the model replace it.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="16,0,16,16" Spacing="12" IsEnabled="{Binding IsEditable}">
            <Label Text="{Binding LastChange}" Style="{StaticResource MutedLabel}" FontSize="12"
                   AutomationId="RecipeLastChange" />
            <Entry Text="{Binding Title}" Placeholder="Recipe title" FontAttributes="Bold"
                   SemanticProperties.Description="Recipe title" AutomationId="RecipeTitleEntry" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="SKILL" Style="{StaticResource SectionHeading}" FontSize="11" />
                    <Picker Style="{StaticResource InputPicker}" ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding SkillLevel}"
                            SemanticProperties.Description="Skill level" AutomationId="RecipeSkillPicker" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="TIME" Style="{StaticResource SectionHeading}" FontSize="11" />
                    <Picker Style="{StaticResource InputPicker}" ItemsSource="{Binding CookingTimes}" SelectedItem="{Binding CookingTime}"
                            SemanticProperties.Description="Cooking time" AutomationId="RecipeTimePicker" />
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="PREFERENCES" Style="{StaticResource SectionHeading}" FontSize="11" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Preferences}" Wrap="Wrap" AlignItems="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:RecipePreference">
                            <HorizontalStackLayout Spacing="2" Margin="0,0,14,2">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"
                                          WidthRequest="{OnPlatform 44, MacCatalyst=32, WinUI=32}"
                                          SemanticProperties.Description="{Binding Name}"
                                          AutomationId="{Binding AutomationId}" />
                                <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="INGREDIENTS" Style="{StaticResource SectionHeading}" FontSize="11" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="6"
                                     AutomationId="RecipeIngredients">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:RecipeIngredientRow">
                            <Grid ColumnDefinitions="40,84,*,36" ColumnSpacing="6">
                                <Entry Text="{Binding Icon}" HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="Ingredient emoji" />
                                <Entry Grid.Column="1" Text="{Binding Amount}" Placeholder="Amount"
                                       SemanticProperties.Description="Amount" />
                                <Entry Grid.Column="2" Text="{Binding Name}" Placeholder="Ingredient"
                                       SemanticProperties.Description="Ingredient" />
                                <Button Grid.Column="3" Text="&#x2715;" Style="{StaticResource SecondaryButtonStyle}"
                                        WidthRequest="36" Padding="0" FontSize="13" VerticalOptions="Center"
                                        Command="{Binding RemoveIngredientAction, Source={RelativeSource AncestorType={x:Type local:RecipeEditorViewModel}}, x:DataType=local:RecipeEditorViewModel}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="{Binding Name, StringFormat='Remove {0}'}"
                                        ToolTipProperties.Text="Remove this ingredient" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="+ Add ingredient" Command="{Binding AddIngredientAction}"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationId="RecipeAddIngredientButton" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="STEPS (ONE PER LINE)" Style="{StaticResource SectionHeading}" FontSize="11" />
                <Editor Text="{Binding Instructions}" AutoSize="TextChanges" MinimumHeightRequest="110"
                        FontSize="13" SemanticProperties.Description="Recipe steps, one per line"
                        AutomationId="RecipeStepsEditor" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
