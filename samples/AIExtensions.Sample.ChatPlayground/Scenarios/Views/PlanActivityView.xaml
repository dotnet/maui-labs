<?xml version="1.0" encoding="utf-8" ?>
<!--
    Activity progress: the plan as one activity that updates in place. PlanActivityHandler maps create_plan and
    update_plan_step into a PlanActivityBlock, so the calls show here rather than as tool cards.
-->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.PlanActivityView"
                        AutomationId="PlanActivityCard">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}"
            HorizontalOptions="Start" MinimumWidthRequest="280" MaximumWidthRequest="480">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="1">
                    <Label x:Name="CaptionLabel" Style="{DynamicResource AIChat.Style.SecondaryText}"
                           FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" />
                    <Label x:Name="HeadlineLabel" Style="{DynamicResource AIChat.Style.CardTitle}" FontSize="16"
                           AutomationId="PlanActivityHeadline" />
                </VerticalStackLayout>
                <Label x:Name="CountLabel" Grid.Column="1" Style="{DynamicResource AIChat.Style.SecondaryText}"
                       FontSize="12" VerticalOptions="Start" AutomationId="PlanActivityCount" />
            </Grid>
            <ProgressBar x:Name="Bar" ProgressColor="{DynamicResource AIChat.Color.Accent}" />
            <VerticalStackLayout x:Name="StepsLayout" Spacing="8" />
        </VerticalStackLayout>
    </Border>
</local:ScenarioCardView>
