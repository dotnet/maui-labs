<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared state: where the agent called update_recipe, a short note instead of a tool card; the panel shows the recipe. -->
<local:ScenarioCardView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
                        x:Class="AIExtensions.Sample.ChatPlayground.RecipeUpdateView"
                        AutomationId="RecipeUpdateChip">
    <Border x:Name="Card" Style="{DynamicResource AIChat.Style.Card}" Padding="12,8" HorizontalOptions="Start">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
            <Label Text="&#x1F373;" FontSize="17" HorizontalTextAlignment="Center" VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label x:Name="TitleLabel" Style="{DynamicResource AIChat.Style.AssistantText}" FontSize="13"
                       AutomationId="RecipeUpdateText" />
                <Label x:Name="DetailLabel" Style="{DynamicResource AIChat.Style.SecondaryText}" FontSize="12" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</local:ScenarioCardView>
