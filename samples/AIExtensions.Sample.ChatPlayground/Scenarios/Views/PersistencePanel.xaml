<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.PersistencePanel"
             x:DataType="local:PersistencePanelViewModel"
             AutomationId="PersistencePanel">
    <!-- Where the conversation thread (options.Thread) saves this conversation, and a way to read it back. -->
    <VerticalStackLayout Padding="16,0,16,16" Spacing="10">
        <Label Text="{Binding Summary}" FontAttributes="Bold" AutomationId="PersistenceSummary" />
        <Label Text="{Binding FilePath}" Style="{StaticResource MutedLabel}" FontSize="12"
               LineBreakMode="CharacterWrap" AutomationId="PersistenceFilePath" />
        <Button Text="Reload from disk" Command="{Binding ReloadAction}"
                Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Start"
                AutomationId="PersistenceReloadButton" />
        <Label Style="{StaticResource MutedLabel}" FontSize="12"
               Text="Each completed turn is saved as the raw response updates. Quit the app and open this scenario again, or reload: the conversation comes back exactly as it was, cards included. New conversation clears the file." />
    </VerticalStackLayout>
</ContentView>
