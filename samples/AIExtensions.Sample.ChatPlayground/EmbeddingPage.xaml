<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:AIExtensions.Sample.ChatPlayground.ViewModels"
             xmlns:views="clr-namespace:AIExtensions.Sample.ChatPlayground.Views"
             xmlns:controls="clr-namespace:AIExtensions.Sample.ChatPlayground.Controls"
             xmlns:documents="clr-namespace:AIExtensions.Sample.ChatPlayground.Features.Embeddings"
             x:Class="AIExtensions.Sample.ChatPlayground.EmbeddingPage"
             x:DataType="viewModels:EmbeddingPlaygroundViewModel"
             Title="Embeddings"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <controls:PlaygroundPageLayout HeaderTitle="Embeddings"
                                       HeaderInfo="IEmbeddingGenerator indexes imported Markdown or text documents. Search uses that same model's stored vectors; documents never become chats."
                                       HeaderStatus="{Binding StatusMessage}"
                                       StatusAutomationId="EmbeddingStatusLabel"
                                       SidebarTitle="Embedding settings">
            <controls:PlaygroundPageLayout.HeaderActions>
                <VerticalStackLayout Spacing="2">
                    <ImageButton Source="folder.png" Style="{StaticResource ChatActionButton}"
                                 SemanticProperties.Description="Import a Markdown or text document"
                                 AutomationId="ImportDocumentButton">
                        <controls:PopupMenu.Content>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="IMPORT DOCUMENT" Style="{StaticResource SectionHeading}" />
                                <Button Text="Choose file" Clicked="ImportDocumentClicked"
                                        AutomationId="ChooseDocumentButton" />
                                <Button Text="Use sample document" Clicked="ImportSampleDocumentClicked"
                                        AutomationId="SampleDocumentButton" />
                            </VerticalStackLayout>
                        </controls:PopupMenu.Content>
                    </ImageButton>
                    <Label Text="Import" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
            </controls:PlaygroundPageLayout.HeaderActions>
            <controls:PlaygroundPageLayout.SettingsContent>
                <views:EmbeddingSettingsPane BindingContext="{Binding Settings}" />
            </controls:PlaygroundPageLayout.SettingsContent>
            <controls:PlaygroundPageLayout.MainContent>
                <Border Style="{StaticResource ComposerPanel}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <Label Text="{Binding ResultsHeading}" Style="{StaticResource SectionHeading}" />
                        <Grid Grid.Row="1">
                            <CollectionView ItemsSource="{Binding Documents}"
                                            ItemSizingStrategy="MeasureAllItems"
                                            AutomationId="ImportedDocuments">
                                <CollectionView.Triggers>
                                    <DataTrigger TargetType="CollectionView"
                                                 Binding="{Binding ShowingSearchResults}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </CollectionView.Triggers>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="documents:ImportedDocument">
                                        <Border Margin="0,3" Padding="10" StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Details}" Style="{StaticResource MutedLabel}"
                                                       FontSize="11" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="Import a Markdown or plain text document to begin."
                                           Style="{StaticResource MutedLabel}" Margin="12"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="DocumentsEmptyLabel" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                            <CollectionView ItemsSource="{Binding Results}"
                                            IsVisible="{Binding ShowingSearchResults}"
                                            ItemSizingStrategy="MeasureAllItems"
                                            AutomationId="EmbeddingSearchResults">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="documents:DocumentSearchHit">
                                        <Border Margin="0,3" Padding="10" StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Snippet}" Style="{StaticResource MutedLabel}"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Details}" Style="{StaticResource MutedLabel}"
                                                       FontSize="11" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="No indexed documents match."
                                           Style="{StaticResource MutedLabel}" Margin="12"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EmbeddingResultsEmptyLabel" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                               Color="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               AutomationId="EmbeddingLoading" />
                        </Grid>
                    </Grid>
                </Border>
            </controls:PlaygroundPageLayout.MainContent>
            <controls:PlaygroundPageLayout.InputContent>
                <Border Style="{StaticResource ComposerPanel}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding Query}" Placeholder="Search imported documents"
                               ReturnCommand="{Binding Search}" ReturnType="Search"
                               AutomationId="EmbeddingSearchEntry" />
                        <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44">
                            <ImageButton Source="search.png" Command="{Binding Search}"
                                         IsVisible="{Binding IsIdle}"
                                         Style="{StaticResource AttachmentButton}"
                                         SemanticProperties.Description="Search documents"
                                         AutomationId="EmbeddingSearchButton" />
                            <ImageButton Source="stop.png" Command="{Binding CancelSearch}"
                                         IsVisible="{Binding IsBusy}"
                                         Style="{StaticResource CancelActionButton}"
                                         SemanticProperties.Description="Cancel document search"
                                         AutomationId="CancelEmbeddingButton" />
                        </Grid>
                    </Grid>
                </Border>
            </controls:PlaygroundPageLayout.InputContent>
        </controls:PlaygroundPageLayout>
    </Grid>
</ContentPage>
