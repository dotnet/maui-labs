<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentPage"
             x:DataType="local:DocumentPlaygroundViewModel"
             Title="Documents"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <local:PlaygroundPageLayout HeaderTitle="Documents"
                                    HeaderInfo="IDocumentExtractionClient returns structured pages, text, tables, figures, geometry, metadata, and provider raw data. Compare local Apple Vision, Foundry Mistral OCR 4, and a general Foundry vision model; no hidden fallback is used."
                                    HeaderStatus="{Binding StatusMessage}"
                                    StatusAutomationId="DocumentStatusLabel"
                                    SidebarTitle="Document settings">
            <local:PlaygroundPageLayout.SettingsContent>
                <local:DocumentSettingsPane />
            </local:PlaygroundPageLayout.SettingsContent>
            <local:PlaygroundPageLayout.MainContent>
                <local:DocumentArea />
            </local:PlaygroundPageLayout.MainContent>
            <local:PlaygroundPageLayout.InputContent>
                <local:DocumentComposer />
            </local:PlaygroundPageLayout.InputContent>
        </local:PlaygroundPageLayout>
    </Grid>
</ContentPage>
