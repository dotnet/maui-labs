<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentPage"
             x:DataType="local:DocumentPlaygroundViewModel"
             Title="Documents"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <local:PlaygroundPageLayout HeaderTitle="Documents"
                                    HeaderInfo="Choose an IngestionDocumentReader in settings. Select one file, then read it with Apple Vision on-device or upload it to the selected Azure reader. Switch readers to compare."
                                    HeaderStatus="{Binding StatusMessage}"
                                    StatusAutomationId="DocumentStatusLabel"
                                    SidebarTitle="Document settings">
            <local:PlaygroundPageLayout.SettingsContent>
                <local:DocumentSettingsPane BindingContext="{Binding Settings}" />
            </local:PlaygroundPageLayout.SettingsContent>
            <local:PlaygroundPageLayout.MainContent>
                <Border Style="{StaticResource ComposerPanel}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label Text="{Binding ResultHeading}" Style="{StaticResource SectionHeading}"
                               AutomationId="DocumentResultHeading" />
                        <ScrollView Grid.Row="1" AutomationId="DocumentResultsScroll">
                            <Grid>
                                <Label Text="Choose a PDF or image and run the selected reader to see pages, elements, and Markdown."
                                       Style="{StaticResource MutedLabel}" AutomationId="DocumentEmptyLabel">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasResult}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding ResultOutput}" IsVisible="{Binding HasResult}"
                                       LineBreakMode="WordWrap" AutomationId="DocumentResultOutput" />
                            </Grid>
                        </ScrollView>
                        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           AutomationId="DocumentLoading" />
                    </Grid>
                </Border>
            </local:PlaygroundPageLayout.MainContent>
            <local:PlaygroundPageLayout.InputContent>
                <local:DocumentComposer ReadRequested="ReadClicked" />
            </local:PlaygroundPageLayout.InputContent>
        </local:PlaygroundPageLayout>
    </Grid>
</ContentPage>
