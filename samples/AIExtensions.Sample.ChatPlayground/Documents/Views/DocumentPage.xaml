<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentPage"
             x:DataType="local:DocumentPlaygroundViewModel"
             Title="Documents"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <local:PlaygroundPageLayout HeaderTitle="Documents"
                                    HeaderInfo="IDocumentExtractionClient returns structured pages, text, tables, figures, geometry, metadata, and provider raw data. Compare local Apple Vision, specialized Mistral OCR 4, and the configured vision-capable chat model."
                                    HeaderStatus="{Binding StatusMessage}"
                                    StatusAutomationId="DocumentStatusLabel"
                                    SidebarTitle="Document settings">
            <local:PlaygroundPageLayout.HeaderActions>
                <VerticalStackLayout Spacing="2">
                    <ImageButton Source="more.png"
                                 Style="{StaticResource ChatActionButton}"
                    SemanticProperties.Description="Inspect document client details and JSON"
                                 AutomationId="DocumentInspectButton">
                        <local:PopupMenu.Content>
                            <VerticalStackLayout WidthRequest="560"
                                                 Spacing="10"
                                                 x:DataType="local:DocumentPlaygroundViewModel">
                                <Label Text="DOCUMENT INSPECTOR"
                                       Style="{StaticResource SectionHeading}" />
                                <HorizontalStackLayout Spacing="8"
                                                       RadioButtonGroup.GroupName="DocumentInspectionMode"
                                                       RadioButtonGroup.SelectedValue="{Binding SelectedInspectionMode, Mode=TwoWay}">
                                    <RadioButton Content="Client"
                                                 Value="{x:Static local:DocumentInspectionMode.Client}"
                                                 AutomationId="DocumentInspectClientRadio" />
                                    <RadioButton Content="Normalized"
                                                 Value="{x:Static local:DocumentInspectionMode.NormalizedJson}"
                                                 IsEnabled="{Binding HasResult}"
                                                 AutomationId="DocumentInspectNormalizedRadio" />
                                    <RadioButton Content="Provider raw"
                                                 Value="{x:Static local:DocumentInspectionMode.RawJson}"
                                                 IsEnabled="{Binding HasResult}"
                                                 AutomationId="DocumentInspectRawRadio" />
                                    <RadioButton Content="Selected node"
                                                 Value="{x:Static local:DocumentInspectionMode.SelectedNodeJson}"
                                                 IsEnabled="{Binding CanInspectSelectedNode}"
                                                 AutomationId="DocumentInspectNodeRadio" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding InspectionTitle}"
                                       FontAttributes="Bold" />
                                <Editor Text="{Binding InspectionContent}"
                                        IsReadOnly="True"
                                        HeightRequest="390"
                                        FontFamily="Courier"
                                        FontSize="11"
                                        AutomationId="DocumentInspectionText" />
                                <Button Text="Copy"
                                        Command="{Binding CopyInspectionText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationId="CopyDocumentInspectionButton" />
                            </VerticalStackLayout>
                        </local:PopupMenu.Content>
                    </ImageButton>
                    <Label Text="Inspect" Style="{StaticResource ChatActionLabel}" />
                </VerticalStackLayout>
            </local:PlaygroundPageLayout.HeaderActions>
            <local:PlaygroundPageLayout.SettingsContent>
                <local:DocumentSettingsPane BindingContext="{Binding Settings}" />
            </local:PlaygroundPageLayout.SettingsContent>
            <local:PlaygroundPageLayout.MainContent>
                <local:DocumentArea />
            </local:PlaygroundPageLayout.MainContent>
            <local:PlaygroundPageLayout.InputContent>
                <local:DocumentComposer />
            </local:PlaygroundPageLayout.InputContent>
        </local:PlaygroundPageLayout>
    </Grid>
</ContentPage>
