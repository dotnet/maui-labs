<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentSettingsPane"
             x:DataType="local:DocumentSettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <HorizontalStackLayout Spacing="4">
                <Label Text="CLIENT"
                       Style="{StaticResource SectionHeading}"
                       VerticalOptions="Center" />
                <local:InfoTip Text="Each option is an independently registered IDocumentExtractionClient. Apple Vision stays on-device; Foundry clients send the selected document to Azure." />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="4"
                                 IsEnabled="{Binding CanSelectClient}"
                                 RadioButtonGroup.GroupName="DocumentClient"
                                 RadioButtonGroup.SelectedValue="{Binding SelectedOption, Mode=TwoWay}"
                                 BindableLayout.ItemsSource="{Binding Clients}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:DocumentClientOption">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <RadioButton HorizontalOptions="Fill"
                                         Content="{Binding Descriptor.Name}"
                                         Value="{Binding .}"
                                         AutomationId="{Binding AutomationId}" />
                            <local:InfoTip Grid.Column="1"
                                           Text="{Binding Descriptor.Description}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />

            <VerticalStackLayout Spacing="10"
                                 IsEnabled="{Binding CanEditOptions}">
                <Label Text="REQUEST OPTIONS" Style="{StaticResource SectionHeading}" />
                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="4"
                      RowSpacing="8">
                    <CheckBox IsChecked="{Binding DetectBarcodes}"
                              WidthRequest="{OnPlatform 44, MacCatalyst=32, WinUI=32}"
                              AutomationId="DocumentDetectBarcodesCheckBox" />
                    <Label Grid.Column="1" Text="Detect barcodes"
                           VerticalOptions="Center" />
                    <local:InfoTip Grid.Column="2"
                                   Text="Ask providers that support barcode recognition to return barcode elements." />

                    <CheckBox Grid.Row="1"
                              IsChecked="{Binding AutomaticallyDetectLanguage}"
                              WidthRequest="{OnPlatform 44, MacCatalyst=32, WinUI=32}"
                              AutomationId="DocumentAutomaticLanguageCheckBox" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="Detect language"
                           VerticalOptions="Center" />
                    <local:InfoTip Grid.Row="1" Grid.Column="2"
                                   Text="Let providers identify recognized languages when supported." />

                    <CheckBox Grid.Row="2"
                              IsChecked="{Binding IncludeImages}"
                              WidthRequest="{OnPlatform 44, MacCatalyst=32, WinUI=32}"
                              AutomationId="DocumentIncludeImagesCheckBox" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="Include figure images"
                           VerticalOptions="Center" />
                    <local:InfoTip Grid.Row="2" Grid.Column="2"
                                   Text="Request extracted figure bytes when the provider can return them. This can substantially increase response size." />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
