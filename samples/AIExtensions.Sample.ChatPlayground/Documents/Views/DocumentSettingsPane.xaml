<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentSettingsPane"
             x:DataType="local:DocumentSettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <HorizontalStackLayout Spacing="4">
                <Label Text="CLIENT"
                       Style="{StaticResource SectionHeading}"
                       VerticalOptions="Center" />
                <local:InfoTip Text="Each option is an independently registered IDocumentExtractionClient. Apple Vision stays on-device; Foundry clients send the selected document to Azure." />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="4"
                                 IsEnabled="{Binding CanSelectClient}"
                                 RadioButtonGroup.GroupName="DocumentClient"
                                 RadioButtonGroup.SelectedValue="{Binding SelectedOption, Mode=TwoWay}"
                                 BindableLayout.ItemsSource="{Binding Clients}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:DocumentClientOption">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <RadioButton HorizontalOptions="Fill"
                                         Content="{Binding Descriptor.Name}"
                                         Value="{Binding .}"
                                         AutomationId="{Binding AutomationId}" />
                            <local:InfoTip Grid.Column="1"
                                           Text="{Binding Descriptor.Description}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding HasRequestOptions}"
                                 IsEnabled="{Binding CanEditOptions}">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />
                <Label Text="REQUEST OPTIONS" Style="{StaticResource SectionHeading}" />

                <VerticalStackLayout Spacing="8"
                                     BindableLayout.ItemsSource="{Binding RequestOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:DocumentBooleanOption">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                <CheckBox IsChecked="{Binding Value}"
                                          WidthRequest="{OnPlatform 44, MacCatalyst=32, WinUI=32}"
                                          AutomationId="{Binding AutomationId}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                                <local:InfoTip Grid.Column="2"
                                               Text="{Binding Description}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
