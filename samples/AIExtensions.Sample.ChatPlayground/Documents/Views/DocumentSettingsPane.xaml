<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentSettingsPane"
             x:DataType="local:DocumentSettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="CLIENT" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout Spacing="4" IsEnabled="{Binding IsIdle}"
                                 RadioButtonGroup.GroupName="DocumentExtractionClient"
                                 RadioButtonGroup.SelectedValue="{Binding SelectedClientOption, Mode=TwoWay}"
                                 BindableLayout.ItemsSource="{Binding Clients}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:DocumentExtractionClientOption">
                        <Grid ColumnDefinitions="*,Auto">
                            <RadioButton Content="{Binding Descriptor.DisplayName}" Value="{Binding .}"
                                         AutomationId="{Binding AutomationId}" />
                            <local:InfoTip Grid.Column="1" Text="{Binding Descriptor.Description}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Extraction returns one completed document. Native results are inspected only on request."
                   Style="{StaticResource MutedLabel}" />
            <VerticalStackLayout IsEnabled="{Binding IsIdle}">
                <Label Text="Extractor name (optional)" Style="{StaticResource MutedLabel}" />
                <Entry Text="{Binding ExtractorName}" AutomationId="DocumentExtractorNameEntry" />
                <Label Text="Leave blank to use the client's defaults. The selected client validates supported options."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />
            <Label Text="Clients are configured at startup. Select a client and extract the same file to compare results."
                   Style="{StaticResource MutedLabel}" FontSize="12"
                   AutomationId="DocumentClientSettingsInfo" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
