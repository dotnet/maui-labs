<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.ChatPlayground"
             x:Class="AIExtensions.Sample.ChatPlayground.DocumentArea"
             x:DataType="local:DocumentPlaygroundViewModel">
    <Border Style="{StaticResource ComposerPanel}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Label Text="{Binding ResultHeading}" Style="{StaticResource SectionHeading}"
                   AutomationId="DocumentResultHeading" />
            <ScrollView Grid.Row="1" AutomationId="DocumentResultsScroll">
                <Grid>
                    <Label Text="Choose a PDF or image, select the API and provider, then run it to inspect actual normalized output."
                           Style="{StaticResource MutedLabel}" AutomationId="DocumentEmptyLabel">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasResult}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding ResultOutput}" IsVisible="{Binding HasResult}"
                           LineBreakMode="WordWrap" AutomationId="DocumentResultOutput" />
                </Grid>
            </ScrollView>
            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center"
                               AutomationId="DocumentLoading" />
        </Grid>
    </Border>
</ContentView>
