<?xml version="1.0" encoding="utf-8" ?>
<chat:ChatContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chat="clr-namespace:Microsoft.Maui.Chat.Controls;assembly=Microsoft.Maui.Chat.Controls"
    x:Class="AIExtensions.Sample.Garden.GardenTaskView">
    <Border Padding="14"
            Margin="0,4"
            MaximumWidthRequest="420"
            HorizontalOptions="Start"
            BackgroundColor="{AppThemeBinding Light=#FFF8E7, Dark=#313025}"
            Stroke="{AppThemeBinding Light=#D5B65A, Dark=#8F7A38}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              RowSpacing="4">
            <Label Grid.RowSpan="4"
                   Text="&#xF295;"
                   FontFamily="FluentFilled"
                   FontSize="22"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Start" />
            <Label x:Name="SharedByLabel"
                   Grid.Column="1"
                   FontSize="{StaticResource FontSizeCaption}"
                   Opacity="0.65" />
            <Label x:Name="TitleLabel"
                   Grid.Row="1"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   FontSize="{StaticResource FontSizeBody}" />
            <Label x:Name="AssigneeLabel"
                   Grid.Row="2"
                   Grid.Column="1"
                   FontSize="{StaticResource FontSizeCaption}"
                   Opacity="0.75" />
            <Label x:Name="DueLabel"
                   Grid.Row="3"
                   Grid.Column="1"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextColor="{StaticResource Primary}" />
        </Grid>
    </Border>
</chat:ChatContentView>
