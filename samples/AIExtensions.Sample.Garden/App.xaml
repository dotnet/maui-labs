<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIExtensions.Sample.Garden.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- AI block colours remain AI-specific. The outer CopilotChatView shell now comes directly
                 from Microsoft.Maui.Chat.Controls, so ordinary MauiChat.* styles customize its chrome. -->
            <Style x:Key="MauiChat.Bubble.Incoming" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
            </Style>
            <Style x:Key="MauiChat.Bubble.Outgoing" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#5B8C5A" />
            </Style>
            <Style x:Key="MauiChat.Text.Incoming" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#2C2416" />
            </Style>
            <Style x:Key="MauiChat.Text.Outgoing" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#FFFFFF" />
            </Style>
            <Style x:Key="MauiChat.Suggestion" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BackgroundColor" Value="#E8F2E6" />
                <Setter Property="TextColor" Value="#3A5A3A" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
