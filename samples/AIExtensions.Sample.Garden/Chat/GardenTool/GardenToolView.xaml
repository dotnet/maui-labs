<?xml version="1.0" encoding="utf-8" ?>
<chat:ContentContextView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
                         xmlns:local="clr-namespace:AIExtensions.Sample.Garden.Chat"
                         x:Class="AIExtensions.Sample.Garden.Chat.GardenToolView"
                         x:Name="Root">

    <VerticalStackLayout Spacing="0" HorizontalOptions="Start"
                         BindingContext="{x:Reference Root}" x:DataType="local:GardenToolView">

        <!-- Header row: chevron (when expandable) + wrench + tool name. Tap to toggle. -->
        <HorizontalStackLayout Spacing="4" Padding="4,2">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
            </HorizontalStackLayout.GestureRecognizers>
            <Label Text="{Binding ExpandGlyph}"
                   IsVisible="{Binding HasDetails}"
                   FontFamily="FluentFilled"
                   FontSize="{StaticResource FontSizeCaption}"
                   WidthRequest="14"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
            <Label Text="&#xF8D9;"
                   FontFamily="FluentFilled"
                   FontSize="{StaticResource FontSizeCaption}"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            <Label Text="{Binding DisplayName}"
                   FontSize="{StaticResource FontSizeCaption}"
                   FontAttributes="Italic"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </HorizontalStackLayout>

        <!-- Expandable details: arguments + result -->
        <Border IsVisible="{Binding IsExpanded}"
                Margin="18,4,0,4"
                Padding="10,8"
                MaximumHeightRequest="300"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}">
            <ScrollView>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Arguments"
                           IsVisible="{Binding HasArgs}"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                    <Label Text="{Binding ArgsText}"
                           IsVisible="{Binding HasArgs}"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontFamily="Courier New"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="Result"
                           IsVisible="{Binding HasResult}"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                    <Label Text="{Binding ResultText}"
                           IsVisible="{Binding HasResult}"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontFamily="Courier New"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </VerticalStackLayout>

</chat:ContentContextView>
