<?xml version="1.0" encoding="utf-8" ?>
<chat:ContentContextView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
                         xmlns:local="clr-namespace:AIExtensions.Sample.Garden.Chat"
                         x:Class="AIExtensions.Sample.Garden.Chat.GardenFormattedTextView"
                         x:Name="Root">

    <chat:ContentContextView.Resources>
        <local:FormattedLineToFormattedStringConverter x:Key="LineToFormattedString" />
    </chat:ContentContextView.Resources>

    <!-- The neutral message chrome supplies the bubble, avatar, alignment, and metadata. -->
    <VerticalStackLayout Spacing="4"
                         BindingContext="{x:Reference Root}"
                         x:DataType="local:GardenFormattedTextView"
                         BindableLayout.ItemsSource="{Binding Lines}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="local:FormattedLine">
                <Label FormattedText="{Binding ., Converter={StaticResource LineToFormattedString}}"
                       LineBreakMode="WordWrap"
                       Style="{DynamicResource MauiChat.Text.Incoming}" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</chat:ContentContextView>
