<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIExtensions.Sample.Garden.Views.AdaptiveStatusView"
             x:Name="Root"
             IsVisible="False">
    <Border Margin="8,4"
            Padding="10,4"
            BackgroundColor="{AppThemeBinding Light={StaticResource ChipBackgroundLight}, Dark={StaticResource ChipBackgroundDark}}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14">
        <HorizontalStackLayout Spacing="8">
            <ActivityIndicator x:Name="Progress"
                               WidthRequest="16"
                               HeightRequest="16"
                               IsRunning="False"
                               IsVisible="False" />
            <Label x:Name="StatusLabel"
                   FontSize="{StaticResource FontSizeCaption}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Text="Reset to Standard"
                    FontSize="{StaticResource FontSizeCaption}"
                    Padding="6,0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnResetClicked" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
