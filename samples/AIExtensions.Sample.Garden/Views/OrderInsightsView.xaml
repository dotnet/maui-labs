<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:AIExtensions.Sample.Garden.Views.Charts"
             xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
             x:Class="AIExtensions.Sample.Garden.Views.OrderInsightsView"
             x:DataType="vm:OrdersViewModel"
             BackgroundColor="Transparent">

    <FlexLayout Direction="Row"
                Wrap="Wrap"
                AlignItems="Start"
                AlignContent="Start"
                JustifyContent="Start"
                Padding="6,4">
        <charts:SpendingByCategoryChartView
            Margin="6"
            AutomationId="SpendingByCategoryChart"
            SemanticProperties.Description="Where the money went chart"
            Items="{Binding Insights.SpendingByCategory}" />
        <charts:PopularProductsChartView
            Margin="6"
            AutomationId="PopularProductsChart"
            SemanticProperties.Description="Most popular products chart"
            Items="{Binding Insights.PopularProducts}" />
    </FlexLayout>

</ContentView>
