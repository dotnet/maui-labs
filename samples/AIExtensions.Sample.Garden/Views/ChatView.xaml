<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.Garden"
             xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
             xmlns:gchat="clr-namespace:AIExtensions.Sample.Garden.Chat"
             xmlns:chat="clr-namespace:Microsoft.Maui.AI.Chat.Controls;assembly=Microsoft.Maui.AI.Chat.Controls"
             x:Class="AIExtensions.Sample.Garden.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             local:ViewModelBinder.Type="{x:Type vm:ChatViewModel}">

    <ContentView.Resources>

        <!-- Designed set — a small typed ContentTemplate per custom block; the generic tool card reuses
             the built-in FunctionInvocationTemplate with a custom ViewType. -->
        <x:Array x:Key="DesignedTemplates" Type="{x:Type chat:ContentTemplate}">
            <chat:ThinkingContentTemplate />
            <chat:TextContentTemplate Role="User" />
            <gchat:GardenFormattedTextTemplate />
            <chat:MediaContentTemplate />
            <gchat:ProductResultsTemplate />
            <gchat:OrderSummaryTemplate />
            <chat:FunctionInvocationTemplate ViewType="{x:Type gchat:GardenToolView}" />
            <chat:ToolApprovalTemplate />
            <chat:ErrorContentTemplate />
            <chat:DefaultContentTemplate />
        </x:Array>

        <!-- Preview set — a single catch-all template that renders every block through the raw inspector. -->
        <x:Array x:Key="PreviewTemplates" Type="{x:Type chat:ContentTemplate}">
            <gchat:BlockPreviewTemplate />
        </x:Array>

        <!-- The rendering axis, done declaratively: one Style whose base setter installs the designed
             templates, and a data trigger that swaps the whole ContentTemplates collection to the preview
             set when the view model's IsPreview flips. ContentTemplates is a bindable collection property,
             so the control rebuilds its selector and re-renders the existing messages on the swap. -->
        <Style x:Key="ChatTemplateStyle" TargetType="chat:CopilotChatView">
            <Setter Property="ContentTemplates" Value="{StaticResource DesignedTemplates}" />
            <Style.Triggers>
                <DataTrigger TargetType="chat:CopilotChatView"
                             Binding="{Binding IsPreview}" Value="True">
                    <Setter Property="ContentTemplates" Value="{StaticResource PreviewTemplates}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </ContentView.Resources>

    <!-- A single CopilotChatView bound to the one live Session. Two axes are exercised without adding
         controls:
           • Handlers  → the view model recreates Session with/without the custom handlers (which blocks
                         the pipeline produces).
           • Rendering → the ChatTemplateStyle above swaps ContentTemplates between the designed set and
                         the raw block inspector via a data trigger on IsPreview. -->
    <chat:CopilotChatView Style="{StaticResource ChatTemplateStyle}"
                          Session="{Binding Session}"
                          SuggestionPrompts="{Binding SuggestionPrompts}"
                          Placeholder="Ask about products..."
                          MaxBubbleWidth="560"
                          HorizontalOptions="Fill">

        <!-- Welcome / empty state: greeting + the grid of available tools -->
        <chat:CopilotChatView.EmptyViewTemplate>
            <DataTemplate x:DataType="vm:ChatViewModel">
                <ScrollView>
                    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12"
                          MaximumWidthRequest="840" HorizontalOptions="Center">
                        <Label Grid.Row="0"
                               Text="&#xF788;"
                               FontFamily="FluentFilled"
                               FontSize="{StaticResource FontSizeHero}"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Welcome to Sage, your personal garden shopper"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Grid.Row="2"
                               Text="Tap a chip below to get started, or browse the catalog. The assistant can use these tools:"
                               FontSize="{StaticResource FontSizeBody}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <FlexLayout Grid.Row="3"
                                    BindableLayout.ItemsSource="{Binding AvailableTools}"
                                    Wrap="Wrap"
                                    JustifyContent="Center"
                                    AlignItems="Start"
                                    AlignContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolInfoViewModel">
                                    <Border Margin="4"
                                            Padding="10,8"
                                            FlexLayout.Basis="{OnIdiom Phone=150, Tablet=240, Desktop=240}"
                                            FlexLayout.Grow="1"
                                            FlexLayout.Shrink="1"
                                            MinimumWidthRequest="{OnIdiom Phone=120, Tablet=220, Desktop=220}"
                                            MaximumWidthRequest="{OnIdiom Phone=190, Tablet=300, Desktop=300}"
                                            HeightRequest="92"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource ToolCardBackgroundLight}, Dark={StaticResource ToolCardBackgroundDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource ToolCardStrokeLight}, Dark={StaticResource ToolCardStrokeDark}}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="2">
                                            <Label Text="{Binding Name}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   FontAttributes="Bold"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                                            <Label Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   MaxLines="3"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMetaLight}, Dark={StaticResource TextMetaDark}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Grid>
                </ScrollView>
            </DataTemplate>
        </chat:CopilotChatView.EmptyViewTemplate>

    </chat:CopilotChatView>

</ContentView>
