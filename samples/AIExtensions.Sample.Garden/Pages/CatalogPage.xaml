<?xml version="1.0" encoding="utf-8" ?>
<pages:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIExtensions.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
             xmlns:pages="clr-namespace:AIExtensions.Sample.Garden.Pages"
             xmlns:adaptive="clr-namespace:Microsoft.Maui.AI.GenerativeUI.Composition;assembly=Microsoft.Maui.AI.GenerativeUI"
             x:Class="AIExtensions.Sample.Garden.Pages.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             Title="Catalog"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          ColumnDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">
        <!-- Header: [back] [icon] [title] -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Button Text="&#xF36A;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeTitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnBackClicked" />
                <Label Text="&#xF788;"
                       FontFamily="FluentFilled"
                       FontSize="{StaticResource FontSizeTitle}"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
                <Label Text="Products"
                       FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
                <Button Grid.Column="1"
                        Text="Cart"
                        AutomationId="CatalogCartButton"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        Clicked="OnCartClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12,8" ColumnDefinitions="*,180" ColumnSpacing="8">
            <SearchBar Placeholder="Search products"
                       Text="{Binding SearchText}"
                       SearchButtonPressed="OnFilterChanged" />
            <Picker Grid.Column="1"
                    Title="Category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    SelectedIndexChanged="OnFilterChanged" />
        </Grid>

        <views:AdaptiveStatusView Grid.Row="2" />

        <ScrollView Grid.Row="3" Padding="16">
            <adaptive:AdaptiveRegionView x:Name="AdaptiveBody"
                                         Region="CatalogBody"
                                         MaximumWidthRequest="1000"
                                         HorizontalOptions="Center" />
        </ScrollView>
        <views:ServerUnavailableView Grid.Row="3" Grid.ColumnSpan="2"
                                     ZIndex="100"
                                     VerticalOptions="Start"
                                     BindingContext="{Binding Store}" />
        <views:ChatSidebar Grid.Column="1"
                           Grid.RowSpan="4" />
    </Grid>

</pages:AdaptiveContentPage>
