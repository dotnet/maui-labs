<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chat="clr-namespace:Microsoft.Maui.Chat.Controls;assembly=Microsoft.Maui.Chat.Controls"
    xmlns:local="clr-namespace:AIExtensions.Sample.Garden"
    xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
    x:Class="AIExtensions.Sample.Garden.Pages.TeamChatPage"
    x:DataType="vm:TeamChatViewModel"
    Title="Garden crew"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Padding="12,8"
              SafeAreaEdges="Container"
              BackgroundColor="{StaticResource Primary}">
            <Button Text="&#xF36A;"
                    FontFamily="FluentFilled"
                    FontSize="18"
                    AutomationId="BackToAiChatButton"
                    ToolTipProperties.Text="Return to the AI chat"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="8"
                    Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 VerticalOptions="Center">
                <Label Text="Garden crew"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Morgan, Priya, Diego &#xB7; provider-neutral chat"
                       FontSize="{StaticResource FontSizeCaption}"
                       TextColor="#E7F2E6" />
            </VerticalStackLayout>
            <Border Grid.Column="2"
                    Padding="10,5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2AFFFFFF"
                    VerticalOptions="Center">
                <Label Text="3 members"
                       FontSize="{StaticResource FontSizeCaption}"
                       TextColor="White" />
            </Border>
        </Grid>

        <chat:ChatView Grid.Row="1"
                       Conversation="{Binding Conversation}"
                       AllowAttachments="True"
                       Placeholder="Message the garden crew..."
                       WelcomeMessage="Start planning with the garden crew"
                       WelcomeIcon="&#xE902;"
                       HorizontalOptions="Fill">
            <chat:ChatView.Appearance>
                <chat:ChatAppearance ShowAvatars="True"
                                     ShowTimestamps="True"
                                     ShowMessageStatus="True"
                                     AvatarSize="32"
                                     BubbleCornerRadius="16"
                                     MaxBubbleWidth="560" />
            </chat:ChatView.Appearance>
            <chat:ChatView.ContentTemplates>
                <chat:GenericChatContentTemplate
                    ContentType="{x:Type local:GardenTaskContent}"
                    ViewType="{x:Type local:GardenTaskView}"
                    Priority="1000" />
            </chat:ChatView.ContentTemplates>
            <chat:ChatView.SuggestionPrompts>
                <x:String>Who can water the herb bed tomorrow?</x:String>
                <x:String>I confirmed the seed order.</x:String>
            </chat:ChatView.SuggestionPrompts>
        </chat:ChatView>
    </Grid>
</ContentPage>
