<?xml version="1.0" encoding="utf-8" ?>
<pages:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIExtensions.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
             xmlns:pages="clr-namespace:AIExtensions.Sample.Garden.Pages"
             xmlns:adaptive="clr-namespace:Microsoft.Maui.AI.GenerativeUI.Composition;assembly=Microsoft.Maui.AI.GenerativeUI"
             x:Class="AIExtensions.Sample.Garden.Pages.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding Name}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,Auto,*"
          ColumnDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">
        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Text="&#xF36A;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeTitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnBackClicked" />
                <Label Grid.Column="1"
                       Text="{Binding Name}"
                       FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </Grid>
        </Border>

        <views:AdaptiveStatusView Grid.Row="1" />

        <!-- Product detail content -->
        <ScrollView Grid.Row="2" Padding="16">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="600"
                                 HorizontalOptions="Center">

                <adaptive:AdaptiveRegionView x:Name="AdaptiveBody"
                                             Region="ProductBody" />

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Add to Cart"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Command="{Binding AddToCartCommand}" />
                    <Button Grid.Column="1"
                            Text="Write Review"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ChipBackgroundLight}, Dark={StaticResource ChipBackgroundDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Command="{Binding WriteReviewCommand}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <views:ServerUnavailableView Grid.Row="2" Grid.ColumnSpan="2"
                                     ZIndex="100"
                                     VerticalOptions="Start"
                                     BindingContext="{Binding Store}" />
        <views:ChatSidebar Grid.Column="1"
                           Grid.RowSpan="3" />
    </Grid>

</pages:AdaptiveContentPage>
