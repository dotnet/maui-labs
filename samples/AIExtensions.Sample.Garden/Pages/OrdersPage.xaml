<?xml version="1.0" encoding="utf-8" ?>
<pages:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIExtensions.Sample.Garden"
             xmlns:views="clr-namespace:AIExtensions.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIExtensions.Sample.Garden.ViewModels"
             xmlns:pages="clr-namespace:AIExtensions.Sample.Garden.Pages"
             xmlns:adaptive="clr-namespace:Microsoft.Maui.AI.GenerativeUI.Composition;assembly=Microsoft.Maui.AI.GenerativeUI"
             x:Class="AIExtensions.Sample.Garden.Pages.OrdersPage"
             x:DataType="vm:OrdersViewModel"
             Title="Past Orders"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,Auto,*"
          ColumnDefinitions="*,Auto"
          local:ViewModelBinder.Type="{x:Type vm:OrdersViewModel}"
          BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">
        <!-- Header: [back] [icon] [title] ... [clear all] -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button Text="&#xF36A;"
                            FontFamily="FluentFilled"
                            FontSize="{StaticResource FontSizeTitle}"
                            Padding="8,4"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource White}"
                            VerticalOptions="Center"
                            Clicked="OnBackClicked" />
                    <Label Text="&#xEA07;"
                           FontFamily="FluentFilled"
                           FontSize="{StaticResource FontSizeTitle}"
                           TextColor="{StaticResource White}" VerticalOptions="Center" />
                    <Label Text="Orders"
                           FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Grid.Column="1"
                        Text="Clear All"
                        FontSize="{StaticResource FontSizeBody}"
                        FontAttributes="Bold"
                        Padding="12,4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextAccentDark}}"
                        CornerRadius="14"
                        VerticalOptions="Center"
                        Command="{Binding ClearCommand}" />
            </Grid>
        </Border>

        <views:AdaptiveStatusView Grid.Row="1" />
        <ScrollView Grid.Row="2" Padding="16">
            <adaptive:AdaptiveRegionView x:Name="AdaptiveBody"
                                         Region="OrdersBody"
                                         MaximumWidthRequest="900"
                                         HorizontalOptions="Center" />
        </ScrollView>
        <views:ServerUnavailableView Grid.Row="2" Grid.ColumnSpan="2"
                                     ZIndex="100"
                                     VerticalOptions="Start"
                                     BindingContext="{Binding Store}" />
        <views:ChatSidebar Grid.Column="1"
                           Grid.RowSpan="3" />
    </Grid>

</pages:AdaptiveContentPage>
