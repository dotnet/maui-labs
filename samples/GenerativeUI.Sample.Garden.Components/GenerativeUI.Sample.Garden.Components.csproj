  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GenerativeUI\Microsoft.Maui.AI.GenerativeUI\Microsoft.Maui.AI.GenerativeUI.csproj" />
